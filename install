#!/bin/sh
# install - set up (or remove) the vigilance lock / screen-power / idle suite:
# the standalone Wayland tools in bin/ (smart-lock, smart-trigger, swayidle-mgr,
# panel-power, osd-mgr, mute-on-lock, idle-capture, lock-watch). This script
# only wires them into ~/.local and audits them; you invoke the tools directly,
# or via the systemd units in systemd/.
#
#   ./install            symlink the tools + the --user listener into ~/.local
#   ./install uninstall  remove those symlinks
#   ./install check      every tool + dependency present; [OK]/[FAIL] markers
#   ./install version    the packaged version
#
# POSIX sh, non-privileged. The suspend-lock SYSTEM unit (systemd/lock-on-
# sleep.service, Before=sleep.target) needs root; place it under
# /etc/systemd/system yourself (or let a host manager do it).
set -eu

VERSION=0.1.0
_root=$(command -v "$0" 2>/dev/null || echo "$0")
_root=$(readlink -f "$_root" 2>/dev/null || echo "$_root")
_root=$(CDPATH= cd -- "$(dirname -- "$_root")" && pwd)

_bin=${XDG_BIN_HOME:-$HOME/.local/bin}
_usr=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
_unit=$_root/systemd/smart-trigger.service
DEPS="swaylock swayidle wlopm ddcutil"   # external runtime deps (spanning/DDC)

# marker contract: plain [OK]/[FAIL]/[WARN] an integrator (tackup paint) styles;
# self-coloured at a terminal, plain when piped or under NO_COLOR.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _G=$(printf '\033[32m'); _R=$(printf '\033[31m')
  _Y=$(printf '\033[33m'); _O=$(printf '\033[0m')
else _G=; _R=; _Y=; _O=; fi
ok()   { printf '  %s[OK]%s   %s\n' "$_G" "$_O" "$1"; }
bad()  { printf '  %s[FAIL]%s %s\n' "$_R" "$_O" "$1"; RC=1; }
warn() { printf '  %s[WARN]%s %s\n' "$_Y" "$_O" "$1"; }

m_install() {
  mkdir -p "$_bin" "$_usr"
  for _t in "$_root"/bin/*; do ln -sfn "$_t" "$_bin/$(basename "$_t")"; done
  ln -sfn "$_unit" "$_usr/smart-trigger.service"
  echo "vigilance: linked the tools + the --user listener into ~/.local"
  echo "vigilance: the suspend-lock SYSTEM unit needs root -- place"
  echo "  $_root/systemd/lock-on-sleep.service under /etc/systemd/system."
}

m_uninstall() {
  for _t in "$_root"/bin/*; do
    _l=$_bin/$(basename "$_t")
    [ "$(readlink "$_l" 2>/dev/null)" = "$_t" ] && rm -f "$_l"
  done
  [ "$(readlink "$_usr/smart-trigger.service" 2>/dev/null)" = "$_unit" ] \
    && rm -f "$_usr/smart-trigger.service"
  echo "vigilance: removed the ~/.local symlinks + the --user listener"
  echo "vigilance: a placed SYSTEM unit needs root to remove."
}

m_check() {
  RC=0
  echo "== vigilance (lock / screen-power / idle) =="
  for _t in "$_root"/bin/*; do
    _n=$(basename "$_t")
    if command -v "$_n" >/dev/null 2>&1; then ok "$_n present"
    else bad "$_n not on PATH"; fi
  done
  for _d in $DEPS; do
    command -v "$_d" >/dev/null 2>&1 && ok "dep $_d present" \
      || warn "dep $_d absent ($_d powers spanning/DDC; degrades gracefully)"
  done
  if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/shapes" ]; then
    ok "shape config present (~/.config/shapes)"
  else
    warn "no ~/.config/shapes; smart-lock uses a single-output lock"
  fi
  return "$RC"
}

case "${1:-install}" in
  install)   m_install ;;
  uninstall) m_uninstall ;;
  check)     m_check ;;
  version)   echo "vigilance $VERSION" ;;
  -h|--help|help)
    echo "usage: ./install [install|uninstall|check|version]" ;;
  *) echo "install: unknown command '${1:-}'" >&2
     echo "usage: ./install [install|uninstall|check|version]" >&2; exit 2 ;;
esac
