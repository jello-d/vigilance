#!/bin/sh
# dpms - re-assert the compositor's outputs ON, and NEVER turn them off.
#
# ASYMMETRIC BY HARDWARE NECESSITY, and the asymmetry IS the safety rule:
#
#   lit   -> wlopm --on '*'
#   dark  -> NOTHING. Darkness belongs to the backlight and DDC hooks, which
#            reach it without a modeset.
#
# WHY WIRE IT AT ALL when nothing here turns an output off: precisely because
# nothing does. If an output IS off, something outside vigilance did it (the
# compositor's own idle, a kernel DPMS, a wedge), and this is the cheap
# idempotent re-assert that brings it back. A no-op on a healthy ascent, the
# recovery that matters on a broken one.
#
# DO NOT "FIX" THIS TO TURN OUTPUTS OFF. A reader seeing a half-implemented
# hook and completing it would reintroduce a session-killing crash. Two reasons:
#   1. wlopm is wlroots-only, so an off here would be silently inert elsewhere.
#   2. on the wlroots build this was written against, powering an output off
#      re-modesets and was observed to DESTROY VIEWS. panel-power never called
#      wlopm at all for that reason, naming it only as the thing to avoid.
#
# THE SECOND REASON MAY BE STALE, so check before acting on it: that observation
# PREDATES the scale-clamp patch this platform now carries, which fixes a
# SIGABRT on a re-enabled output taking scale 0 from an unapplied
# output-management head, plausibly the same crash. If DPMS-off proves safe now,
# the right move is to BLANK via DPMS, where the input stack restores it for
# free, rather than making this hook turn things off.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../../lib/hook_lib"

edge=${1:-${VIGILANCE_EDGE:-}}
[ "$(hook_intent "$edge")" = lit ] || exit 0

# 78, NOT 0. "wlopm is not installed here" and "I did the work" were the
# same exit code until the n/a contract; exit 0 launders a mechanism that
# was never present into a tier that reports clean.
if ! command -v wlopm >/dev/null 2>&1; then
  echo "dpms: wlopm is not installed; nothing to do here" >&2
  exit 78
fi

# NO REACHABLE COMPOSITOR IS n/a, NOT FAILURE. These hooks also run in machine
# scope, where the greeter's session may not be ours to talk to, and a hook that
# failed there would raise an alert on every greeter edge. Same discipline as
# ddc-monitor: a device that will not answer is absent, not drift. A plain
# `wlopm` lists outputs and is the cheapest probe for "can we talk at all".
_state=$(wlopm 2>/dev/null) || exit 0
[ -n "$_state" ] || exit 0

# VERIFY reads the listing back instead of writing. Output lines are
# "<name> on" / "<name> off", so any `off` at a lit rung is the drift.
if [ "${VIGILANCE_KIND:-act}" = verify ]; then
  _off=$(printf '%s\n' "$_state" | awk '$NF == "off" { print $1 }')
  if [ -n "$_off" ]; then
    echo "dpms: expected all outputs on, found off:" $_off >&2
    exit 1
  fi
  exit 0
fi

if ! wlopm --on '*' >/dev/null 2>&1; then
  echo "dpms: wlopm --on failed while the compositor was reachable" >&2
  exit 1
fi
exit 0
