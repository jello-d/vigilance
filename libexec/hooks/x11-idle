#!/bin/sh
# x11-idle - an idle.d source that ASKS THE SEAT, on X11.
#
# CONTRACT: print seconds idle on stdout and exit 0, or exit 78 for "I cannot
# tell". 78 is not 0 here: zero means "input one second ago", which would
# silently reset every deadline for ever and report a healthy machine.
#
# WHY THIS IS THE INTERESTING ONE. On Wayland there is no unprivileged way to
# ask, so `input-counters` samples kernel counters and infers, which works,
# and carries two costs the shipped clock has to state: it can only observe what
# happened BETWEEN samples, and ANYTHING that talks to an input device moves it
# (a QMK keyboard reporting to itself every 60s pinned a live box's clock at
# 74s against deadlines of 480 and 600). X11 has the answer directly: the server
# tracks time since the last input event for its own screensaver, and
# XScreenSaverQueryInfo reports it. `xprintidle` is a four-line wrapper on that
# call.
#
# SO IT IS NOT A BETTER GUESS, IT IS A DIFFERENT KIND OF ANSWER: continuous
# rather than sampled, and about INPUT EVENTS rather than about bus traffic.
# Different, not unbounded: see the ceiling below, which is the correction the
# real server forced.
#
# IT REPORTS A CEILING, AND THE FIRST VERSION DID NOT. That version said the X
# server's counter "can witness any duration" because nothing resets it but real
# input. MEASURED AGAINST A REAL SERVER, that is false:
#
#     x11-idle -> 306s     ... 3 seconds later ...     x11-idle -> 2s
#
# THE SERVER'S OWN SCREENSAVER RESETS IT. XScreenSaverQueryInfo reports idle
# time WITHIN the current screensaver state, so when the saver activates at its
# timeout the counter starts again, and a seat that has been quiet for an hour
# reports seconds. That is the safe direction for an alert (it suppresses a
# finding rather than inventing one) and it is fatal to the question report
# asks: a deadline longer than the screensaver timeout can never be
# witnessed here.
#
# Which is EXACTLY what `ceiling=` exists for. The counter clock carries it
# because a chattering keyboard caps what it can observe; this one carries it
# because the screensaver does. The cap is STRUCTURAL rather than accumulated (
# known from the server's own configuration at the first call, not learned), so
# `age` is reported equal to it: report's "the clock is too young to have seen
# that yet" exemption must not apply to a hard limit.
#
# A timeout of 0 means the screensaver is disabled, and then the answer really
# does stand on its own: no ceiling is emitted, which the runner reads as "no
# opinion" and report reads as measurable.
#
# CONTENT: none. The reply is a duration; no scancode, no button, no coordinate.
# That is the same property that makes the counter sources admissible: the
# mechanism is INCAPABLE of observing content rather than merely unwilling.
set -eu

if ! command -v xprintidle >/dev/null 2>&1; then
  exit 78
fi
# DISPLAY is not guaranteed in a unit or a timer, for the same reason the X11
# dpms hook says so: an integrator imports it into the user manager.
if [ -z "${DISPLAY:-}" ]; then
  exit 78
fi

# THROUGH A FILE, not a pipeline, so a failure is a failure rather than the
# status of the last stage. `xprintidle` exits non-zero when it cannot reach the
# server or the extension is missing, and that must read as "cannot tell".
_out=$(xprintidle 2>/dev/null) || exit 78
case "${_out:-}" in
  ''|*[!0-9]*) exit 78 ;;
esac

# AND THE COUNTER MUST NOT BE RESET BY READING IT, which is a real server
# behaviour and not a hypothetical. MEASURED in the VM guest, whose X server
# has no input devices at all:
#
#     spaced: 3008 2975 2980     reads three seconds apart
#     rapid:  1 0 0 1            reads back to back
#
# It reports the interval since the PREVIOUS READ rather than since input. A
# supervision pass reads this source three times (judge, settle, then the one
# that decides), so the deciding read can never see more than the gap since the
# second, and an idle-anchored deadline is permanently not due. The tier goes
# silently inert.
#
# WHICH WOULD BE A FALSE GREEN, and that is why this cannot just be noted:
# `report` reads the ceiling this hook emits (the server's 600s screensaver
# timeout) and calls a 480s deadline MEASURABLE, while the readable value is
# always about zero.
#
# ZERO IS THE WORST ANSWER AVAILABLE, which is the whole reason for declining
# rather than reporting what we got: 0 means "input one second ago", so it
# silently resets every deadline for ever and reports a healthy machine. The
# contract exists for exactly this: a source that cannot measure says 78.
#
# TWO IMMEDIATE READS, NO SLEEP. On a server where the counter tracks input,
# both see the same idle time; on one that resets per read, the second sees
# about nothing. One extra process, nothing waited for.
#
# AN INPUT ARRIVING BETWEEN THE TWO READS is indistinguishable from the fault
# and is answered the same way, which is safe: it means the seat is genuinely
# active, so declining suppresses a finding rather than inventing one.
_out2=$(xprintidle 2>/dev/null) || exit 78
case "${_out2:-}" in
  ''|*[!0-9]*) exit 78 ;;
esac
if [ "${#_out}" -le 13 ] && [ "${#_out2}" -le 13 ] \
   && [ "$_out" -gt 2000 ] && [ "$_out2" -lt $(( _out / 2 )) ]; then
  echo "this server's idle counter is reset by READING it (${_out}ms then"\
" ${_out2}ms back to back), so it measures the gap between readers rather"\
" than since input. A supervision pass reads three times, so the deciding"\
" read would always see about zero and every idle deadline would be"\
" permanently not due." >&2
  exit 78
fi

# MILLISECONDS IN, SECONDS OUT. The unit mismatch is the whole risk in this
# file: reporting milliseconds as seconds would make the seat look idle for a
# thousand times longer than it is, which is the one direction that INVENTS a
# finding, a false overdue on a machine somebody is sitting at, which is the
# documented reason a live box had its supervision timer stopped by hand.
#
# 11+ digits would overflow the shell's arithmetic, and the runner rejects such
# a value anyway; refusing here says which source was wrong.
if [ "${#_out}" -gt 13 ]; then
  exit 78
fi
# THE SERVER'S SCREENSAVER TIMEOUT IS THE CAP. `timeout:` appears once in
# `xset q`, in the Screen Saver block; the DPMS block spells its own thresholds
# Standby/Suspend/Off, so there is nothing to confuse it with. An `xset` we
# cannot run leaves the cap unknown, and unknown is reported as no opinion
# rather than as unbounded, the same direction every other doubt in this
# package takes.
_cap=
if command -v xset >/dev/null 2>&1; then
  _cap=$(xset q 2>/dev/null | sed -n 's/^ *timeout: *\([0-9][0-9]*\).*/\1/p' \
         | head -1)
  case "${_cap:-}" in ''|*[!0-9]*) _cap= ;; esac
  [ "${_cap:-0}" -gt 0 ] || _cap=
fi
if [ -n "$_cap" ]; then
  printf '%s ceiling=%s age=%s\n' "$(( _out / 1000 ))" "$_cap" "$_cap"
else
  printf '%s\n' "$(( _out / 1000 ))"
fi
