#!/bin/sh
# x11-idle - an idle.d source that ASKS THE SEAT, on X11.
#
# CONTRACT: print seconds idle on stdout and exit 0, or exit 78 for "I cannot
# tell". 78 is not 0 here: zero means "input one second ago", which would
# silently reset every deadline for ever and report a healthy machine.
#
# WHY THIS IS THE INTERESTING ONE. On Wayland there is no unprivileged way to
# ask, so `input-counters` samples kernel counters and infers, which works,
# and carries two costs the shipped clock has to state: it can only observe what
# happened BETWEEN samples, and ANYTHING that talks to an input device moves it
# (a QMK keyboard reporting to itself every 60s pinned a live box's clock at
# 74s against deadlines of 480 and 600). X11 has the answer directly: the server
# tracks time since the last input event for its own screensaver, and
# XScreenSaverQueryInfo reports it. `xprintidle` is a four-line wrapper on that
# call.
#
# SO IT IS NOT A BETTER GUESS, IT IS A DIFFERENT KIND OF ANSWER: continuous
# rather than sampled, and about INPUT EVENTS rather than about bus traffic.
# Different, not unbounded: see the ceiling below, which is the correction the
# real server forced.
#
# IT REPORTS A CEILING, because the counter is NOT unbounded. The first version
# claimed it could witness any duration, since nothing but real input resets it.
# Measured against a real server, that is false:
#
#     x11-idle -> 306s     ... 3 seconds later ...     x11-idle -> 2s
#
# XScreenSaverQueryInfo reports idle time WITHIN the current screensaver state,
# so the counter restarts when the saver activates, and a seat quiet for an hour
# reports seconds. Safe for an alert (it suppresses a finding rather than
# inventing one) and fatal to the question `report` asks, since a deadline
# longer than the cap can never be witnessed.
#
# So `ceiling=` carries WHAT THIS CLOCK HAS BEEN SEEN TO REACH, a high-water
# mark exactly as input-counters keeps one, and NOT the server's configured
# timeout. The note at the state file below is the authoritative one: it records
# why emitting a CONFIGURED limit through that field laundered a config value
# into evidence, which is why no `xset` read remains.
#
# CONTENT: none. The reply is a duration; no scancode, no button, no coordinate.
# That is the same property that makes the counter sources admissible: the
# mechanism is INCAPABLE of observing content rather than merely unwilling.
set -eu

if ! command -v xprintidle >/dev/null 2>&1; then
  exit 78
fi
# DISPLAY is not guaranteed in a unit or a timer, for the same reason the X11
# dpms hook says so: an integrator imports it into the user manager.
if [ -z "${DISPLAY:-}" ]; then
  exit 78
fi

# THROUGH A FILE, not a pipeline, so a failure is a failure rather than the
# status of the last stage. `xprintidle` exits non-zero when it cannot reach the
# server or the extension is missing, and that must read as "cannot tell".
_out=$(xprintidle 2>/dev/null) || exit 78
case "${_out:-}" in
  ''|*[!0-9]*) exit 78 ;;
esac

# MILLISECONDS IN, SECONDS OUT. The unit mismatch is the whole risk in this
# file: reporting milliseconds as seconds would make the seat look idle for a
# thousand times longer than it is, which is the one direction that INVENTS a
# finding, a false overdue on a machine somebody is sitting at, which is the
# documented reason a live box had its supervision timer stopped by hand.
#
# 11+ digits would overflow the shell's arithmetic, and the runner rejects such
# a value anyway; refusing here says which source was wrong.
if [ "${#_out}" -gt 13 ]; then
  exit 78
fi
# THE CEILING IS WHAT THIS CLOCK HAS BEEN SEEN TO REACH, not what the server
# is configured to allow. That is the correction, and the version it replaces
# emitted the screensaver TIMEOUT through this field:
#
#     x11-idle -> "5 ceiling=600 age=600"
#     report   -> "measurable (clock has observed 600s quiet)"
#
# It had observed no such thing. 600 was a line in `xset q`, and `ceiling=` is
# read by its consumer as a DEMONSTRATION: a config value laundered into
# evidence, which is the signature false green of this package in a field
# invented to prevent it. Measured against the real report, not inferred.
#
# AND THE OTHER DIRECTION UNDER-STATED. A timeout BELOW the deadline is a hard
# impossibility known at the first call, and `age=cap` was chosen so that
# report's too-young exemption "must not apply to a hard limit". Measured: it
# lands squarely in that exemption and reads "NOT YET SHOWN", which invites
# waiting for something that will never happen. The comment asserted the
# opposite of what the code produced.
#
# SO IT IS OBSERVED NOW, EXACTLY AS input-counters DOES IT, and the virtue is
# that it needs no theory of WHY the counter resets. The screensaver resets it
# (measured: 306s then 2s three seconds later). Whether a READER also resets it
# is an open question this box cannot settle, because its Xwayland does not
# advertise MIT-SCREEN-SAVER at all, and the two measurements on record
# disagree. A high-water mark is right under any of those: whatever caps the
# counter, the cap shows up, and a deadline longer than it is reported as
# undemonstrated rather than as measurable.
#
# NO xset READ AT ALL ANY MORE. The structural cap is genuinely useful and has
# no field to carry it: the contract has `ceiling=` for what was OBSERVED, and
# putting a configured limit there is the defect above. So a hard impossibility
# is learned by watching rather than stated at once, which is slower and true.
# Giving it its own field is a contract change and wants its own increment.
#
# A LEADING DOT ON THE STATE FILE. `report` scans hook state dirs for
# outstanding saved levels, and a bare name holding a number earns a permanent
# FAIL at every lit rung; that has shipped once and was nearly repeated for a
# throttle stamp. The content is three fields rather than a bare number, which
# is the real protection, and the dot is the belt to its braces.
STATE=${VIGILANCE_STATE_DIR:-/tmp}/.observed
MAXGAP=${VIGILANCE_IDLE_MAXGAP:-300}

_secs=$(( _out / 1000 ))
_now=$(date +%s)

_pmax=0; _pstart=0; _plast=0
read -r _pmax _pstart _plast 2>/dev/null < "$STATE" || true
case "${_pmax:-}" in '' | *[!0-9]*) _pmax=0 ;; esac
case "${_pstart:-}" in '' | *[!0-9]*) _pstart=0 ;; esac
case "${_plast:-}" in '' | *[!0-9]*) _plast=0 ;; esac

# THE AGE IS RE-ANCHORED BY A GAP AND THE CEILING IS NOT, and the asymmetry is
# the point rather than an oversight. `age` answers "how long have WE been
# watching", which a suspend genuinely interrupts: the supervision timer does
# not fire in S3, so crediting that would claim a watch nobody kept.
#
# THE CEILING ANSWERS A DIFFERENT QUESTION: has this clock been SEEN to reach
# N. Here that is the SERVER'S OWN count of time since the last input event,
# so a large value read after a gap really was reported and really does
# demonstrate the counter's reach. That is where this differs from
# input-counters, whose ceiling is a wall-time INFERENCE between samples and
# therefore inflatable by one gap: measured there at 241310s (67 hours) on a
# counter that was in fact moving every 25s.
if [ "$_plast" -gt 0 ] && [ "$_now" -ge "$_plast" ] \
   && [ "$(( _now - _plast ))" -le "$MAXGAP" ] && [ "$_pstart" -gt 0 ] \
   && [ "$_pstart" -le "$_now" ]; then
  _start=$_pstart
else
  _start=$_now
fi

_max=$_pmax
if [ "$_secs" -gt "$_max" ]; then _max=$_secs; fi
printf '%s %s %s\n' "$_max" "$_start" "$_now" > "$STATE" 2>/dev/null || true

printf '%s ceiling=%s age=%s\n' "$_secs" "$_max" "$(( _now - _start ))"
