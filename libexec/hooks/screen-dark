#!/bin/sh
# screen-dark - VERIFY-ONLY: is the screen actually emitting at a dark rung?
#
# THE ONE CHECK THAT ASKS THE RUNG'S QUESTION rather than a device's. Every
# other verifier in this suite asks about its own mechanism: "did my I2C bus
# take the command", "is my sysfs backlight at 0", "are my compositor's outputs
# off", and each is satisfied or n/a on its own terms. Nothing asserted the
# thing the rung actually MEANS.
#
# That is not a theoretical gap. A lit screen survived four separate green
# verdicts:
#
#   a D6 code the panel does not implement      ddc-monitor was satisfied
#   a monitor that vanished from its own map    it was not in the map to check
#   a user session with no darkening mechanism  every hook declined
#   a greeter with none either                  every hook declined
#
# In all four the machine said `sleep` and the screen was lit, every hook was
# individually correct, and the failure lived in the gap BETWEEN them, which is
# where a per-device check cannot look. So this one is deliberately incurious
# about WHICH mechanism was meant to act: it compares what the display is
# showing against what the rung claims, and holds when a mechanism is broken,
# when one was never wired, and when the hook that owned it declined.
#
# BUT A CAPTURE CANNOT SEE A BACKLIGHT, and this comment once claimed it
# measured "what the display emits", which is false: `grim` copies the
# COMPOSITOR'S framebuffer, while the backlight is a panel property outside the
# compositor, so a capture reads identically whether the panel is blazing or
# off. Measured on manifold, where display-watch recorded bl=0 at the `sleep`
# rung while this reported "still emitting, mean luminance 0.277" once a
# minute. It had looked correct only because lock-blank was painting the surface
# black there, so gating lock-blank to the hardware that needs it removed the
# mask and left this asserting what it had never been able to check.
#
# So the backlight is consulted DIRECTLY, which is an observation rather than an
# assumption: a panel held dark by its backlight emits nothing whatever the
# framebuffer says.
#
# BUT A BACKLIGHT SPEAKS FOR ITS OWN PANEL, NOT FOR THE MACHINE. This hook used
# to pass outright on a dark backlight, on the premise that a box with one has
# nothing else to darken. A laptop docked to two monitors breaks that: measured
# on dragonfly at the `sleep` rung, eDP-1 at backlight 0 while DP-7 and DP-9
# kept scanning out the lock wallpaper (peaks ~1.0), with `verify sleep: ok`.
# So the backlight excuses only the connector it belongs to (its sysfs
# `device` link), and every OTHER active output is still judged, by DRM's own
# dpms state where that says Off and otherwise by capturing that output alone.
# An output ddc-monitor put into a DDC power state is excused through its
# record, because the framebuffer cannot see standby.
#
# DEFENSE IN DEPTH, not a replacement. The per-device verifiers say WHICH
# mechanism failed, which is what you need to fix it. This one says THAT the
# machine is lying, which is what you need to know at all. Keep both.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../../lib/hook_lib"

# VERIFY ONLY. It actuates nothing: there is no "make the screen dark" here,
# because choosing a mechanism is exactly what this hook refuses to do.
if [ "${VIGILANCE_KIND:-act}" != verify ]; then
  exit 0
fi

edge=${1:-${VIGILANCE_EDGE:-}}
_intent=$(hook_intent "$edge")

# A LIT rung is deliberately NOT asserted. A legitimately black wallpaper, a
# dark theme, a screen showing a mostly-black terminal, none of those is
# drift, and failing on them would make this the crying-wolf check that gets
# switched off. The claim worth making is one-directional: at a DARK rung the
# screen must not be emitting.
if [ "$_intent" != dark ]; then
  exit 0
fi

# THE BACKLIGHT FIRST, because it settles its own panel outright and costs a
# file read, where the capture costs over a second.
_bl_dark=
_bl_lit=
_bl_conns=
_bl_unknown=
for _sb in "${VIGILANCE_SYS_BACKLIGHT:-/sys/class/backlight}"/*; do
  [ -r "$_sb/max_brightness" ] || continue
  # `actual_brightness`, WHICH IS WHAT THE HARDWARE REPORTS. This read
  # `brightness` until 2026-10-05, and that is the REQUESTED value: a verifier
  # standing on it says "we asked for 0" rather than "it IS 0", which is this
  # package's signature false green in the one tier whose whole job is to catch
  # it. The kernel exposes both precisely because they can differ.
  #
  # AND IT IS WHAT THE RUNNER ALREADY READS. `_rep_coherence` and the hardware
  # section both use actual_brightness, so the old choice meant the two tiers
  # could disagree about whether this panel is dark. The comment below guards
  # the THRESHOLD against exactly that drift while the ATTRIBUTE underneath it
  # was a larger way to disagree, which is how it survived unexamined.
  #
  # THE FALLBACK IS NAMED, NOT SILENT. actual_brightness is standard in the
  # sysfs backlight ABI and present on every device in this fleet, but a driver
  # that omits it must not make this branch vanish: it drops to the requested
  # value and SAYS it did, so a reader knows the claim rests on weaker evidence
  # than usual. Silently falling back is how the original choice went unnoticed.
  _sbw=
  if [ -r "$_sb/actual_brightness" ]; then
    _sbc=$(cat "$_sb/actual_brightness" 2>/dev/null || echo)
  elif [ -r "$_sb/brightness" ]; then
    _sbc=$(cat "$_sb/brightness" 2>/dev/null || echo)
    _sbw=" (no actual_brightness on $(basename "$_sb"); this is the REQUESTED\
 value, so it says what was asked for rather than what the panel reports)"
  else
    continue
  fi
  _sbm=$(cat "$_sb/max_brightness" 2>/dev/null || echo)
  case "${_sbc:-}${_sbm:-}" in ''|*[!0-9]*) continue ;; esac
  [ "$_sbm" -gt 0 ] || continue
  # The same "dark is not exactly 0 on every device" threshold hook_lib uses,
  # so the two tiers cannot disagree about what dark means.
  #
  # AND THIS IS A DIFFERENT CLAIM FROM THE ONE BELOW, which is the distinction
  # this hook used to blur. A backlight at zero means the panel EMITS NOTHING
  # whatever is drawn on it, and nothing else drawing can change that. Black
  # CONTENT on a powered panel is a much weaker guarantee: the display is on and
  # scanning out, and it holds only while nothing brighter appears. The capture
  # path below therefore has to ask a second question that this branch does not.
  if [ "$_sbc" -le $((_sbm / 10)) ]; then
    # STDERR, like every other message this hook prints. On stdout it would be
    # read as the hook's OUTPUT rather than as a note, and screen-dark.t's own
    # helper returns stdout as the exit status: the first version of this line
    # made the test report an rc of the message text.
    [ -z "$_sbw" ] || echo "screen-dark: backlight dark$_sbw" >&2
    _bl_dark=1
    # WHICH PANEL. The backlight's `device` link resolves to its DRM connector
    # on this fleet (card0-eDP-1, measured on manifold and dragonfly). A driver
    # that links elsewhere (acpi_video points at the GPU) leaves it unknown,
    # and then the internal connector types stand in for it.
    _sbn=$(readlink -f "$_sb/device" 2>/dev/null || true)
    _sbn=${_sbn##*/}
    case "$_sbn" in
      card[0-9]*-*) _bl_conns="$_bl_conns $_sbn" ;;
      *)            _bl_unknown=1 ;;
    esac
  else
    _bl_lit=1
  fi
done

# Every OTHER active output, as an output name, minus those already dark by
# power (DRM dpms Off) or held in DDC standby by ddc-monitor.
_other_outputs() {
  _ddc_dark=
  if [ -n "${VIGILANCE_STATE_DIR:-}" ]; then
    for _df in "$(dirname "$VIGILANCE_STATE_DIR")"/*/.dark-outputs; do
      [ -r "$_df" ] || continue
      _ddc_dark="$_ddc_dark $(tr '\n' ' ' < "$_df")"
    done
  fi
  for _c in "${VIGILANCE_SYS_DRM:-/sys/class/drm}"/card[0-9]*-*; do
    [ -r "$_c/status" ] || continue
    [ "$(cat "$_c/status" 2>/dev/null)" = connected ] || continue
    [ "$(cat "$_c/enabled" 2>/dev/null)" = enabled ] || continue
    _cn=${_c##*/}
    case " $_bl_conns " in *" $_cn "*) continue ;; esac
    if [ -n "$_bl_unknown" ]; then
      case "$_cn" in *-eDP-*|*-LVDS-*|*-DSI-*) continue ;; esac
    fi
    [ "$(cat "$_c/dpms" 2>/dev/null)" != Off ] || continue
    case " $_ddc_dark " in *" $_cn "*) continue ;; esac
    printf '%s\n' "${_cn#card*-}"
  done
}

if [ -n "$_bl_dark" ] && [ -z "$_bl_lit" ]; then
  _outs=$(_other_outputs)
  if [ -z "$_outs" ]; then exit 0; fi
  _lit_o=
  _unm_o=
  for _o in $_outs; do
    _oa=$(hook_screen_luma "$_o")
    if [ -z "$_oa" ]; then _unm_o="$_unm_o $_o"; continue; fi
    _ol=${_oa%% *}
    _op=$(hook_luma_peak "$_oa")
    if ! hook_luma_is_dark "$_ol" \
       || { [ -n "$_op" ] && ! hook_luma_peak_is_dark "$_op"; }; then
      _lit_o="$_lit_o $_o (mean $_ol${_op:+, peak $_op})"
    fi
  done
  if [ -n "$_lit_o" ]; then
    echo "screen-dark: at a DARK rung ($edge) the backlit panel is dark but"\
" other output(s) are still showing a picture:$_lit_o. Nothing powered them"\
" off: DRM still reports them On, and no DDC power state is recorded for"\
" them, so they are lit while every per-device verifier can stay green." >&2
    exit 1
  fi
  if [ -n "$_unm_o" ]; then
    echo "screen-dark: the backlit panel is dark, and output(s)$_unm_o are"\
" still powered with nothing able to capture them alone (grim -o), so"\
" whether they are dark was NOT checked" >&2
    exit 78
  fi
  exit 0
fi

_a=$(hook_screen_luma)
if [ -z "$_a" ]; then
  # NOTHING TO MEASURE: no compositor to grab from (a greeter over ssh, a tty,
  # a headless box), or no grim/magick. Saying n/a is the honest answer, and
  # saying it with 78 is what keeps an edge where nothing could be checked from
  # reading like one where everything passed.
  exit 78
fi
_l=${_a%% *}                        # field 1 is the mean, as it always was
_p=$(hook_luma_peak "$_a")          # empty when the answer carries no peak

# THE WHOLE SURFACE FIRST. This is the original check and its message is
# preserved VERBATIM, prefix included, because these notes quote it from two
# live incidents and rewording it would turn a true quotation into a false one.
if ! hook_luma_is_dark "$_l"; then
  echo "screen-dark: the machine is at a DARK rung ($edge) and the display is"\
" still emitting (mean luminance $_l, want ~0). Whatever was supposed to"\
" darken it did not, and every per-device verifier can still be green while"\
" this is true, because each one only knows about its own mechanism." >&2
  exit 1
fi

# AND THEN: IS ANYTHING EMITTING? A surface that AVERAGES black can still carry
# a small bright region, and on an OLED that is the failure that matters, since
# one bright spot held still for hours is what burns in. A 48x48 white cursor on
# this fleet's panel lifts the mean by 0.000444 against a 0.01 threshold, 22x
# short, so the mean alone certified exactly the state lock-blank exists to
# prevent. Observed on the glass before it was measured.
#
# A MISSING PEAK IS NOT A PASS AND NOT A FAILURE. An older deployed hook, or a
# fixture supplying only a mean, leaves this unanswerable, and the honest report
# is that the surface averages black with the bright-spot question unchecked.
# Exit 0 keeps it from alarming on a static fact, and the qualifier is what
# stops it reading as a full confirmation.
if [ -z "$_p" ]; then
  # SAY SO RATHER THAN PASS QUIETLY. This is the weaker of the two passes and
  # nothing else distinguishes them: the exit code is 0 either way, so without a
  # line here "the surface averages black" and "nothing is emitting anywhere"
  # read identically, which is the conflation this whole change is about. It
  # cannot fire on the normal path, because the capture always yields a peak.
  echo "screen-dark: the surface AVERAGES black (mean $_l) and no peak was"\
" available, so whether a small bright region is on it was NOT checked. Black"\
" content is not a power state: the panel is on and scanning out." >&2
  exit 0
fi
if ! hook_luma_peak_is_dark "$_p"; then
  echo "screen-dark: at a DARK rung ($edge) the surface AVERAGES black (mean"\
" $_l) but something on it is still emitting (peak $_p, want under 0.02). A"\
" mean cannot see a small bright region, and a cursor or a notification held"\
" still on an OLED is the burn-in this rung is supposed to prevent. Note the"\
" panel itself is ON and scanning out: black CONTENT is not a power state." >&2
  exit 1
fi
exit 0
