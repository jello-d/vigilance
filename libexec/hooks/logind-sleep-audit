#!/bin/sh
# logind-sleep-audit - did every real sleep produce the edges it should have?
#
# An `audit` hook reads ONE event source and prints, per event,
#
#     <epoch> <edge> [note]
#
# meaning "at <epoch> something happened that should have produced <edge>".
# vigilant does the reconciliation against its own log; this only has to know
# how to read logind.
#
# WHY THIS EXISTS, concretely. The battery hit critical, UPower hybrid-slept the
# machine, and lock-on-sleep.service was asked to lock it first. The unit died
# 203/EXEC on a bad ExecStart and systemd slept anyway, because a failed
# Before= oneshot does NOT block the transition. Afterwards nothing was in a
# wrong state and nothing was pending, so neither `verify` nor `due` could see
# it: the machine had slept unlocked and the only trace was history. It had been
# doing that on EVERY sleep for a whole refactor while the unit reported
# `enabled` and `canonical`, both true of a unit naming a missing binary.
#
# THE EDGE A SLEEP IMPLIES IS `lock`, IN BOTH DIRECTIONS, not `suspend`:
#
#   before sleeping   lock-on-sleep.service     `go lock atleast`
#   after resuming    vigilance-resume.service  `go lock atmost`
#
# ASSERT WHAT THE UNITS ACTUALLY DO. Both target the `lock` rung, so `lock` is
# the only edge either can produce. This said `sleep` for the resume direction,
# left from when that unit ran `go sleep`, and asserting an edge no unit crosses
# any more reported a MISS on every correctly handled resume: the forensic tier
# crying wolf, which the `due` anchor bug had already cost once.
#
# AND A HEALTHY CROSSING MAY BE NO CROSSING AT ALL, which is why vigilant counts
# `already at '<rung>'` and `deeper than '<rung>'` as satisfying the assertion.
# The depth file lives in XDG_RUNTIME_DIR and survives suspend, so the machine
# comes back still recorded at `lock` where the target is a no-op, and an
# `atleast` asked from `sleep` declines as already deeper. Demanding a crossing
# would fail both healthy cases.
#
# KNOWN GAP, so a clean audit is not read as more than it is: `atmost` declines
# with "shallower than", which `_log_has_edge` does NOT yet match. On a box
# carrying the system units something always crosses first and satisfies this,
# but where only swayidle's resume arm answers and the user has already
# unlocked, the decline is the only record and reads as a MISS.
set -eu

SINCE=${VIGILANCE_AUDIT_SINCE:--1 day}

# 78, NOT 0. "journalctl is not installed here" and "I did the work" were the
# same exit code until the n/a contract; exit 0 launders a mechanism that
# was never present into a tier that reports clean.
if ! command -v journalctl >/dev/null 2>&1; then
  echo "logind-sleep-audit: journalctl is not installed; nothing to do here" >&2
  exit 78
fi

# logind announces both directions. "Reached target sleep.target" is the point
# of no return on the way down; the resume line is systemd-sleep returning.
# -o short-unix gives an epoch directly, so nothing here has to parse a date.
journalctl --since "$SINCE" -o short-unix --no-pager 2>/dev/null | awk '
  # Going down: the lock should already have happened.
  /Reached target sleep\.target/ {
    printf "%d lock went to sleep\n", $1
  }
  # Coming back: the session must still be locked. Same edge, because the resume
  # unit runs the same command; see the header on why a no-op counts.
  /System returned from sleep operation/ {
    printf "%d lock resumed from sleep\n", $1
  }
'
exit 0
