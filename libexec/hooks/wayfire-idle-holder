#!/usr/bin/env python3
"""wayfire-idle-holder - HOLDER: who is holding idle off in wayfire?

A Wayland compositor keeps its own idle inhibitors (zwp_idle_inhibit_v1, what a
browser takes for a call or a wake lock), and logind cannot see them. While any
is held, wayfire tells its idle notifier to deliver nothing, so the idle timer
goes silent exactly as a wedged one does. This asks the compositor itself,
through the `idle-audit` plugin from wayfire-mods (`idle-audit/list`), and
answers with the holder.d contract:

    0  HELD     stdout: one line naming who, e.g.
                "google-chrome (pid 4242 chrome, hidden) held 3600s"
    1  NONE     the compositor holds idle off for nobody
    78 n/a      no wayfire to ask, or it lacks the idle-audit plugin

Two holders are joined with "; ". A compositor that says idle is inhibited
while no client holds an inhibitor is reported as HELD, with words saying so:
its counter has drifted from its inhibitors, which is a wayfire bug (or a
compositor plugin's own inhibitor; none in this fleet takes one).

Durations are written as `<n>s`, which the alert dedup normalises away, so a
hold that grows does not re-notify on every pass.

WHOSE: a window's security context (wayfire-mods' view-info patch) names an
enclave by its instance id, so an enclave's holder reads as "titan" rather
than as the pid of severance-display, which proxies its Wayland traffic. No
context means a personal window.

TWO MORE MODES, for `vigilant holders` and `vigilant holder-go`:

    VIGILANCE_HOLDER_FORMAT=json  one JSON object per holder instead of the
                                  line: who, owner, pid, comm, window,
                                  visible, since, and a `go` token
    go <token>                    bring the holder's window into view
                                  (window-rules/focus-view, which switches to
                                  its workspace): 0 done, 1 refused, 78 n/a

The IPC is wayfire's own framing (a native-endian 32-bit length, then JSON)
over the socket in WAYFIRE_SOCKET, or any wayfire-*.socket in the runtime dir.
Standard library only: the fleet's pywayfire is not something a hook may
assume.
"""
import glob
import json
import os
import socket
import struct
import sys
import time

NA = 78


def sockets():
    env = os.environ.get("WAYFIRE_SOCKET", "")
    if env:
        return [env]
    run = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return sorted(glob.glob(os.path.join(run, "wayfire-*.socket")))


def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise OSError("connection closed")
        data += chunk
    return data


def ask(path, method="idle-audit/list", data=None):
    body = json.dumps({"method": method, "data": data or {}}).encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(5)
        sock.connect(path)
        sock.sendall(struct.pack("=I", len(body)) + body)
        (length,) = struct.unpack("=I", recv_exact(sock, 4))
        return json.loads(recv_exact(sock, length))


def owner(path, inh):
    """An enclave's instance id, "personal", or None without a window."""
    view = inh.get("view-id")
    if view is None:
        return None
    try:
        info = ask(path, "window-rules/view-info", {"id": view}).get("info")
    except (OSError, ValueError, struct.error, AttributeError):
        return None
    ctx = (info or {}).get("security-context")
    if ctx is None:
        return "personal"
    return ctx.get("instance-id") or ctx.get("app-id") or "sandbox"


def describe(inh, now, whose=None):
    name = inh.get("app-id") or inh.get("comm") or "pid %s" % inh.get("pid")
    notes = []
    if whose and whose != "personal":
        notes.append(whose)
    notes.append(("pid %s %s" % (inh.get("pid"), inh.get("comm", ""))).strip())
    if inh.get("view-id") is None:
        notes.append("no window")
    elif not inh.get("visible"):
        notes.append("hidden")
    text = "%s (%s)" % (name, ", ".join(notes))
    since = inh.get("since")
    if isinstance(since, int) and since > 0 and now >= since:
        text += " held %ds" % (now - since)
    return text


def answering():
    """(socket path, idle-audit reply) of the first wayfire that answers."""
    for path in sockets():
        try:
            reply = ask(path)
        except (OSError, ValueError, struct.error):
            continue
        if isinstance(reply, dict) and "inhibitors" in reply:
            return path, reply
    return None, None


def go(token):
    if not token.startswith("view:") or not token[5:].isdigit():
        print("not a token this hook issued: %s" % token)
        return 1
    path, _ = answering()
    if path is None:
        print("no wayfire with the idle-audit plugin answered")
        return NA
    reply = ask(path, "window-rules/focus-view", {"id": int(token[5:])})
    if isinstance(reply, dict) and reply.get("result") == "ok":
        return 0
    print("wayfire refused: %s" % reply)
    return 1


def main():
    if os.environ.get("VIGILANCE_KIND", "holder") != "holder":
        return NA
    if len(sys.argv) >= 3 and sys.argv[1] == "go":
        return go(sys.argv[2])
    path, reply = answering()
    if reply is None:
        print("no wayfire with the idle-audit plugin answered")
        return NA
    holders = reply.get("inhibitors") or []
    if holders:
        now = int(time.time())
        whose = [owner(path, h) for h in holders]
        if os.environ.get("VIGILANCE_HOLDER_FORMAT") == "json":
            for h, w in zip(holders, whose):
                since = h.get("since")
                print(json.dumps({
                    "who": h.get("app-id") or h.get("comm") or "",
                    "owner": w, "pid": h.get("pid"), "comm": h.get("comm"),
                    "window": h.get("view-id"),
                    "visible": bool(h.get("visible")),
                    "held": (now - since) if isinstance(since, int)
                    and since > 0 and now >= since else None,
                    "go": "view:%s" % h["view-id"]
                    if h.get("view-id") is not None else None,
                    "text": describe(h, now, w)}))
            return 0
        print("; ".join(describe(h, now, w) for h, w in zip(holders, whose)))
        return 0
    if reply.get("inhibited"):
        text = ("nothing that exists: wayfire says idle is inhibited and no"
                " client holds an inhibitor, so its counter has drifted from"
                " its inhibitors (a wayfire bug)")
        if os.environ.get("VIGILANCE_HOLDER_FORMAT") == "json":
            print(json.dumps({"who": "wayfire", "owner": None, "pid": None,
                              "comm": None, "window": None, "visible": False,
                              "held": None, "go": None, "text": text}))
        else:
            print(text)
        return 0
    print("nothing holds idle off in wayfire")
    return 1


if __name__ == "__main__":
    # ANY FAILURE IS n/a, NEVER "NONE". An uncaught exception exits 1, and 1
    # here means "nothing holds idle off", which lets the watchdog call a
    # held idle timer WEDGED with certainty. A hook that could not look must
    # say so, not read as having looked and found nothing.
    try:
        rc = main()
    except Exception as exc:  # pylint: disable=broad-except
        print("could not ask wayfire: %s" % exc)
        rc = NA
    sys.exit(rc)
