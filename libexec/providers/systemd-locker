#!/bin/sh
# systemd-locker - LOCK PROVIDER, wired as a lock.d hook.
#
# NAMED FOR THE MECHANISM, NOT FOR ONE LOCKER: it brings up whatever
# VIGILANCE_LOCKER names as a transient --user unit, and THE UNIT IS THE SPAN
# OF THE LOCK. Only the defaults here are swaylock's. Nothing dispatches on
# the filename; `report` identifies a provider by its `providers/` DIRECTORY.
#
# THE UNIT OWNS THE LIFETIME, which is what this file buys: the unit name is
# the singleton, `systemctl start` blocks until commit, systemd tracks the
# span, and ExecStopPost is the unlock detector (it also fires on a CRASH).
# Verified against a real swaylock in test/lock-span.t.
#
# GuessMainPID=no IS LOAD-BEARING: swaylock forks a password-backend child, so
# the cgroup holds two processes and systemd cannot guess which is main
# (MainPID=0). Cgroup emptiness is the honest liveness signal for a process
# that forks helpers; letting systemd guess makes it track the wrong one.
#
# RETURNS AT COMMIT, not at unlock, which is both the semantics
# `Before=sleep.target` needs (the box cannot sleep until the lock is up) and
# what releases the caller. Blocking until unlock pinned swayidle for hours at
# a time and stopped it firing any other timer.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../../lib/hook_lib"

edge=${1:-${VIGILANCE_EDGE:-}}
[ "$edge" = lock ] || exit 0        # only the lock edge brings a locker up

# Self-locate vigilant for the ExecStopPost, for the same reason the logind
# trigger does: the transient unit will not have ~/.local/bin on its PATH, so
# `command -v` here would bake in an empty path and the unlock edge would
# never be crossed.
_vigilant=$(dirname "$_self")/../../../bin/vigilant
if [ ! -x "$_vigilant" ]; then
  _vigilant=$(command -v vigilant 2>/dev/null || true)
fi
if [ -z "$_vigilant" ] || [ ! -x "$_vigilant" ]; then
  echo "swaylock provider: cannot locate vigilant for ExecStopPost" >&2
  exit 1
fi
_vigilant=$(readlink -f "$_vigilant")

UNIT=${VIGILANCE_LOCK_UNIT:-screen-lock.service}
LOCKER=${VIGILANCE_LOCKER:-swaylock}
# THE LOCKER'S ARGV AND UNIT TYPE ARE ITS OWN. With only the NAME as a knob
# this was a half promise of the kind that fails on the security path:
# `VIGILANCE_LOCKER=i3lock` resolved, passed `command -v`, and was handed `-f`,
# which i3lock does not have, so the unit failed and the screen did not lock.
# `Type=forking` is the same assumption one layer down, asserting the locker
# DETACHES: a foreground locker (xsecurelock, `i3lock -n`) leaves systemd-run
# waiting for a fork that never comes.
#
# Defaults are swaylock's, so the shipped configuration is unchanged. An X11
# box is two knobs: VIGILANCE_LOCKER=i3lock VIGILANCE_LOCKER_ARGV=-n plus
# VIGILANCE_LOCKER_TYPE=simple.
LOCKER_ARGV=${VIGILANCE_LOCKER_ARGV:--f}
LOCKER_TYPE=${VIGILANCE_LOCKER_TYPE:-forking}

# NAMES TO REMOVE FROM THE UNIT'S ENVIRONMENT, and THE ASYMMETRY IS THE WHOLE
# REASON IT EXISTS. A --user unit inherits the user MANAGER's environment, so
# SETTING a variable for the locker is already possible (import it into the
# manager, the advice this file gives for WAYLAND_DISPLAY below) while
# UN-importing one for one unit had no mechanism at all.
#
# Measured in the guest: i3lock checks WAYLAND_DISPLAY and refuses REGARDLESS
# of DISPLAY, so on any box whose manager carries it, which is any box told to
# import it for swaylock, the documented X11 example could not start at all.
#
# No matching knob for SETTING: the manager already covers that direction.
LOCKER_UNSETENV=${VIGILANCE_LOCKER_UNSETENV:-}

command -v "$LOCKER" >/dev/null 2>&1 || {
  echo "swaylock provider: '$LOCKER' not found" >&2; exit 1; }

# IS OUR UNIT UP? Deliberately narrower than locker-up's probe, which asks
# whether the SESSION is secured by anything at all. This asks only about the
# unit this hook owns, the right question both for "already done" and for "did
# the other racer win".
#
# THE STATE, NOT A BOOLEAN, which is a bug this already shipped once:
# `systemctl is-active` is FALSE while a unit is ACTIVATING, so the race branch
# below asked a few milliseconds too early and reported failure about a lock
# that was coming up.
#
# OVERRIDABLE BY A PATH whose CONTENT is the state (absent means inactive),
# because otherwise this is untestable in BOTH substrates: the stub tier must
# not create transient units on the developer's systemd, and the VM has no user
# bus at all. A file also lets a fixture model the state CHANGING mid-run,
# which is the nature of a race, where a boolean could not express `activating`
# and so agreed with the broken code.
_unit_state() {   # -> systemd ActiveState
  if [ -n "${VIGILANCE_LOCK_ACTIVE_FILE:-}" ]; then
    _us=$(cat "$VIGILANCE_LOCK_ACTIVE_FILE" 2>/dev/null || true)
  else
    _us=$(systemctl --user show "$UNIT" -p ActiveState --value 2>/dev/null \
          || true)
  fi
  printf '%s\n' "${_us:-inactive}"
}

# How long to let a concurrent start settle before calling it a failure. The
# winner's `systemd-run` blocks until the unit is up, so this is the span of
# one locker launch, not a guess about contention.
SETTLE=${VIGILANCE_LOCK_SETTLE:-5}

# Already up, or on its way: nothing to do. This check ALONE is a test-then-act
# and the window between it and the systemd-run below is real; see the race
# note down there.
case "$(_unit_state)" in active|activating|reloading) exit 0 ;; esac
systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true

# The argv comes from a separate helper so THIS file knows nothing about panel
# counts, wallpapers or indicator sizing. That knowledge is HWDP's and leaves
# with it; an absent helper simply yields a plain lock.
#
# IT IS ASKED ABOUT THE LOCKER IN USE, which is the other half of making the
# locker substitutable: the helper's output is inherently locker-specific (the
# shipped one emits swaylock's `-C <conf>`), so handing it to whatever locker
# was configured produced `i3lock -C .../swaylock.conf`. Backward compatible,
# since a helper that ignores the argument behaves as before, which is every
# helper that exists today.
_args=
if command -v vigilance-lock-argv >/dev/null 2>&1; then
  _args=$(vigilance-lock-argv "$LOCKER" 2>/dev/null || true)
fi

# LOSING THE RACE IS NOT FAILING. Two requests can arrive together (a double
# hotkey press, or a keybind and a logind Session.Lock in the same second) and
# both pass the is-active check above before either starts the unit. systemd
# arbitrates correctly and refuses the second with "unit already exists";
# treating that refusal as an error is the bug, because the postcondition this
# hook exists for is satisfied either way. It cost four alerts over three days
# on the most security-critical edge there is, about locks that came up fine.
#
# So the failure path asks the question again rather than assuming. A hook that
# cannot survive being run twice at once is not idempotent, which this package
# requires of anything that mutates state.
# THE UNLOCK IS ATTRIBUTED, because this is the ONLY route to it: nothing
# detects an unlock by watching, so every `cross unlock` on a healthy box comes
# from here and would otherwise be indistinguishable from a deliberate
# `go open`. `locker-exit` says the locker stopped, whichever way it stopped,
# so a crash and a human unlocking read alike and that is honest.
#
# `--setenv` reaches ExecStopPost by setting the unit's Environment, which
# every Exec line inherits. It reaches the LOCKER too, harmlessly.
# shellcheck disable=SC2086
_unsetprop=
[ -z "$LOCKER_UNSETENV" ] \
  || _unsetprop="--property=UnsetEnvironment=$LOCKER_UNSETENV"
if systemd-run --user --collect --unit="$UNIT" \
     --property=Type="$LOCKER_TYPE" \
     --property=GuessMainPID=no \
     --property="ExecStopPost=$_vigilant go open" \
     --setenv=VIGILANCE_SOURCE=locker-exit \
     $_unsetprop \
     -- "$LOCKER" $LOCKER_ARGV $_args >/dev/null 2>&1; then
  # STARTED IS NOT RUNNING. Measured in the guest: the unit genuinely started,
  # i3lock refused on Wayland and died in milliseconds, and `go lock` returned
  # rc=0 with no locker anywhere. A false green on the security edge, produced
  # by the provider rather than caught by it, and silent until the next
  # supervision pass because `_cross_one` does not run the verify tier.
  #
  # `Type=forking` ESTABLISHES NOTHING ON ITS OWN, contrary to the obvious
  # reading that systemd-run blocks until the locker forks. Measured:
  #
  #   forks a child and exits 0   rc=0, state immediately `active`
  #   just exits 0, no fork       rc=0, state immediately INACTIVE
  #
  # systemd does not fail the start for the second, so a locker that asks a
  # daemon to lock and exits read as a successful lock under the DEFAULT type,
  # which every shipped box uses. The two cases differ IMMEDIATELY, so one
  # sample the instant systemd-run returns covers every type for the cost of a
  # `systemctl show`.
  #
  # ONLY A NON-FORKING LOCKER IS WATCHED, which is where waiting belongs: under
  # `simple` the unit is `active` at t=0 and the locker can die a moment later,
  # whereas a forked locker alive at t=0 is systemd's to track, and if it dies
  # ExecStopPost crosses `unlock` and locker-up catches it.
  #
  # IT REQUIRES A GOOD STATE RATHER THAN LISTING THE BAD ONES. Matching
  # `inactive|failed` missed DEACTIVATING, where a unit sits for as long as its
  # ExecStopPost takes (here, `vigilant go open` crossing an edge), so the loop
  # ran past the failure and returned success. A deny-list cannot see the state
  # nobody thought to name.
  _c=0
  while :; do
    case "$(_unit_state)" in
      active|activating|reloading) ;;   # alive; decide whether to keep watching
      *)
        # SAY WHAT IS KNOWN AND NAME THE REQUIREMENT, not what the screen is
        # doing. Saying "the screen is NOT locked" is something this code cannot
        # know and is FALSE for a delegating locker (an
        # `xfce4-screensaver-command --lock` shape), which leaves the screen
        # locked and its unit dead. A wrong diagnosis is worse than none,
        # because it is confidently actionable.
        #
        # REFUSING IS STILL RIGHT, for a reason about TRACKING rather than
        # about the screen: the unit is the span and ExecStopPost is the unlock
        # detector, so a locker that does not outlive its own lock makes the
        # ladder record `open` while the screen is covered, and every tier that
        # trusts the record then agrees. Failing is the loud wrong.
        echo "swaylock provider: $UNIT started and its process is gone"\
" EITHER the locker failed on startup and the screen is NOT locked, OR it"\
" locked and exited, which this provider cannot support: the unit IS the span"\
" of the lock here and ExecStopPost is how an unlock is detected, so a locker"\
" must hold the lock for its own lifetime. Its own output is in:"\
" journalctl --user -u $UNIT" >&2
        exit 1 ;;
    esac
    # A FORKED LOCKER THAT IS ALIVE NOW IS SYSTEMD'S TO TRACK, so the immediate
    # sample is the whole check and the shipped path pays nothing further.
    if [ "$LOCKER_TYPE" = forking ]; then exit 0; fi
    _c=$((_c + 1))
    if [ "$_c" -ge "${VIGILANCE_LOCK_CONFIRM:-2}" ]; then exit 0; fi
    sleep 1
  done
fi
# WAIT FOR IT TO SETTLE, do not sample once. The refusal means the unit exists,
# which means someone is starting it, which means the honest answer is not yet
# known. Sampling once reported failure while the winner's locker was
# mid-launch, the same test-then-act shape as the check above, in the code
# written to repair it.
_w=0
while [ "$_w" -le "$SETTLE" ]; do
  case "$(_unit_state)" in
    active)
      echo "swaylock provider: $UNIT was started concurrently; locker is up" >&2
      exit 0 ;;
    activating|reloading) ;;          # still coming up; keep waiting
    *) break ;;                       # inactive or failed; it is not coming
  esac
  _w=$((_w + 1))
  sleep 1
done
# NAME THE LIKELIEST CAUSE RATHER THAN JUST THE SYMPTOM. A --user unit inherits
# the user MANAGER's environment, not its caller's, so the locker cannot reach
# the compositor unless the session imported WAYLAND_DISPLAY into it. A desktop
# does that invisibly at startup; where it has not happened, every lock fails
# with nothing but "could not start".
#
# Checked only on the FAILURE path: a diagnosis, not a precondition.
echo "swaylock provider: could not start $UNIT" >&2
# TWO CAUSES NEEDING DIFFERENT REMEDIES, and the status is the thing that tells
# them apart. Piping `show-environment` into grep made THE PIPELINE'S STATUS
# GREP'S, so a `systemctl --user` that failed outright was indistinguishable
# from one that succeeded without the variable, and both printed the
# WAYLAND_DISPLAY advice: that sends a reader to import a variable INTO A
# MANAGER THAT DOES NOT EXIST, while the real cause is one status check away.
if _env=$(systemctl --user show-environment 2>/dev/null); then
  if ! printf '%s\n' "$_env" | grep -q '^WAYLAND_DISPLAY='; then
    echo "swaylock provider: the user manager has no WAYLAND_DISPLAY, so the" \
      "unit cannot reach the compositor. A session normally imports it" \
      "(systemctl --user import-environment WAYLAND_DISPLAY)." >&2
  fi
else
  echo "swaylock provider: cannot reach the user bus, so NO transient unit" \
    "can be started at all. The locker runs as a --user unit, so a dead or" \
    "absent per-user systemd instance disables locking entirely" \
    "(check: systemctl --user show-environment)." >&2
fi
exit 1
