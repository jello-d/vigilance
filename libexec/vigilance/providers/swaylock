#!/bin/sh
# swaylock - LOCK PROVIDER, wired as a lock.d hook.
#
# Replaces bin/smart-lock. Everything that script hand-rolled to own the
# lock's LIFETIME is now systemd's, verified against a real swaylock in
# test/lock-span.t:
#
#   flock + pgrep idempotence  -> the unit name is the singleton
#   marker file for "committed" -> `systemctl start` BLOCKS until commit
#   `while pgrep; sleep 0.25`   -> systemd tracks the span
#   unlock detection            -> ExecStopPost, which also fires on a CRASH
#   a foreground process to hold the cgroup -> the unit IS the span
#
# GuessMainPID=no is load-bearing, and was found the hard way: swaylock forks
# a password-backend child, so the cgroup holds two processes and systemd
# cannot guess which is main (MainPID=0). Cgroup emptiness is the honest
# liveness signal for a process that forks helpers; letting systemd guess
# would have it track the wrong one.
#
# RETURNS AT COMMIT, not at unlock. That matters twice over: it is exactly the
# semantics `Before=sleep.target` needs (the box cannot sleep until the lock is
# up), and it releases the caller. smart-lock blocked until unlock, which
# pinned swayidle for hours at a time (observed: 18:31 to 20:37 on one lock)
# and stopped it firing any other timer.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hook_lib"

edge=${1:-${VIGILANCE_EDGE:-}}
[ "$edge" = lock ] || exit 0        # only the lock edge brings a locker up

# Self-locate vigilant for the ExecStopPost, for the same reason the logind
# trigger does: the transient unit will not have ~/.local/bin on its PATH, so
# `command -v` here would bake in an empty path and the unlock edge would
# never be crossed.
_vigilant=$(dirname "$_self")/../../../bin/vigilant
if [ ! -x "$_vigilant" ]; then
  _vigilant=$(command -v vigilant 2>/dev/null || true)
fi
if [ -z "$_vigilant" ] || [ ! -x "$_vigilant" ]; then
  echo "swaylock provider: cannot locate vigilant for ExecStopPost" >&2
  exit 1
fi
_vigilant=$(readlink -f "$_vigilant")

UNIT=${VIGILANCE_LOCK_UNIT:-screen-lock.service}
LOCKER=${VIGILANCE_LOCKER:-swaylock}
# THE LOCKER'S ARGV AND UNIT TYPE ARE ITS OWN, and before this they were
# swaylock's while the NAME was a knob: a half promise, and the kind that
# fails on the security path. `VIGILANCE_LOCKER=i3lock` resolved, passed the
# `command -v` check, and was then handed `-f`, which i3lock does not have: the
# unit fails and the screen does not lock. `Type=forking` is the same
# assumption one layer down, because it says the locker DETACHES; a locker that
# stays in the foreground (xsecurelock, `i3lock -n`) leaves systemd-run waiting
# for a fork that never comes, so the provider reports failure about a screen
# that is locked.
#
# Defaults are swaylock's, so nothing changes for the shipped configuration.
# An X11 box is two knobs: VIGILANCE_LOCKER=i3lock VIGILANCE_LOCKER_ARGV=-n
# with VIGILANCE_LOCKER_TYPE=simple.
LOCKER_ARGV=${VIGILANCE_LOCKER_ARGV:--f}
LOCKER_TYPE=${VIGILANCE_LOCKER_TYPE:-forking}

# NAMES TO REMOVE FROM THE UNIT'S ENVIRONMENT, and the asymmetry is the whole
# reason this exists. A --user unit inherits the user MANAGER's environment, so
# SETTING something for the locker is already possible and already documented:
# import it into the manager, which is exactly the advice this file gives for
# WAYLAND_DISPLAY on the failure path below. There is no way to UN-import one
# variable for one unit, so that direction had no mechanism at all.
#
# MEASURED, in the guest, with the documented X11 configuration:
#
#   Started screen-lock.service - [systemd-run] /usr/bin/i3lock -n
#   i3lock: i3lock is a program for X11 and does not work on Wayland
#
# i3lock checks WAYLAND_DISPLAY and refuses REGARDLESS of DISPLAY. So on any box
# whose manager carries that variable, and a box running a Wayland session is
# told to put it there, an X11 locker cannot start through this provider no
# matter how the other knobs are set. The documented example could not work.
#
# NOT a second knob for setting. Building one would be speculative surface for a
# case the manager already covers, and this package has shipped enough knobs
# that nothing uses.
LOCKER_UNSETENV=${VIGILANCE_LOCKER_UNSETENV:-}

command -v "$LOCKER" >/dev/null 2>&1 || {
  echo "swaylock provider: '$LOCKER' not found" >&2; exit 1; }

# IS OUR UNIT UP? Deliberately narrower than locker-up's probe, which asks
# whether the SESSION is secured by anything at all. This asks only about the
# unit this hook owns, which is the right question both for "already done" and
# for "did the other racer win".
#
# THE STATE, NOT A BOOLEAN, and that distinction is the whole of a bug this
# already shipped once. `systemctl is-active` is FALSE while a unit is
# ACTIVATING, so the first version of the race branch below asked the question
# a few milliseconds too early and reported failure about a lock that was
# coming up. The journal shows it exactly:
#
#   14:42:00  Starting screen-lock.service     <- the winner, still activating
#   14:42:00  HOOK FAILED (rc=1): lock 10-swaylock   <- the loser asked here
#   14:42:00  Started screen-lock.service      <- active only now
#
# OVERRIDABLE BY A PATH whose CONTENT is the state (absent means inactive).
# Without it this is untestable in BOTH substrates: the stub tier must not
# create transient units on the developer's systemd, and the VM has no user bus
# at all ("Failed to connect to bus: No medium found"). A file also lets a
# fixture model the state CHANGING mid-run, which is the whole nature of a
# race, and a boolean could not express `activating` at all, which is why the
# fixture agreed with the broken code.
_unit_state() {   # -> systemd ActiveState
  if [ -n "${VIGILANCE_LOCK_ACTIVE_FILE:-}" ]; then
    _us=$(cat "$VIGILANCE_LOCK_ACTIVE_FILE" 2>/dev/null || true)
  else
    _us=$(systemctl --user show "$UNIT" -p ActiveState --value 2>/dev/null \
          || true)
  fi
  printf '%s\n' "${_us:-inactive}"
}

# How long to let a concurrent start settle before calling it a failure. The
# winner's `systemd-run` blocks until the unit is up, so this is the span of
# one locker launch, not a guess about contention.
SETTLE=${VIGILANCE_LOCK_SETTLE:-5}

# Already up, or on its way: nothing to do. This check ALONE is a test-then-act
# and the window between it and the systemd-run below is real; see the race
# note down there.
case "$(_unit_state)" in active|activating|reloading) exit 0 ;; esac
systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true

# The argv is computed by a separate helper so THIS file knows nothing about
# panel counts, wallpapers or indicator sizing. That knowledge is HWDP's and
# leaves with it; an absent helper simply yields a plain lock.
#
# IT IS ASKED ABOUT THE LOCKER IN USE, and that argument is the other half of
# making the locker substitutable. The helper's output is inherently
# locker-specific: the shipped one emits swaylock's `-C <conf>`, and the
# provider used to hand it to whatever locker it was given, so substituting the
# locker produced `i3lock -C .../swaylock.conf`. Caught by a test asserting the
# argv for the first time, which is what a second platform buys before any of
# its code exists.
#
# Backward compatible: a helper that ignores its argument behaves exactly as
# before, which is every helper that exists today.
_args=
if command -v vigilance-lock-argv >/dev/null 2>&1; then
  _args=$(vigilance-lock-argv "$LOCKER" 2>/dev/null || true)
fi

# LOSING THE RACE IS NOT FAILING. Two lock requests can arrive together, a
# double hotkey press, or a keybind and a logind Session.Lock landing in the
# same second, and then BOTH pass the is-active check above before either
# starts the unit. systemd arbitrates correctly and refuses the second with
# "unit already exists"; treating that refusal as an error is the bug, because
# the postcondition this hook exists for is satisfied either way.
#
# Measured on manifold, four times over three days, each one an alert on the
# most security-critical edge there is about a lock that came up fine:
#
#   12:58:55  cross lock: open -> lock          (twice, same second)
#   12:58:56  Started screen-lock.service        <- the winner
#   12:58:56  HOOK FAILED (rc=1): lock 10-swaylock   <- the loser
#
# So the failure path asks the question again rather than assuming. A hook that
# cannot survive being run twice at once is not idempotent, which this package
# requires of anything that mutates state.
# shellcheck disable=SC2086
_unsetprop=
[ -z "$LOCKER_UNSETENV" ] \
  || _unsetprop="--property=UnsetEnvironment=$LOCKER_UNSETENV"
if systemd-run --user --collect --unit="$UNIT" \
     --property=Type="$LOCKER_TYPE" \
     --property=GuessMainPID=no \
     --property="ExecStopPost=$_vigilant go open" \
     $_unsetprop \
     -- "$LOCKER" $LOCKER_ARGV $_args >/dev/null 2>&1; then
  # STARTED IS NOT RUNNING, and this is where that bit. Measured in the guest:
  #
  #   go lock -> rc=0, and no locker anywhere
  #   journal: Started screen-lock.service - [systemd-run] /usr/bin/i3lock -n
  #            i3lock: ... does not work on Wayland
  #
  # The unit genuinely started and the locker died in milliseconds, and the
  # crossing reported SUCCESS. That is the false green on the security edge that
  # `locker-up`'s own header is about, produced by the provider rather than
  # caught by it, and nothing says so until the next supervision pass because
  # `_cross_one` does not run the verify tier.
  #
  # I CLAIMED `Type=forking` ESTABLISHED SOMETHING AND IT DOES NOT. The claim
  # was that systemd-run blocks until the locker forks, so a successful return
  # proves it got that far. MEASURED, and it is false:
  #
  #   a script that forks a child and exits 0  rc=0, state immediately `active`
  #   a script that just exits 0, no fork      rc=0, state immediately INACTIVE
  #
  # systemd does not fail the start for the second one. So a locker that asks a
  # daemon to lock and exits was reported as a successful lock under the DEFAULT
  # type, which is the configuration every shipped box uses.
  #
  # THE MEASUREMENT ALSO GAVE A BETTER DESIGN THAN THE ONE IT BROKE. The two
  # cases differ IMMEDIATELY, with no waiting at all, so every type gets one
  # sample the instant systemd-run returns: one `systemctl show`, a few
  # milliseconds, nothing on the lock path worth counting.
  #
  # ONLY A NON-FORKING LOCKER IS THEN WATCHED, and that is where the waiting
  # belongs. Under `simple` the unit is `active` at t=0 and the locker can die a
  # moment later, which is what i3lock refusing on a Wayland box actually did; a
  # forked locker that was alive at t=0 is systemd's to track from then on, and
  # if it dies ExecStopPost crosses `unlock` and locker-up catches it.
  #
  # IT REQUIRES A GOOD STATE RATHER THAN LISTING THE BAD ONES, and the first
  # version of this did the opposite and missed. It matched `inactive|failed`,
  # and a unit whose process has exited sits in DEACTIVATING for as long as its
  # ExecStopPost takes, which here is `vigilant go open` crossing an edge:
  #
  #   t=0s  active          <- the first sample
  #   t=1s  deactivating    <- matched neither name, so the loop kept going
  #   t=3s  inactive        <- after the loop had already returned success
  #
  # A deny-list cannot see the state nobody thought to name, which is the rule
  # this suite applies to every other check with a hardcoded subject, and both
  # halves of this confirm were wrong in that one way.
  _c=0
  while :; do
    case "$(_unit_state)" in
      active|activating|reloading) ;;   # alive; decide whether to keep watching
      *)
        # SAY WHAT IS KNOWN AND NAME THE REQUIREMENT, not what the screen is
        # doing. The first version of this said "so the screen is NOT locked",
        # which this code cannot know and which is FALSE for a whole class of
        # locker: one that asks a running daemon to lock and exits (an
        # `xfce4-screensaver-command --lock` shape) leaves the screen locked and
        # its unit dead. A wrong diagnosis is worse than none because it is
        # confidently actionable, which is the lesson the WAYLAND_DISPLAY
        # message already carries three screens down.
        #
        # AND REFUSING IS STILL RIGHT, for a reason that is about tracking
        # rather than about the screen. This provider's whole design is that the
        # UNIT IS THE SPAN of the lock and ExecStopPost is the unlock detector,
        # so a locker that does not outlive its own lock makes the ladder record
        # `open` while the screen is covered: the record behind the world, which
        # every tier that trusts the record then agrees with. Reporting failure
        # is the lesser of the two wrongs, and it is the loud one.
        echo "swaylock provider: $UNIT started and its process is gone"\
" EITHER the locker failed on startup and the screen is NOT locked, OR it"\
" locked and exited, which this provider cannot support: the unit IS the span"\
" of the lock here and ExecStopPost is how an unlock is detected, so a locker"\
" must hold the lock for its own lifetime. Its own output is in:"\
" journalctl --user -u $UNIT" >&2
        exit 1 ;;
    esac
    # A FORKED LOCKER THAT IS ALIVE NOW IS SYSTEMD'S TO TRACK, so the immediate
    # sample is the whole check and the shipped path pays nothing further.
    if [ "$LOCKER_TYPE" = forking ]; then exit 0; fi
    _c=$((_c + 1))
    if [ "$_c" -ge "${VIGILANCE_LOCK_CONFIRM:-2}" ]; then exit 0; fi
    sleep 1
  done
fi
# WAIT FOR IT TO SETTLE, do not sample once. The refusal means the unit exists,
# which means someone is starting it, which means the honest answer is not yet
# known. Sampling once reported failure while the winner's locker was
# mid-launch, the same test-then-act shape as the check above, in the code
# written to repair it.
_w=0
while [ "$_w" -le "$SETTLE" ]; do
  case "$(_unit_state)" in
    active)
      echo "swaylock provider: $UNIT was started concurrently; locker is up" >&2
      exit 0 ;;
    activating|reloading) ;;          # still coming up; keep waiting
    *) break ;;                       # inactive or failed; it is not coming
  esac
  _w=$((_w + 1))
  sleep 1
done
# NAME THE LIKELIEST CAUSE RATHER THAN JUST THE SYMPTOM. A --user unit inherits
# the user MANAGER's environment, not its caller's, so the locker cannot reach
# the compositor unless the session imported WAYLAND_DISPLAY into it. On a
# desktop the compositor's startup does that and it is invisible; where it has
# not happened, every lock fails with nothing but "could not start", which is
# how this cost a debugging round the first time the session tier ran.
#
# Checked only on the FAILURE path: it is a diagnosis, not a precondition, and
# a locker that started needs no explaining.
echo "swaylock provider: could not start $UNIT" >&2
# TWO CAUSES, AND THEY NEED DIFFERENT REMEDIES. The first version of this piped
# `show-environment` into grep, so THE PIPELINE'S STATUS WAS GREP'S: a
# `systemctl --user` that failed outright was indistinguishable from one that
# succeeded without the variable, and both printed the WAYLAND_DISPLAY advice.
#
# Measured with the user manager stopped, which is the one way the
# transient-unit design fails outright:
#
#   swaylock provider: could not start screen-lock.service
#   swaylock provider: the user manager has no WAYLAND_DISPLAY, ...
#     A session normally imports it (systemctl --user import-environment ...).
#
# That sends the reader to import a variable INTO A MANAGER THAT DOES NOT
# EXIST, on the most security-critical edge there is, while the real cause is
# one status check away. A wrong diagnosis is worse than none: it is
# confidently actionable.
if _env=$(systemctl --user show-environment 2>/dev/null); then
  if ! printf '%s\n' "$_env" | grep -q '^WAYLAND_DISPLAY='; then
    echo "swaylock provider: the user manager has no WAYLAND_DISPLAY, so the" \
      "unit cannot reach the compositor. A session normally imports it" \
      "(systemctl --user import-environment WAYLAND_DISPLAY)." >&2
  fi
else
  echo "swaylock provider: cannot reach the user bus, so NO transient unit" \
    "can be started at all. The locker runs as a --user unit, so a dead or" \
    "absent per-user systemd instance disables locking entirely" \
    "(check: systemctl --user show-environment)." >&2
fi
exit 1
