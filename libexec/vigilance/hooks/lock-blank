#!/bin/sh
# lock-blank - paint the LOCK SURFACE black at a dark rung, restore it at a lit
# one, by signalling the locker.
#
# WHY THIS EXISTS AND NOTHING ELSE CAN DO IT. Under ext-session-lock the lock
# surface renders above every layer-shell layer, so no overlay can cover a
# locked screen. The only things that can change what a locked display emits
# are the locker itself, gamma control, and the monitor's own hardware. On a
# panel with no DPMS standby (an OLED that advertises no D6=02) the hardware
# path can only DIM -- measured on an AW2725Q: brightness 0 is dim, not black.
#
# So the locker has to repaint, and swaylock is patched with a two-signal
# control interface for exactly that:
#
#     SIGUSR2   blank    paint the solid colour instead of the image
#     SIGRTMIN  restore  paint the image again
#
# THE PATCH CARRIES NO POLICY. It has no timer and no options: WHEN to blank is
# this hook's business, driven by the ladder, which is why the timer half of the
# old patch was correctly retired. Wire this into sleep.d and wake.d and the
# blank rides the same edges as every other peripheral.
#
# ON AN OLED A BLACK PIXEL IS AN OFF PIXEL, so this is a real power-down of the
# emitting surface without touching a power state the panel may not return
# from. Paired with ddc-monitor's brightness fallback, even the unlock indicator
# is dimmed.
#
# NOT A SECURITY BOUNDARY. Blanking changes what is drawn, never whether the
# session is locked; swaylock is still holding the lock and still wants the
# password. A failure here costs a dark wallpaper, never access.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hooklib.sh"

edge=${1:-${VIGILANCE_EDGE:-}}
_intent=$(hook_intent "$edge")
case "$_intent" in
  dark|lit) ;;
  *)        exit 0 ;;
esac

LOCKER=${VIGILANCE_LOCKER:-swaylock}

# NO LOCKER IS n/a, NOT FAILURE, and this is the common case rather than an
# edge: a machine crosses `sleep` from an unlocked session all the time (the
# display keybind, a manual `go sleep`), and a greeter has no locker at all.
# There is simply no lock surface to repaint.
if ! pgrep -x "$LOCKER" >/dev/null 2>&1; then
  exit 0
fi

MARK=${VIGILANCE_STATE_DIR:-/tmp}/blanked

# HARDWARE-GATED, because this is a LAST RESORT and not a preference.
#
# It exists for a panel that cannot go dark any other way: no sysfs backlight
# to drop to 0, and a monitor advertising no DPMS standby, leaving the locker's
# own pixels as the only thing that can stop the display emitting. On a box
# that HAS a backlight, panel-backlight already takes the panel genuinely dark
# and this buys nothing -- while costing the lock wallpaper.
#
# And not merely nothing. On an ASCENT the machine scope unwinds first, so
# 20-panel-backlight restores the brightness BEFORE this user-scope hook
# repaints: the panel lights up showing a BLACK lock surface and the wallpaper
# arrives after. A visible black flash on every wake, on a box that needed none
# of this. Observed on manifold, which has intel_backlight at max 400.
#
# The CHEAP predicate, deliberately: "is there a usable sysfs backlight". The
# honest one is "can every output be darkened some other way", which needs the
# output list and a ddcutil round trip on the lock path. This errs toward
# leaving the wallpaper alone, and VIGILANCE_LOCK_BLANK=always is the escape
# hatch for a mixed setup -- an internal panel with a backlight plus an
# external monitor without one, where the cheap test answers wrong.
_has_backlight() {
  for _lb in "${VIGILANCE_SYS_BACKLIGHT:-/sys/class/backlight}"/*; do
    [ -r "$_lb/max_brightness" ] || continue
    _lbm=$(cat "$_lb/max_brightness" 2>/dev/null || echo 0)
    case "${_lbm:-0}" in ''|*[!0-9]*) continue ;; esac
    if [ "$_lbm" -gt 0 ]; then return 0; fi
  done
  return 1
}
_gated=0
case "${VIGILANCE_LOCK_BLANK:-auto}" in
  always) ;;
  never)  _gated=1 ;;
  *)      if _has_backlight; then _gated=1; fi ;;
esac
# A RESTORE IS NEVER GATED. If a marker is outstanding we blanked this surface
# before the policy said not to -- on a deploy, a config change, or a mixed
# setup -- and declining now would leave the wallpaper black with nothing able
# to bring it back. A short-circuit on state that cannot clear the state is the
# exact shape that left a stale save file failing every ascent for four days.
if [ "$_gated" = 1 ] && { [ "$_intent" = dark ] || [ ! -f "$MARK" ]; }; then
  echo "lock-blank: this panel goes dark by its own backlight; leaving the"\
" lock wallpaper alone (VIGILANCE_LOCK_BLANK=always to override)"
  exit 78
fi

# VERIFY BY LOOKING AT THE PIXELS. swaylock exposes no way to ask what it is
# painting -- but it is not the only thing that can see the surface. The
# compositor can, through wlr-screencopy, and grim plus ImageMagick turn that
# into a number. This is a measurement of what the display is ACTUALLY
# EMITTING, not a proxy for it, which makes it the strongest verifier here.
#
# MEASURE WITH THE ALPHA CHANNEL OFF. `%[fx:mean]` averages ALL channels
# including alpha, so an opaque all-black frame reads 0.25 rather than 0 -- the
# alpha is 1.0 and gets averaged in. The first version of this check called a
# genuinely pitch-black screen "not black" for exactly that reason, and
# disagreed with a human looking straight at it. A measurement that contradicts
# the eyes is usually the measurement.
#
# SAMPLE THE WHOLE SURFACE. A corner crop reads near-zero on a dark wallpaper
# and would pass on a lit screen; the blank is a claim about the whole surface,
# so `grim -s` downscales the whole thing rather than cropping part of it.
# The measurement lives in hooklib now: `screen-dark` needs the same one, and
# two checks disagreeing about what "black" means would be its own bug.

if [ "${VIGILANCE_KIND:-act}" = verify ]; then
  # A LIT rung is checked against the RECORD, not the pixels: a legitimately
  # dark wallpaper is indistinguishable from a stuck blank, and failing on that
  # would cry wolf at anyone whose lock screen happens to be black. What IS
  # drift is our own marker surviving: we blanked and never restored.
  if [ "$_intent" = lit ]; then
    if [ -f "$MARK" ]; then
      echo "lock-blank: the surface was blanked and never restored (marker"\
" outstanding at a lit rung)" >&2
      exit 1
    fi
    exit 0
  fi
  # A DARK rung IS checked against the pixels, because that is the claim.
  if [ -z "${VIGILANCE_SCREEN_LUMA:-}" ] \
     && { ! command -v grim >/dev/null 2>&1 \
          || ! command -v magick >/dev/null 2>&1; }; then
    exit 0                                  # nothing to measure with: n/a
  fi
  _l=$(hook_screen_luma)
  if [ -z "$_l" ]; then
    # No capture is n/a rather than drift: a greeter or a tty has no display to
    # grab, and asserting about a surface we cannot see is the thing this hook
    # was rewritten to stop doing.
    exit 0
  fi
  if hook_luma_is_dark "$_l"; then exit 0; fi
  echo "lock-blank: the lock surface is emitting light at a dark rung (mean"\
" luminance $_l, want ~0). The screen is not blank." >&2
  exit 1
fi

if [ "$_intent" = dark ]; then _sig=USR2; else _sig=RTMIN; fi

# pkill by NAME, because the locker is deliberately a SIBLING unit rather than
# a child of this process (a locker in a oneshot's cgroup gets reaped with it,
# which is how a frozen ext-session-lock happened once). There is no pid to
# inherit, so the name is what we have.
#
# The patch resets these dispositions to SIG_IGN in swaylock's password-backend
# CHILD precisely because this broadcast reaches it too; without that reset an
# inherited handler would run in a process with no event loop.
if ! pkill -"$_sig" -x "$LOCKER" 2>/dev/null; then
  echo "lock-blank: could not signal $LOCKER ($_sig)" >&2
  exit 1
fi

# The marker is what a LIT verify checks: a legitimately black wallpaper cannot
# be told from a stuck blank by looking, but our own record of having blanked
# and not restored is unambiguous.
mkdir -p "$(dirname "$MARK")" 2>/dev/null || true
if [ "$_intent" = dark ]; then
  printf '%s\n' "$(date +%s)" > "$MARK" 2>/dev/null || true
else
  rm -f "$MARK" 2>/dev/null || true
fi
exit 0
