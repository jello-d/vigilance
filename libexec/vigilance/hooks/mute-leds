#!/bin/sh
# mute-leds - the mute and mic-mute indicator LEDs on the keyboard deck glow
# even with the backlight off, so they need dimming too.
#
# SHIPPED BY VIGILANCE because the mechanism is standard: platform::mute and
# platform::micmute are ordinary kernel LED class devices.
#
# They DO need a rule, just not a bespoke one per integrator: udev/
# 99-vigilance.rules names these two LEDs exactly and grants the `vigilant`
# group write. Relying on brightnessctl's own rule instead would mean joining
# `input`, which also grants raw read on /dev/input/event* -- a keylogging
# capability in exchange for dimming an indicator LED.
#
# Deliberately INDEPENDENT of whatever drives the mute STATE (a sync daemon,
# or the kernel's snd_ctl_led). Blank-dimming is a separate concern that must
# outlive any of them, so it lives here as a hook rather than as a command on
# some daemon. A mute toggled while dark re-syncs on its next change.
#
# Each LED is saved and restored INDEPENDENTLY: mute and micmute are set from
# different state, so collapsing them into one saved value would restore the
# wrong one.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hooklib.sh"

# 78, NOT 0. Without brightnessctl this hook drives nothing, and exit 0
# would count it as a tier that CHECKED -- the conflation the n/a
# contract exists to break, in the tier where it was first measured.
if ! hook_have_brightnessctl; then
  echo "mute-leds: brightnessctl is not installed; nothing to drive" >&2
  exit 78
fi

LEDS='platform::mute platform::micmute'
edge=${1:-${VIGILANCE_EDGE:-}}
_intent=$(hook_intent "$edge")
if [ "$_intent" = none ]; then exit 0; fi

_rc=0 _na=0 _checked=0
for _l in $LEDS; do
  [ -e "/sys/class/leds/$_l/brightness" ] || continue
  _save=${VIGILANCE_STATE_DIR:-/tmp}/$_l
  if [ "${VIGILANCE_KIND:-act}" = verify ]; then
    # COUNT n/a APART FROM FAILURE, the same way the runner does across
    # hooks. `|| _rc=1` collapsed them, so a device this hook DECLINED to
    # judge -- one something else owns and keeps relighting -- was reported as
    # a failed check. That is the conflation the 78 contract exists to break,
    # reappearing inside a hook that drives two devices.
    _vrc=0
    hook_verify_level "$_save" "$_intent" --class=leds --device="$_l" \
      || _vrc=$?
    if [ "$_vrc" = 78 ]; then _na=$((_na + 1))
    elif [ "$_vrc" != 0 ]; then _rc=1
    else _checked=$((_checked + 1)); fi
    continue
  fi
  case "$_intent" in
    dark) hook_dark "$_save" --class=leds --device="$_l" ;;
    lit)  hook_lit  "$_save" --class=leds --device="$_l" ;;
  esac
done
# NOTHING CHECKED AND SOMETHING DECLINED is n/a for the whole hook, not
# success: 0 there would claim a verdict about both LEDs when neither was
# judged.
if [ "$_rc" = 0 ] && [ "$_checked" = 0 ] && [ "$_na" -gt 0 ]; then
  exit 78
fi
exit "$_rc"
