#!/bin/sh
# screen-dark - VERIFY-ONLY: is the screen actually emitting at a dark rung?
#
# THE ONE CHECK THAT ASKS THE RUNG'S QUESTION rather than a device's. Every
# other verifier in this suite asks about its own mechanism -- "did my I2C bus
# take the command", "is my sysfs backlight at 0", "are my compositor's outputs
# off" -- and each is satisfied or n/a on its own terms. Nothing asserted the
# thing the rung actually MEANS.
#
# That is not a theoretical gap. A lit screen survived four separate green
# verdicts:
#
#   a D6 code the panel does not implement      ddc-monitor was satisfied
#   a monitor that vanished from its own map    it was not in the map to check
#   a user session with no darkening mechanism  every hook declined
#   a greeter with none either                  every hook declined
#
# In all four the machine said `sleep` and the screen was lit, and every hook
# was individually correct. The failure lived in the gap BETWEEN them, which is
# precisely where a per-device check cannot look.
#
# So this one is deliberately incurious about WHICH mechanism was meant to act.
# It compares what the display is showing against what the rung claims, and so
# it holds when a mechanism is broken, when one was never wired, and when the
# hook that owned it declined.
#
# BUT IT CANNOT SEE A BACKLIGHT, and an earlier version of this comment claimed
# it measured "what the display emits", which is false. `grim` copies the
# COMPOSITOR'S framebuffer; the backlight is a panel property outside the
# compositor entirely, so a capture is identical whether the panel is blazing
# or completely off. Measured on manifold: display-watch recorded bl=0 at the
# `sleep` rung while this hook reported "still emitting, mean luminance 0.277"
# once a minute.
#
# It had looked correct only because lock-blank was painting the surface black
# on that box; gating lock-blank to the hardware that needs it took the mask
# away and left this asserting something it had never been able to check.
#
# So the backlight is consulted directly. A panel held dark by its backlight
# emits nothing WHATEVER the framebuffer says, and that is an observation, not
# an assumption. What remains genuinely blind is darkening by DDC -- ddc-
# monitor's own verify owns that, and with lock-blank gated on the absence of a
# backlight the two cases do not overlap: a box with no backlight paints the
# surface black, which this CAN see.
#
# DEFENSE IN DEPTH, not a replacement. The per-device verifiers say WHICH
# mechanism failed, which is what you need to fix it. This one says THAT the
# machine is lying, which is what you need to know at all. Keep both.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hooklib.sh"

# VERIFY ONLY. It actuates nothing: there is no "make the screen dark" here,
# because choosing a mechanism is exactly what this hook refuses to do.
if [ "${VIGILANCE_KIND:-act}" != verify ]; then
  exit 0
fi

edge=${1:-${VIGILANCE_EDGE:-}}
_intent=$(hook_intent "$edge")

# A LIT rung is deliberately NOT asserted. A legitimately black wallpaper, a
# dark theme, a screen showing a mostly-black terminal -- none of those is
# drift, and failing on them would make this the crying-wolf check that gets
# switched off. The claim worth making is one-directional: at a DARK rung the
# screen must not be emitting.
if [ "$_intent" != dark ]; then
  exit 0
fi

# THE BACKLIGHT FIRST, because it settles the question outright and costs a
# file read, where the capture costs over a second.
for _sb in "${VIGILANCE_SYS_BACKLIGHT:-/sys/class/backlight}"/*; do
  [ -r "$_sb/brightness" ] && [ -r "$_sb/max_brightness" ] || continue
  _sbc=$(cat "$_sb/brightness" 2>/dev/null || echo)
  _sbm=$(cat "$_sb/max_brightness" 2>/dev/null || echo)
  case "${_sbc:-}${_sbm:-}" in ''|*[!0-9]*) continue ;; esac
  [ "$_sbm" -gt 0 ] || continue
  # The same "dark is not exactly 0 on every device" threshold hooklib uses,
  # so the two tiers cannot disagree about what dark means.
  if [ "$_sbc" -le $((_sbm / 10)) ]; then
    exit 0
  fi
done

_l=$(hook_screen_luma)
if [ -z "$_l" ]; then
  # NOTHING TO MEASURE: no compositor to grab from (a greeter over ssh, a tty,
  # a headless box), or no grim/magick. Saying n/a is the honest answer, and
  # saying it with 78 is what keeps an edge where nothing could be checked from
  # reading like one where everything passed.
  exit 78
fi

if hook_luma_is_dark "$_l"; then
  exit 0
fi

echo "screen-dark: the machine is at a DARK rung ($edge) and the display is"\
" still emitting (mean luminance $_l, want ~0). Whatever was supposed to"\
" darken it did not -- and every per-device verifier can still be green while"\
" this is true, because each one only knows about its own mechanism." >&2
exit 1
