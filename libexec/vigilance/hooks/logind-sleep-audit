#!/bin/sh
# logind-sleep-audit - did every real sleep produce the edges it should have?
#
# An `audit` hook reads ONE event source and prints, per event,
#
#     <epoch> <edge> [note]
#
# meaning "at <epoch> something happened that should have produced <edge>".
# vigilant does the reconciliation against its own log; this only has to know
# how to read logind.
#
# WHY THIS EXISTS, concretely. On 2026-09-12 the battery hit critical, UPower
# hybrid-slept the machine, and lock-on-sleep.service was asked to lock it
# first. The unit died 203/EXEC on a bad ExecStart, and systemd reached
# sleep.target and slept anyway, because a failed Before= oneshot does NOT block
# the transition. Afterwards nothing was in a wrong state and nothing was
# pending, so neither `verify` nor `due` could see it. The machine had slept
# unlocked and the only trace was history.
#
# It had been doing that on EVERY sleep for the whole refactor, while the unit
# reported `enabled` and `canonical` -- both true of a unit naming a binary that
# does not exist.
#
# THE EDGE A SLEEP IMPLIES IS `lock`, IN BOTH DIRECTIONS, and it is not
# `suspend`:
#
#   before sleeping   lock-on-sleep.service    Before=sleep.target   `go lock`
#   after resuming    vigilance-resume.service After=suspend.target  `go lock`
#
# ASSERT WHAT THE UNITS ACTUALLY DO. Both run `vigilant go lock`, so `lock` is
# the only edge either can produce. This said `sleep` for the resume direction,
# left over from when that unit ran `go sleep` (changed in a5355c0: coming back
# to `sleep` left the machine dark with nothing armed to ascend). Asserting an
# edge no unit crosses any more would have reported a MISS on every correctly
# handled resume -- the forensic tier crying wolf, which is precisely the
# failure the `due` anchor bug already cost once.
#
# A HEALTHY RESUME CROSSES NOTHING AT ALL, and that is why vigilant counts
# `already at '<rung>'` as satisfying the assertion. The depth file lives in
# XDG_RUNTIME_DIR, which survives suspend, so the machine comes back still
# recorded at `lock` and `go lock` is correctly a no-op. The edge's PURPOSE was
# achieved; demanding a crossing would fail the healthy case.
set -eu

SINCE=${VIGILANCE_AUDIT_SINCE:--1 day}

command -v journalctl >/dev/null 2>&1 || exit 0

# logind announces both directions. "Reached target sleep.target" is the point
# of no return on the way down; the resume line is systemd-sleep returning.
# -o short-unix gives an epoch directly, so nothing here has to parse a date.
journalctl --since "$SINCE" -o short-unix --no-pager 2>/dev/null | awk '
  # Going down: the lock should already have happened.
  /Reached target sleep\.target/ {
    printf "%d lock went to sleep\n", $1
  }
  # Coming back: the session must still be locked. Same edge, because the resume
  # unit runs the same command -- see the header on why a no-op counts.
  /System returned from sleep operation/ {
    printf "%d lock resumed from sleep\n", $1
  }
'
exit 0
