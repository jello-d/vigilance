#!/bin/sh
# ddc-monitor - real power-down of an external DDC/CI monitor, over MCCS VCP
# D6. Shipped by vigilance because the MECHANISM is standard; whether it runs
# is the integrator's call (symlink it into <edge>.d/).
#
# WHY DDC AND NOT DPMS: setvcp is an out-of-band I2C command to the monitor's
# OWN scaler, not a compositor connector change, so it does NOT trigger the
# wlroots re-modeset that destroys views on this Wayfire build. Connector
# cycling (wlopm/DPMS) is the unsafe path here; DDC is not. This is also the
# only way to genuinely power a panel down: painting the lock surface black
# leaves a non-OLED backlight fully lit (a lit black screen, no real saving).
#
# WHY D6=02 AND NOT 03/04: 02 (Standby) is the widely supported DDC-ALIVE
# power-down. It kills the backlight but keeps the DDC link up, so 01 can wake
# it. 03 (Suspend) is not advertised by every monitor. 04 (Off) drops the link
# into a state DDC cannot wake, needing a physical power button or a DP
# replug, so it is never used from a hook.
#
# STATELESS by design: 02 and 01 are absolute, so a repeat is a no-op and
# there is nothing to save. That also makes `resume` correct for free.
# PLATFORM-NEUTRAL, AND NOT REDUNDANT WITH ANYTHING. ddcutil speaks I2C to the
# monitor's own scaler, so this works identically under X11, any Wayland
# compositor, or none. No compositor and no X server has ever been able to do
# it: DPMS drops the video SIGNAL and leaves the panel to decide what that means
# (some sleep, some show "no signal", some stay backlit). This commands it.
#
# THE COROLLARY IS THE DANGEROUS PART. Because it is out-of-band, a keypress can
# NEVER undo it -- the input never reaches the monitor. Wiring this means the
# ascent must be armed by something, or the screen stays dark and the user is
# left pressing keys at a monitor that cannot hear them. Not theoretical: it is
# how this suite's blackouts presented, every time.
#
# See the invariant in bin/vigilant: nothing may put the machine into a dark
# rung unless it arms its own way back.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hooklib.sh"

edge=${1:-${VIGILANCE_EDGE:-}}
_intent=$(hook_intent "$edge")
case "$_intent" in
  dark|lit) ;;
  *)        exit 0 ;;
esac

# THE DARK VALUE IS PER-MONITOR, NOT A CONSTANT, and assuming otherwise made
# this hook a no-op on the panel that needed it most.
#
# MCCS defines VCP D6 as 01=on, 02=standby, 03=suspend, 04=off, 05=off
# (write-only), and each monitor advertises which it actually implements.
# Writing one it does not implement is NOT an error the monitor reports:
# `setvcp --noverify` sends it and returns 0, so the screen stays lit while the
# edge records a clean crossing. Asserted-versus-actual drift, in the actuator.
#
# Measured on manifestor:
#   HP E243     D6: 01 02 03 04 05
#   Dell AW2725Q D6: 01 04 05          <-- no 02
#
# The hardcoded 02 was WORSE than a no-op on the QD-OLED. Observed live: the
# panel went dark at the `sleep` edge, stopped answering DDC entirely, and could
# not be brought back -- `setvcp d6 01` returns "DDC communication failed", so
# there is no wake channel left. It needed a power cycle at the monitor.
#
# ONLY 02, AND THAT IS THE WHOLE SAFETY RULE.
#
# D6 is not a scale of "more off", it is a set of states with different WAKE
# CHANNELS. 02 is DPMS STANDBY: shallow, the scaler stays listening, and 01
# brings it back. 03/04/05 are suspend, full off, and "turn off display" -- none
# of them promises the monitor is still listening to I2C afterwards, and if it
# is not there is NO WAY BACK over DDC.
#
# That is not theoretical. The Dell AW2725Q advertises 01/04/05 with NO 02 at
# all, and when it was driven into an off state it stopped answering DDC
# entirely: `setvcp d6 01` returned "DDC communication failed" and it needed a
# power cycle at the monitor.
#
# So a panel that offers no shallow standby is a panel with no DDC-recoverable
# off state, and the absence of 02 is itself the signal. Leave it alone and let
# the compositor-side true-black cover it -- on an OLED, black genuinely is off.
#
# This is the ladder's own invariant applied to a peripheral: nothing may be put
# into a dark state unless its way back is armed. A deeper code is available
# with VIGILANCE_DDC_DEEP_OFF=1 for an operator who has VERIFIED on their own
# hardware that the monitor still answers DDC there. Default off, because the
# cost of being wrong is a dark panel and a walk to the power button.
#
# NOT CACHED. `capabilities` measured 310ms per bus, the same as a getvcp, so
# the whole pass stays around 2s against a 10s hook bound -- and a cached value
# that outlives a monitor swap would write the wrong code at exactly the moment
# the hardware changed, which is the failure this is fixing.
_dark_value() {   # bus -> best supported off value, or "" if none
  _caps=$(ddcutil --bus "$1" capabilities 2>/dev/null \
    | awk '/Feature: D6/ { f = 1; next }
           f && /^[[:space:]]*Feature:/ { f = 0 }
           f && /^[[:space:]]*[0-9A-Fa-f][0-9A-Fa-f]:/ {
             v = $1; sub(":", "", v); printf "%s ", tolower(v) }')
  case " $_caps " in *" 02 "*) printf '02'; return 0 ;; esac
  if [ -n "${VIGILANCE_DDC_DEEP_OFF:-}" ]; then
    for _want in 03 04 05; do
      case " $_caps " in *" $_want "*) printf '%s' "$_want"; return 0 ;; esac
    done
  fi
  return 0
}

# Why a bus is being skipped, so the report is actionable rather than mute.
_no_dark_reason() {   # bus
  _caps=$(ddcutil --bus "$1" capabilities 2>/dev/null | grep -c "Feature: D6")
  if [ "$_caps" = 0 ]; then
    printf 'it advertises no D6 power control at all'
  else
    printf 'it offers no DPMS STANDBY (02), only deeper off states with no'
    printf ' guaranteed DDC wake channel. Set VIGILANCE_DDC_DEEP_OFF=1 only if'
    printf ' you have verified this panel still answers DDC when off'
  fi
}

# VERIFY reads VCP D6 back instead of writing it. This is precisely the check
# that was run BY HAND to prove manifestor's monitor had been dark for two
# days while everything else reported success -- so it is known to work and
# known to be the one that matters.
_verify=0
if [ "${VIGILANCE_KIND:-act}" = verify ]; then _verify=1; fi

# WHAT WE DROVE DARK, remembered across the edge.
#
# THE TRAP THIS CLOSES, observed on manifestor. A monitor commanded into a power
# state it does not implement stopped answering DDC. `ddcutil detect` then
# reclassifies it from "Display N" to "Invalid display" -- and the map below
# deliberately EXCLUDES invalid displays, because that is where a non-DDC eDP
# panel lives. So the dark monitor DROPPED OUT OF THE MAP: the ascent never sent
# it 01, verify never checked it, the hook returned 0 because the one monitor it
# could still see was fine, and every tier reported green with a panel dark and
# nothing left to bring it back.
#
# A monitor that vanishes from the map is indistinguishable from one that was
# never there -- UNLESS we wrote down that we put it to sleep. So we do.
DARK_RECORD=${VIGILANCE_STATE_DIR:-/tmp}/dark-buses

command -v ddcutil >/dev/null 2>&1 || exit 0

# Map "i2c_bus" for every DDC/CI display. A laptop eDP appears in `ddcutil
# detect` with a real bus and DRM connector but under an "Invalid display"
# heading, because the internal panel is not DDC/CI controllable. Pairing it
# anyway routed eDP hosts into this branch where setvcp always failed and the
# screen never blanked, so ONLY displays inside a real "Display N" block
# count. An eDP-only host yields an empty map and exits 0: nothing to drive.
_map=$(ddcutil detect --brief 2>/dev/null | awk '
  /^Invalid display/ { valid = 0 }
  /^Display /        { valid = 1 }
  /I2C bus:/         { if (valid) { b = $NF; sub(".*/i2c-", "", b); print b } }
')
[ -n "$_map" ] || exit 0

_rc=0

# A MONITOR WE DROVE DARK THAT IS NO LONGER IN THE MAP IS DRIFT, NOT ABSENCE.
# Checked at every LIT intent, before the loop, because by then it is precisely
# the monitor the loop can no longer see.
if [ "$_intent" = lit ] && [ -f "$DARK_RECORD" ]; then
  # FLATTENED, because _map is newline-separated (one bus per awk print) and a
  # `case` glob needs spaces around each entry to match one. Compared unflat it
  # matched nothing and every restored monitor read as vanished -- a check that
  # fires on the healthy path is worse than none, since it is the one people
  # switch off.
  _map_flat=" $(printf '%s ' $_map)"
  _still=
  while IFS= read -r _was; do
    if [ -z "$_was" ]; then continue; fi
    case "$_map_flat" in
      *" $_was "*) continue ;;                 # back, and about to be lit
    esac
    echo "ddc-monitor: bus $_was was driven DARK and has now dropped off"\
" DDC entirely. It cannot be woken over DDC and needs a power cycle at the"\
" monitor: its D6 off code is not one this panel can return from" >&2
    _rc=1
    _still="$_still$_was
"
  done < "$DARK_RECORD"
  # THE RECORD OUTLIVES A FAILED ASCENT, and only a still-missing bus stays in
  # it. Clearing it here regardless would give the operator exactly ONE warning
  # and then silence, while the panel stayed dark -- a thing that cannot report
  # reporting clean, which is the failure mode this hook is fixing. A bus that
  # came back drops out, so a recovered monitor stops being mentioned.
  if [ "$_verify" != 1 ]; then
    if [ -n "$_still" ]; then printf '%s' "$_still" > "$DARK_RECORD"
    else rm -f "$DARK_RECORD" 2>/dev/null || true; fi
  fi
fi
if [ "$_intent" = dark ] && [ "$_verify" != 1 ]; then
  mkdir -p "$(dirname "$DARK_RECORD")" 2>/dev/null || true
  : > "$DARK_RECORD"
fi

for _bus in $_map; do
  # Resolved per bus, by the same function on both tiers, so what verify
  # expects is by construction what act wrote.
  if [ "$_intent" = lit ]; then
    _d6=01
  else
    _d6=$(_dark_value "$_bus")
    if [ -z "$_d6" ]; then
      echo "ddc-monitor: bus $_bus left on: $(_no_dark_reason "$_bus")" >&2
      continue
    fi
  fi
  if [ "$_verify" = 1 ]; then
    # 05 IS WRITE-ONLY BY SPEC, so it cannot be read back. Reporting drift
    # because a value is unreadable would fail every verify on a monitor that
    # only offers 05, which is crying wolf about a panel doing as it was told.
    if [ "$_d6" = 05 ]; then
      echo "ddc-monitor: bus $_bus uses write-only D6=05; not readable" >&2
      continue
    fi
    # sl=0xNN is the current power mode; 01 on, 02 standby.
    _got=$(ddcutil --bus "$_bus" getvcp d6 2>/dev/null \
      | sed -n 's/.*sl=0x0\([0-9]\).*/0\1/p')
    if [ -z "$_got" ]; then
      # SILENCE MEANS DIFFERENT THINGS AT THE TWO ENDS OF THE LADDER, and
      # treating them alike is what hid a dark monitor for an evening.
      #
      # At a DARK rung a monitor that will not answer is expected: several power
      # states take the scaler down with the panel, so silence IS compliance.
      # Failing there would cry wolf on a display doing as it was told.
      #
      # At a LIT rung it is the opposite. We just commanded this monitor ON and
      # it will not speak, which is exactly the shape of a panel that is dark
      # with no way back -- the failure this whole suite exists to catch.
      if [ "$_intent" = lit ]; then
        echo "ddc-monitor: bus $_bus was commanded ON and does not answer;"\
" it is unreachable over DDC and likely still dark" >&2
        _rc=1
      else
        echo "ddc-monitor: bus $_bus silent at a dark rung (expected)" >&2
      fi
    elif [ "$_got" != "$_d6" ]; then
      echo "ddc-monitor: bus $_bus is d6=$_got, expected $_d6" >&2
      _rc=1
    fi
  elif ! ddcutil --bus "$_bus" --noverify setvcp d6 "$_d6" >/dev/null 2>&1; then
    echo "ddc-monitor: bus $_bus did not answer setvcp d6=$_d6" >&2
    _rc=1
  elif [ "$_intent" = dark ]; then
    # Written only after the command was accepted, so the record holds what we
    # actually put to sleep rather than what we intended to.
    printf '%s\n' "$_bus" >> "$DARK_RECORD"
  fi
done

# A non-zero exit is REPORTED, not swallowed. The runner names this hook and
# carries on with the others: a monitor that will not sleep must not stop the
# keyboard backlight from going out.
exit "$_rc"
