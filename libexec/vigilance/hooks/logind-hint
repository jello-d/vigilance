#!/bin/sh
# logind-hint - REPORT hook: tell logind the session's real locked state.
#
# Shipped by vigilance because the MECHANISM is standard (logind is not one
# desktop's invention); whether it runs is the integrator's call. Wire it into
# lock.report.d and unlock.report.d.
#
# WHY IT EXISTS: on this box `LockedHint` reads `no` even while the session is
# genuinely locked, and nothing ever sets it. That is the standard interface
# LYING, and everything that asks logind "is this session locked?" gets a
# wrong answer. vigilant knows the truth because it crosses the edge, so it
# should FEED the standard interface rather than invent a private one. Playing
# nice with a stock mechanism means keeping its state honest.
#
# It is a REPORT hook, not an actuator: it changes no hardware and gates
# nothing. If it fails, the machine is still in the right state and the
# crossing still succeeds; the failure is loud in the log and deliberately
# absent from vigilant's exit status.
#
# NOTE `SetLockedHint` is advisory. It does NOT lock or unlock anything, so a
# wrong value here can never grant access; it can only mislead a bystander.
set -eu

_self=$(readlink -f "$0")
. "$(dirname "$_self")/../hooklib.sh"

edge=${1:-${VIGILANCE_EDGE:-}}
case "$edge" in
  lock)   _hint=true ;;
  unlock) _hint=false ;;
  *)      exit 0 ;;    # sleep/suspend do not change locked-ness
esac

# 78, NOT 0. "busctl is not installed here" and "I did the work" were the
# same exit code until the n/a contract; exit 0 launders a mechanism that
# was never present into a tier that reports clean.
if ! command -v busctl >/dev/null 2>&1; then
  echo "logind-hint: busctl is not installed; nothing to do here" >&2
  exit 78
fi

# WHICH session. THE SEAT IS THE DISCRIMINATOR, and it has to be checked
# properly in both halves of this, because both were wrong:
#
# 1. `loginctl list-sessions --no-legend` PRINTS `-` FOR AN EMPTY SEAT, not an
#    empty field, so the old `$4 != ""` excluded nothing and the fallback picked
#    the FIRST row for this user, which is logind's seatless `manager` session.
#    Measured live on both boxes: it picked session 2, seat `-`, every time.
# 2. XDG_SESSION_ID WAS TRUSTED BLINDLY, and in a non-interactive ssh it names
#    the ssh session (measured: Id=2095 Seat= Type=tty Remote=yes). Setting that
#    session's hint leaves the graphical one stale while reporting success.
#
# THE CONSEQUENCE WAS LIVE AND EXACTLY WHAT THIS HOOK EXISTS TO PREVENT. The
# `lock` edge comes from the compositor, which HAS XDG_SESSION_ID, so the hint
# was set true on the right session. The `unlock` edge comes from the locker
# unit's teardown, which does NOT, so it fell back to session 2 and failed:
#
#   21:43:12 cross unlock: lock -> open
#   21:43:12 logind-hint: SetLockedHint false failed for session 2
#
# LockedHint therefore went true and was never cleared, and logind read `yes`
# while the depth record, swaylock and screen-lock.service all said unlocked.
# The standard interface lying is the whole reason this hook was written.
#
# An earlier comment here claimed Type=wayland/x11 was checked too. It was not.
# The seat is the right discriminator on its own: it is what tells a real
# session from logind's bookkeeping entries. So the claim is dropped rather
# than implemented.
_seated() {   # <session-id> -> 0 if it has a real seat
  [ -n "${1:-}" ] || return 1
  _st=$(loginctl show-session "$1" -p Seat --value 2>/dev/null || true)
  [ -n "${_st:-}" ]
}

_sid=${XDG_SESSION_ID:-}
_seated "$_sid" || _sid=
if [ -z "$_sid" ]; then
  _sid=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '
    $3 == u && $4 != "" && $4 != "-" { print $1; exit }')
fi
if [ -z "$_sid" ]; then
  # 78, NOT 1. A box with no seated session for this user -- a headless server,
  # an ssh-only context -- has nothing to report against, and that is "I could
  # not look", not "I tried and failed". Exit 1 here would raise a hook-failed
  # alert on every unlock on a machine where nothing is wrong, which is the
  # cry-wolf this suite bans. It became reachable the moment the seat check
  # above started excluding the manager session it used to settle for.
  echo "logind-hint: no seated session for $(id -un); nothing to report" >&2
  exit 78
fi

# Resolve the object path via GetSession rather than escaping the id by hand:
# logind encodes "4" as "_34", and hand-rolling that escaping is a bug waiting
# for a session id that is not a single digit.
_path=$(busctl --no-pager call org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager GetSession s "$_sid" 2>/dev/null \
  | awk '{gsub(/"/, "", $2); print $2}')
if [ -z "$_path" ]; then
  echo "logind-hint: could not resolve session '$_sid'" >&2
  exit 1
fi

if busctl --no-pager call org.freedesktop.login1 "$_path" \
   org.freedesktop.login1.Session SetLockedHint b "$_hint" >/dev/null 2>&1
then
  exit 0
fi
echo "logind-hint: SetLockedHint $_hint failed for session $_sid" >&2
exit 1
