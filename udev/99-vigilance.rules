# 99-vigilance.rules - device access for vigilance's peripheral hooks.
#
# Grants the `vigilant` group write on EXACTLY the nodes vigilance drives.
#
# NOTHING HERE IS A NEW MECHANISM. Every technique is lifted from a rule that
# already ships on the box, and the standard pattern is Debian's own: see
# base-passwd's users-and-groups, which describes `audio` and `video` as "a
# group ... to give a set of users access to a device". A set of users is
# exactly the case: the desktop user AND the greeter both run these hooks.
#
#   GROUP=/MODE= on a device node      i2c-tools' 60-i2c-tools.rules
#   chgrp + chmod g+w on a sysfs attr  brightness-udev's 90-brightnessctl.rules
#   ATTRS{class}=="0x03*" narrowing     ddcutil's 60-ddcutil-i2c.rules
#
# THE ONE DEVIATION IS THE GROUP NAME, and it is the same reason three times:
# each standard group is WIDER than the capability being granted, so joining it
# to move a brightness attribute buys an unrelated privilege.
#
#   nodes                         distro group  what else that group guards
#   /sys/class/leds/*/brightness  input         /dev/input/event*, i.e. raw
#                                               READ of every keystroke
#   /sys/class/backlight/*        video         /dev/dri/card0
#   /dev/i2c-*                    i2c           EVERY bus, SMBus and SPD
#                                               included, not just displays
#
# The LED row is the decisive one: `input` guards two unrelated capabilities
# under one name (event* is crw-rw---- root:input, the brightness attrs are
# root:input g+w), so dimming a keyboard backlight would cost keystroke read.
# Measured on both boxes: the `input` group has NO members, so that escalation
# was never taken by anyone.
#
# NARROW BY NODE, NOT BY CLASS, which is what keeps the grant smaller than
# membership would be. Only the attrs the shipped hooks touch are re-grouped:
# `input3::capslock` and friends keep `input`, and the non-display i2c buses
# keep `i2c`. Writing a brightness attribute confers no ability to read events.
#
# WHY NOT THE MODERN SEAT MECHANISMS, both measured rather than reasoned about,
# because they are the answer a reader should reach for first:
#
#   uaccess ACL     seat-bound. Before a graphical login the seat is the
#                   greeter's, so the ACL reads `user:_greetd:rw-` with no entry
#                   for the desktop user. Our two SYSTEM units are
#                   User=<desktop user> with no session at all.
#   logind's
#   SetBrightness   refuses a seatless caller in as many words ("Your session
#                   has no seat, refusing"), which is those same units; and it
#                   accepts only `backlight` or `leds`, so it cannot cover DDC
#                   at any privilege level.
#
# A GROUP GRANT IS SEAT-INDEPENDENT, which is precisely what a system unit
# needs, and it is ADDITIVE: the uaccess ACL still applies for the logged-in
# case, so nothing is taken away from the ordinary desktop path.
#
# AND FOR sysfs THERE IS NO CHOICE: it cannot carry a POSIX ACL. `setfacl` on a
# sysfs attribute returns EOPNOTSUPP where the same call on a devtmpfs node
# returns EPERM, so chgrp is the only mechanism, which is why brightness-udev
# uses it too. Ordered 99 to land after the distro rules it overrides for these
# few nodes.

# The panel backlight (panel-backlight).
ACTION=="add", SUBSYSTEM=="backlight", \
  RUN+="/bin/chgrp vigilant /sys/class/backlight/%k/brightness", \
  RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"

# The keyboard backlight (kbd-backlight). Vendor-prefixed, hence the glob:
# tpacpi::, asus::, dell:: all appear in the wild.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*kbd_backlight", \
  RUN+="/bin/chgrp vigilant /sys/class/leds/%k/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"

# The mute / mic-mute indicator LEDs (mute-leds). Named exactly, not globbed:
# these two are the only LEDs on the deck that stay lit with the backlight off.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="platform::mute", \
  RUN+="/bin/chgrp vigilant /sys/class/leds/%k/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="platform::micmute", \
  RUN+="/bin/chgrp vigilant /sys/class/leds/%k/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"

# DDC/CI over I2C (ddc-monitor). The class match is ddcutil's own, kept so
# SMBus and sensor buses stay at their `i2c` default; measured on manifold,
# i2c-12 and i2c-13 are untouched while the display buses carry both this grant
# and uaccess's ACL at once. The seat argument in the header is why the group is
# here at all: a suspend from the greeter could not otherwise sleep the monitor.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{class}=="0x03*", \
  GROUP="vigilant", MODE="0660"
