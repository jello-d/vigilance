#!/bin/sh
# test/vm/run - the VM substrate for vigilance's scenarios.
#
# Runs the SAME test/scenarios that test/run runs, but against real systemd,
# real logind and a real suspend, inside a throwaway KVM guest. Nothing here
# re-implements an assertion: the scenario files are the single source of
# truth for what correct means, and this only supplies the capabilities the
# stub substrate honestly cannot (see test/scenario_lib).
#
# WHY A VM AT ALL: the bugs in this suite's history were never logic errors,
# they were WIRING errors, and every one of them survived a green stub run.
# The stub tier answers "does the logic do what we mean"; this tier answers
# "does a from-scratch install produce a working system". Only the second
# would have caught a hook whose path went stale.
#
# It also means the systemd work needs no sudo on the host: the guest is root.
#
# Prereqs: qemu-system-x86_64, /dev/kvm writable (an ACL grant is enough),
# xorriso, curl. No sudo.
# Usage: sh test/vm/run [--keep] [--flavour=<name>]
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
VM=${VIGILANCE_VM_DIR:-/var/tmp/vigilancevm}

# THE GUEST SHOULD BE THE RELEASE THE FLEET RUNS. It was pinned to `noble`
# while both boxes moved to 26.04, so every VM verdict was about an Ubuntu a
# full release behind the one in production: a fidelity gap hiding inside the
# tier that exists to close fidelity gaps, and one nothing would have reported.
#
# PINNED rather than derived from the host, because a run has to mean the same
# thing on both boxes and on a third machine later. The drift is WARNED about
# instead: asserted-versus-actual is the whole discipline here, and a substrate
# quietly diverging from its subject is exactly that.
RELEASE=${VIGILANCE_VM_RELEASE:-resolute}

# THE MACHINE'S PACKAGES, declared here rather than in the run seed, because
# they now belong to the PRESERVED image rather than to a run. Installing them
# costs 93s of a 377s run, measured, and it is the same 93s every time.
#
# X11 IS A SECOND PLATFORM, NOT A SECOND WINDOW MANAGER, which is why this set
# has no desktop in it. On Wayland, DPMS and idle time belong to the COMPOSITOR,
# so sway-dpms has to speak swaymsg; on X11 both belong to the SERVER, so those
# hooks are window-manager agnostic and a WM covers not one line of them.
#
# SO THIS IS THE SET EVERY FLAVOUR SHARES, and a desktop is a FLAVOUR rather
# than an addition here (see the block below). An earlier version of this
# comment argued against desktops on package count, which was the wrong axis:
# disk is cheap and a repavable guest saves more time than it costs. What a
# desktop actually buys is a COMPETING ACTUATOR, and that is a question about
# coexistence rather than about whether the hooks work.
PKGS='dash util-linux sway swaylock swayidle dbus-user-session wayfire git
greetd xvfb x11-xserver-utils xprintidle i3lock imagemagick
xserver-xorg-core'

# --- FLAVOURS ---------------------------------------------------------------
# A FLAVOUR IS A DESKTOP ENVIRONMENT, and it exists because the interesting
# question is no longer "do the hooks work" but "do they work beside somebody
# else's power management". xfce runs its own screensaver and DPMS policy, KDE
# has powerdevil, GNOME has gsd-power: each is a COMPETING ACTUATOR on the very
# device vigilance drives, and two things driving one device is a fault class
# this suite has already paid twelve hours of drift alerts for.
#
# EACH FLAVOUR GETS ITS OWN PRESERVED IMAGE, which is the whole point of doing
# it this way. The image is keyed on the release and the package list, so
# without this a `--flavour=xfce` run would invalidate the lean image, the next
# lean run would rebuild it, and alternating between two flavours would rebuild
# every single time. Per-flavour keys mean four environments cost four builds
# TOTAL rather than one per switch.
#
# THE BASE CLOUD IMAGE STAYS SHARED, deliberately: it is release-keyed and
# ~600MB, and nothing a flavour does can change it. Only the built image and
# the per-run artifacts are per-flavour.
#
# AN UNKNOWN NAME IS REFUSED rather than falling back to lean. A typo that
# silently gave the default would report a full pass for a flavour that was
# never installed, which is precisely the false green this suite exists to
# refuse.
FLAVOUR=${VIGILANCE_VM_FLAVOUR:-lean}
KEEP=
for _a in "$@"; do
  case $_a in
    --keep) KEEP=--keep ;;
    --flavour=*) FLAVOUR=${_a#*=} ;;
    *) echo "vm: unknown argument '$_a'" >&2
       echo "vm: usage: sh test/vm/run [--keep] [--flavour=<name>]" >&2
       exit 1 ;;
  esac
done

case $FLAVOUR in
  lean)
    # The default, and it is not a stripped-down anything: it carries both
    # platforms (Wayland via sway and wayfire, X11 via Xorg on real DRM) and
    # every hook has a substrate here. What it lacks is a desktop session, and
    # therefore a competing actuator.
    PKGS_FLAVOUR='' ;;
  xfce)
    # A REAL X11 DESKTOP, and the reason it is the first flavour is
    # xfce4-power-manager: a live rival driving the same DPMS that `x11-dpms`
    # drives. The window manager is NOT the point and xfwm4 is here only
    # because a session wants one; measured, no WM pulls a power or idle daemon,
    # and on X11 both DPMS and idle belong to the SERVER, so i3 and openbox
    # would be the lean flavour with extra packages.
    #
    # xfce4-notifyd IS LOAD-BEARING, and leaving it out is why the first attempt
    # at this concluded xfce was untestable: xfce4-power-manager died with
    # "libnotify-WARNING: Failed to connect to proxy" and an actuator that
    # cannot start cannot contend for anything. It wants a notification service,
    # so the honest price was never a WM plus a power manager, it is a SESSION.
    #
    # xfconf and xfce4-settings arrive with xfce4-session, and upower with the
    # power manager, so they are not listed: a package list that repeats what a
    # dependency already guarantees rots the moment the dependency changes.
    PKGS_FLAVOUR='xfce4-session xfwm4 xfce4-power-manager xfce4-notifyd' ;;
  *)
    echo "vm: unknown flavour '$FLAVOUR'" >&2
    echo "vm: known flavours: lean xfce" >&2
    exit 1 ;;
esac
[ -z "$PKGS_FLAVOUR" ] || PKGS="$PKGS $PKGS_FLAVOUR"

IMG=$VM/$RELEASE-server-cloudimg-amd64.img
URL=https://cloud-images.ubuntu.com/$RELEASE/current/${IMG##*/}
# PER-FLAVOUR WORKING DIR, so two flavours can be built and run without either
# silently overwriting the other's overlay, seed or console log. A collision
# there would present as a guest that behaved like the wrong environment, which
# is a diagnosis nobody would reach quickly.
VMF=$VM/$FLAVOUR
CONSOLE=$VMF/console.log

# Capabilities this substrate can honestly provide. Anything not listed here
# still skips, even in the VM.
# `compositor` is added at RUNTIME, only if sway actually comes up headless in
# the guest. It is not asserted here: a capability we claim but cannot provide
# would make a scenario silently pass against nothing, which is the exact
# failure mode this suite is built to refuse.
CAPS='systemd suspend logind'

_die() { echo "vm: $*" >&2; exit 1; }

for _c in qemu-system-x86_64 xorriso curl; do
  command -v "$_c" >/dev/null 2>&1 || _die "missing prereq: $_c"
done
[ -w /dev/kvm ] || _die "/dev/kvm not writable (an ACL grant is enough)"

mkdir -p "$VM" "$VMF"

# --- base image -------------------------------------------------------------
# Say it when the substrate and the subject have drifted apart. Not fatal: a
# developer on another release should still be able to run this, and a hard
# stop would make the tier unusable exactly when someone needs it most.
_host=$(. /etc/os-release 2>/dev/null && printf '%s' "${VERSION_CODENAME:-}")
if [ -n "$_host" ] && [ "$_host" != "$RELEASE" ]; then
  echo "vm: NOTE host runs '$_host', guest is '$RELEASE': the VM is testing"
  echo "vm:      a different release than this machine does."
fi
if [ ! -f "$IMG" ]; then
  echo "vm: fetching $RELEASE base cloud image (once)"
  curl -fSL -o "$IMG.part" "$URL" || _die "image download failed"
  mv "$IMG.part" "$IMG"
fi

# --- the repo, as a read-only ISO ------------------------------------------
# Simpler than 9p (no kernel module dependency) and it guarantees the guest
# tests the tree as SHIPPED, not a live working copy it could accidentally
# mutate.
echo "vm: packing the repo"
xorriso -as mkisofs -R -J -V VIGILANCE -quiet \
  -o "$VMF/repo.iso" "$HERE" 2>/dev/null || _die "repo.iso failed"

# THE INTEGRATOR, so the guest can be wired by the thing that actually wires a
# real box. The session tier otherwise invents a "representative" wiring, which
# is explicitly NOT tackup's, so the code that decides where every hook goes
# on a live machine was tested nowhere.
#
# OPTIONAL. Someone with this repo and not that one must still be able to run
# the VM; without it the tackup scenarios skip, visibly.
TACKUP_SRC=${VIGILANCE_VM_TACKUP:-$HOME/src/tackup}
_tackup_drive=
if [ -d "$TACKUP_SRC" ]; then
  echo "vm: packing the integrator ($TACKUP_SRC)"
  xorriso -as mkisofs -R -J -V TACKUP -quiet -m .git \
    -o "$VMF/tackup.iso" "$TACKUP_SRC" 2>/dev/null || _die "tackup.iso failed"
  _tackup_drive="-drive file=$VMF/tackup.iso,if=virtio,media=cdrom"
else
  echo "vm: no tackup checkout at $TACKUP_SRC; its scenarios will SKIP"
  rm -f "$VMF/tackup.iso"
fi

# --- cloud-init seed --------------------------------------------------------
# Tools come from `packages:`, never an apt-get inside runcmd: a script's apt
# races cloud-init's own package lock and DEADLOCKS.
#
# All output goes to a FILE and is dumped to the serial at the very end.
# Writing to /dev/ttyS0 live interleaves with boot spam and gets lost.
# NOTHING EXPLANATORY GOES INSIDE THE HEREDOC BELOW. It is unquoted, so the
# HOST shell expands it, and a backtick in a YAML *comment* there ran
# `systemctl --user` on the developer's box and spliced its unit list into the
# guest's cloud-config, which then failed to parse and the guest never
# reported. Same family as awk -v expanding escapes: text crossing a layer
# that interprets it. Prose lives out here, where it is inert.
#
# dbus-user-session is in `packages` for a load-bearing reason: without a
# per-user bus `systemctl --user` answers "Failed to connect to bus: No medium
# found", and everything vigilance builds on --user units (the locker's
# transient unit, the idle supervisor, the logind trigger) is testable NOWHERE
# except a live desktop. That gap is why the lock provider's race branch had to
# be exercised through a file fixture, and why a fixture that could not express
# ACTIVATING shipped a bug to a real box.
_seed=$VMF/seed
rm -rf "$_seed"; mkdir -p "$_seed"
cat > "$_seed/meta-data" <<EOF
instance-id: vigilance-$$
local-hostname: vigilance-vm
EOF
cat > "$_seed/user-data" <<'EOF'
#cloud-config
runcmd:
  - |
    {
      # cloud-init's runcmd has NO HOME. The tools derive their own, but this
      # script must not assume one either: with HOME unset, a PATH built from
      # "$HOME/.local/bin" silently becomes "/.local/bin" and every tool then
      # reads as not-installed. That is a harness bug that looks exactly like
      # a product failure, so set it explicitly and once.
      HOME=/root; export HOME
      mkdir -p /mnt/repo /mnt/tackup /root/vigilance
      mount -o ro /dev/disk/by-label/VIGILANCE /mnt/repo
      cp -a /mnt/repo/. /root/vigilance/
      cd /root/vigilance
      chmod +x bin/* setup.sh test/run libexec/vigilance/hooks/* || true
      # THE COPY IS A GIT REPO THAT GIT REFUSES TO OPEN. The ISO carries `.git`,
      # and `cp -a` preserves the developer's uid on every file, so a guest
      # running as root meets git's dubious-ownership guard. Measured rather
      # than reasoned about:
      #
      #   fatal: detected dubious ownership in repository at '/root/vigilance'
      #
      # test/conventions.t reads the file list through `git rev-parse`, with
      # stderr discarded, so it reported "not a git repo" -- true about what it
      # could establish, and silent about why. Without this the whole-tree
      # conventions check fails in the guest and passes on the desk, which is a
      # verdict about the substrate rather than about the tree.
      git config --global --add safe.directory /root/vigilance

      echo "=== from-scratch install ==="
      sh setup.sh install
      PATH="$HOME/.local/bin:$PATH"; export PATH
      # UNITS TOO, not just the tools. `install` places binaries and hooks;
      # `service` renders the --user Session.Lock listener, and without it a
      # lid close reaches logind and stops there. A real box has both, so a
      # guest with only the first cannot host the trigger's scenarios.
      sh setup.sh service || echo "SETUP_SERVICE_RC=$?"
      sh setup.sh check || echo "SETUP_CHECK_DRIFT=$?"

      echo "=== logind lid policy: LOCK, never suspend ==="
      # THE HARNESS WAS TELLING THE GUEST TO SUSPEND ITSELF. The uinput probe
      # below closes a real SW_LID switch, and Ubuntu defaults to
      # HandleLidSwitch=suspend, so logind suspended the machine that was
      # running cloud-final, which presents as "guest never reported" with no
      # output at all, because the guest script buffers to a file and cats it at
      # the end. Seen three times, always intermittent, because whether logind
      # acts depends on which inhibitors happen to be held at that moment.
      #
      # It is very likely the same unexplained hang the fault-lid scenario hit,
      # which was set aside as "cause unknown and NOT attributable to
      # vigilance". It was attributable, to the harness.
      #
      # `lock` RATHER THAN `ignore`, because Session.Lock on lid close is the
      # exact behaviour under test: it is what manifold does
      # (HandleLidSwitchExternalPower=lock) and what produced the bug where
      # answering it from the sleep rung LIT the panel. Ignoring the lid would
      # remove the event along with the hazard.
      mkdir -p /etc/systemd/logind.conf.d
      printf '[Login]\n' > /etc/systemd/logind.conf.d/90-vigilance-test.conf
      for _k in HandleLidSwitch HandleLidSwitchExternalPower \
                HandleLidSwitchDocked; do
        printf '%s=lock\n' "$_k" \
          >> /etc/systemd/logind.conf.d/90-vigilance-test.conf
      done
      systemctl reload systemd-logind >/dev/null 2>&1 \
        || systemctl restart systemd-logind >/dev/null 2>&1 || true
      echo "  lid -> lock: $(loginctl show-seat seat0 2>/dev/null \
        | grep -c . || echo 0) seat props readable"

      echo "=== user systemd instance (so --user units are REAL here) ==="
      # The guest is root, and root gets no user manager by default because
      # nothing logs it in. Lingering starts one anyway, which is exactly the
      # shape a desktop session has.
      loginctl enable-linger root >/dev/null 2>&1 || true
      systemctl start user@0.service >/dev/null 2>&1 || true
      export XDG_RUNTIME_DIR=/run/user/0
      export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
      # CLAIMED ONLY IF IT WORKS, like the compositor below. A capability we
      # assert but cannot provide makes a scenario pass against nothing, which
      # is the precise failure this suite exists to refuse.
      _userbus=
      if systemctl --user show -p Version >/dev/null 2>&1; then
        echo "  user manager up: $(systemctl --user show -p Version --value)"
        _userbus=userbus
      else
        echo "  NO user manager; --user scenarios will SKIP"
        systemctl --user show -p Version 2>&1 | head -2 | sed 's/^/    /'
      fi

      echo "=== session reality (what the probe must cope with) ==="
      loginctl list-sessions || true
      systemctl --user is-active graphical-session.target || true

      echo "=== compositor probe (for the lock-span scenario) ==="
      # A real swaylock is the only way to answer whether systemd's
      # GuessMainPID latches ITS daemonized child, and whether ExecStopPost
      # fires when it CRASHES. A synthetic forker cannot answer either.
      export XDG_RUNTIME_DIR=/run/user/0
      mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"
      mkdir -p /root/.config/sway
      printf 'exec true\n' > /root/.config/sway/config
      export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1
      export XDG_SESSION_TYPE=wayland
      ( sway >/root/sway.log 2>&1 & ) 
      _sock() {
        ls "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null \
          | grep -v '\.lock$' | head -1
      }
      _n=0
      while [ "$_n" -lt 20 ]; do
        if [ -n "$(_sock)" ]; then break; fi
        sleep 0.5; _n=$((_n + 1))
      done
      if [ -n "$(_sock)" ]; then
        export WAYLAND_DISPLAY=$(basename "$(_sock)")
        echo "  sway up, WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
        # SWAYSOCK TOO, which sway sets for its own children and nothing here
        # did. `swaymsg` needs it: the socket was sitting in the runtime dir the
        # whole time and swaymsg errored without being told where, so sway-dpms
        # declined 78 in a guest with a perfectly reachable sway. That is the
        # greeter's ONLY darkening mechanism, so the one hook the greeter path
        # depends on was untestable here for want of an environment variable.
        #
        # A real greeter inherits it, because greetd's session starts sway and
        # its swayidle is sway's child. Worth knowing that the hook DEPENDS on
        # that inheritance: driven from anywhere without it, sway-dpms declines
        # even when sway is running and answering.
        _ss=$(ls "${XDG_RUNTIME_DIR:-/run/user/0}"/sway-ipc.*.sock 2>/dev/null \
              | head -1)
        if [ -n "${_ss:-}" ]; then
          export SWAYSOCK=$_ss
          echo "  SWAYSOCK=$SWAYSOCK"
        else
          echo "  no sway-ipc socket found; sway-dpms will decline"
        fi
        # WHAT A REAL SESSION DOES, and the session tier cannot work without
        # it: the lock provider starts swaylock as a --user unit, and a unit
        # inherits the MANAGER's environment, not its caller's. On a desktop
        # the compositor's startup imports these; here nothing had, so the
        # provider's first real run in this VM failed with "could not start
        # screen-lock.service" and no clue why.
        systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR \
          SWAYSOCK >/dev/null 2>&1 || true
        _compositor=compositor
      else
        echo "  sway did NOT come up headless; compositor scenarios will SKIP"
        echo "  --- sway.log ---"; tail -15 /root/sway.log 2>/dev/null
        _compositor=
      fi
      # THE SESSION TIER'S SAFETY INTERLOCK. It drives real daemons and locks
      # a real screen, so capabilities alone must not be enough to aim it: it
      # refuses to run without this, and only a throwaway guest sets it.
      VIGILANCE_VM=1; export VIGILANCE_VM

      echo "=== a real user session (wayfire needs one) ==="
      # WAYFIRE REFUSES TO RUN AS ROOT ("Unable to drop root"), and the guest
      # was root-only. So the compositor production actually runs is only
      # testable here behind a real unprivileged user, which is the honest
      # shape for a session test anyway, and what provisioning properly would
      # have given us regardless.
      useradd -m -s /bin/bash vig 2>/dev/null || true
      printf 'vig ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/vig
      chmod 440 /etc/sudoers.d/vig
      # AFTER useradd, and OWNED BY vig. Creating these earlier made root
      # the owner of /home/vig, so `useradd -m` found the home already
      # there and left it that way, and every user-mode install then
      # died on `mkdir -p /home/vig/.local/bin: Permission denied`, which
      # reads as a packaging fault and is an ordering one.
      chown vig:vig /home/vig
      install -d -o vig -g vig /home/vig/tackup
      loginctl enable-linger vig >/dev/null 2>&1 || true
      _vuid=$(id -u vig)
      _vrun=/run/user/$_vuid
      install -d -o vig -g vig -m 700 "$_vrun"
      install -d -o vig -g vig /home/vig/.config
      printf '[core]\nplugins = \n' > /home/vig/.config/wayfire.ini
      chown vig:vig /home/vig/.config/wayfire.ini
      # `-H env`, not a bare `sudo -u`. Without -H the CALLER's HOME survives,
      # so a user-mode install run as vig tried to write into /root and died
      # "mkdir: Permission denied", a harness fault wearing the costume of a
      # packaging one. `env` because sudo rejects VAR=val assignments unless
      # sudoers grants it.
      _asvig="sudo -u vig -H env XDG_RUNTIME_DIR=$_vrun"
      _asvig="$_asvig DBUS_SESSION_BUS_ADDRESS=unix:path=$_vrun/bus"
      _asvig="$_asvig HOME=/home/vig"

      # THROUGH greetd, NOT `su`. A user is not a SESSION: an account driven
      # by sudo has none of its own, and logind then answers
      # "SetLockedHint true failed for session 2", which took the whole lock
      # edge with it and could not be told apart from a compositor fault.
      # greetd's initial_session IS autologin, which is what production uses,
      # so the guest gets a real seat, a real session and a real session type
      # rather than three approximations of them.
      # NO HEREDOC INSIDE THIS BLOCK. cloud-init's runcmd is a YAML literal
      # scalar, so every line must stay indented, and a heredoc delimiter
      # cannot be. A `[terminal]` at column 0 ended the block, the runcmd was
      # truncated, and the guest never reported. printf keeps everything
      # indented and needs no delimiter at all.
      _gc=/etc/greetd/config.toml
      printf '[terminal]\nvt = 1\n\n' > "$_gc"
      # BOTH SLOTS RUN THE SESSION, because this guest wants AUTOLOGIN and has
      # no use for a greeter at all. Three things were wrong here at once:
      #
      #   `sleep infinity` is not a valid greetd greeter. greetd requires one to
      #   speak its IPC and create a session, so greetd logged "greeter exited
      #   without creating a session" and restart-looped. `agreety` is no better
      #   on a serial-only guest: there is nothing to interact with, so it exits
      #   too.
      #
      #   `initial_session` NEVER FIRED. greetd is enabled by its package and so
      #   is already running from the preserved image by the time cloud-final
      #   writes this config; the image's boot consumed the initial-session
      #   opportunity, and a later restart is not "initial" any more.
      #
      # So default_session gets the SAME command. Whichever slot greetd chooses,
      # it launches the real session, which is what autologin means here.
      printf '[default_session]\n' >> "$_gc"
      printf 'command = "/usr/local/bin/vig-session"\n' >> "$_gc"
      # THE GREETER USER MUST EXIST or greetd refuses to start at all:
      # "configured default session user 'greeter' not found", then a restart
      # loop into start-limit-hit. The package does not create one, and this
      # path is never reached anyway (initial_session autologins), so it points
      # at an account we know is there rather than one a package might make.
      printf 'user = "vig"\n\n' >> "$_gc"
      printf '[initial_session]\n' >> "$_gc"
      printf 'command = "/usr/local/bin/vig-session"\n' >> "$_gc"
      printf 'user = "vig"\n' >> "$_gc"
      _vs=/usr/local/bin/vig-session
      printf '#!/bin/sh\n' > "$_vs"
      printf 'export WLR_BACKENDS=headless WLR_RENDERER=pixman\n' >> "$_vs"
      printf 'export WLR_LIBINPUT_NO_DEVICES=1 XDG_SESSION_TYPE=wayland\n' \
        >> "$_vs"
      printf 'exec wayfire -c /home/vig/.config/wayfire.ini\n' >> "$_vs"
      chmod +x /usr/local/bin/vig-session
      # RESTART, NOT `enable --now`. greetd is installed from the package list
      # and therefore ENABLED IN THE PRESERVED IMAGE, so it is already running
      # by the time cloud-final writes this config, and `--now` does nothing
      # to a unit that is already active. The freshly written config.toml was
      # never read on any boot after the image was built, so greetd kept serving
      # the GREETER from whatever the image left behind and initial_session
      # NEVER RAN.
      #
      # Everything downstream failed quietly from that: no Class=user session,
      # so "wayfire did NOT come up" (it was never launched, and the poll below
      # waited on a socket nothing was going to create), so the wayfire
      # scenarios skipped, and so a real lid close had no lockable session to
      # reach. Measured: launched by hand as vig, wayfire comes up in UNDER A
      # SECOND with only benign Xwayland noise.
      #
      # THE PRESERVED IMAGE'S OWN STATE IS THE TRAP, which is the staleness this
      # split is supposed to prevent for vigilance's code and did not for a
      # package's unit. Anything the per-run phase configures must be RESTARTED,
      # not merely enabled.
      # AND IT IS A STOP, A SETTLE, AND A START, not a restart. MEASURED across
      # consecutive runs of an identical tree, which is how the problem showed
      # at all: one run claimed the wayfire capability and the next did not, so
      # a scenario requiring it SKIPPED at random. An intermittently absent
      # capability is the same defect as a falsely claimed one, because both
      # make a line of output mean something it does not.
      #
      # THE CAUSE IS THE VT, and the evidence is what changed the order here.
      # greetd is configured for `vt = 1` and is ALREADY RUNNING the package's
      # own default config out of the preserved image, so a restart takes VT1
      # from a greeter killed a moment earlier. Measured:
      #
      #   restart              2 runs: one came up UNSEATED, one not at all
      #   stop, settle, start  3 runs: every one up, every one WITH seat0
      #
      # So the stop is not merely more reliable, it produces a strictly better
      # session: the seated one the lock path needs. One of those three was
      # obtained by neutering the first attempt deliberately, since a retry
      # nothing exercises is a guard nobody has tested, and the other two came
      # up on attempt 1 in half a second.
      #
      # ONE RETRY REMAINS, for genuine slowness rather than for the VT, and the
      # attempt number is REPORTED so a future intermittency is visible in the
      # log instead of inferred from a capability that quietly went missing.
      systemctl reset-failed greetd >/dev/null 2>&1 || true
      systemctl enable greetd >/dev/null 2>&1 || true
      _wfsock=
      _try=1
      while [ "$_try" -le 2 ]; do
        [ "$_try" = 1 ] || echo "  wayfire did not appear; attempt $_try"
        systemctl stop greetd >/dev/null 2>&1 || true
        sleep 3
        systemctl reset-failed greetd >/dev/null 2>&1 || true
        systemctl start greetd >/dev/null 2>&1 || true
        _n=0
        while [ "$_n" -lt 40 ]; do
          if ls "$_vrun"/wayland-* 2>/dev/null | grep -qv '\.lock$'
          then break; fi
          sleep 0.5; sleep 0; _n=$((_n + 1))
        done
        _wfsock=$(ls "$_vrun"/wayland-* 2>/dev/null \
          | grep -v '\.lock$' | head -1)
        if [ -n "$_wfsock" ]; then
          echo "  wayfire came up on attempt $_try after ${_n} polls (0.5s ea)"
          break
        fi
        _try=$((_try + 1))
      done
      _wayfire=
      if [ -n "$_wfsock" ]; then
        echo "  wayfire up as vig: $(basename $_wfsock)"
        # THE SESSION WITH A SEAT, not merely one owned by vig. logind gives
        # the user a "manager" session too, and picking the first match
        # reported that one, so the field that matters is the seat, which is
        # what makes a session a real one rather than a bookkeeping entry.
        _vsess=
        for _s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
          _su=$(loginctl show-session "$_s" -p Name --value 2>/dev/null)
          _st=$(loginctl show-session "$_s" -p Seat --value 2>/dev/null)
          if [ "$_su" = vig ] && [ -n "$_st" ]; then _vsess=$_s; break; fi
        done
        if [ -n "$_vsess" ]; then
          _sty=$(loginctl show-session "$_vsess" -p Type --value)
          _sse=$(loginctl show-session "$_vsess" -p Seat --value)
          echo "  vig session $_vsess: type=$_sty seat=$_sse"
          # THE ACID TEST. This is what failed under a sudo-driven account
          # ("SetLockedHint true failed for session 2") and took the lock edge
          # with it. If it works here, the guest can host the lock path.
          if $_asvig loginctl lock-session "$_vsess" >/dev/null 2>&1; then
            echo "  lock-session: accepted"
          else
            echo "  lock-session: REFUSED, the lock path cannot work here"
          fi
          _lh=$(loginctl show-session "$_vsess" -p LockedHint --value)
          echo "  LockedHint after lock-session: $_lh"
          $_asvig loginctl unlock-session "$_vsess" >/dev/null 2>&1 || true
        else
          echo "  NO seated logind session for vig: the lock path needs one"
        fi
        _wayfire=wayfire
        # The session's own job, and the lock provider cannot work without it:
        # a --user unit inherits the MANAGER's environment, not its caller's.
        $_asvig systemctl --user import-environment \
          WAYLAND_DISPLAY XDG_RUNTIME_DIR >/dev/null 2>&1 || true
      else
        echo "  wayfire did NOT come up; wayfire scenarios will SKIP"
        echo "  greetd: $(systemctl is-active greetd) / $(systemctl is-enabled \
          greetd 2>&1)"
        journalctl -u greetd --no-pager -n 12 2>/dev/null | sed 's/^/    /'
        echo "  --- vts / seats ---"
        ls /dev/tty1 2>&1 | sed 's/^/    /'
        loginctl list-seats --no-legend 2>&1 | sed 's/^/    /'
        tail -12 /home/vig/wayfire.log 2>/dev/null | sed 's/^/    /'
      fi

      echo "=== the INTEGRATOR wires it (tackup lock) ==="
      # THE REAL WIRING, not a representative one. modules/lock is the code
      # that decides where every hook goes on a live box, and it was tested
      # nowhere: the session tier invents its own wiring and says so.
      _tackup=
      if mount -o ro /dev/disk/by-label/TACKUP /mnt/tackup 2>/dev/null; then
        cp -a /mnt/tackup/. /home/vig/tackup/
        chown -R vig:vig /home/vig/tackup
        # THE PIN POINTS AT THIS REPO, not GitHub. A clone takes COMMITS, so
        # the guest tests what is committed HERE without anything being pushed
        #, which is the whole point, and it is why the repo ISO carries .git.
        # The guest's COPY of the integrator is edited, never the real one.
        sed -i 's#^pkg vigilance .*#pkg vigilance file:///mnt/repo head#' \
          /home/vig/tackup/install/deps/lock
        echo "  pin: $(cat /home/vig/tackup/install/deps/lock | tail -1)"
        # SATISFY THE ONE DEPENDENCY THE WAY THE PKG INSTALL ENDS UP. `tackup
        # install` harvests EVERY active domain's deps: docker, fonts, the
        # lot, which is not what this guest is for. modules/lock's dep is a
        # single vigilance pkg whose install phase finishes by placing the tree
        # under ~/.local, and vigilance's own setup.sh does exactly that in
        # user mode. STATED rather than hidden: the pkg CLONE mechanics are not
        # what this exercises. modules/lock's WIRING is, and that is the code
        # that was tested nowhere.
        # FROM A WRITABLE COPY. /mnt/repo is a read-only ISO mount, and an
        # install that creates anything relative to its own tree died there
        # with a bare "mkdir: Permission denied", which reads like a
        # packaging fault and is a harness one. A real pkg clone is writable.
        # WHAT tackup's OWN pkg install DOES, in the same two steps:
        # clone the pin, then run the package's installer from the CLONE.
        # modules/lock reads the units out of that clone (pkg_dir), so a
        # copy somewhere else is not a substitute; it said so itself:
        # "vigilance clone missing; the pkg install must run first".
        _pkgd=/home/vig/.cache/tackup/pkgs/vigilance
        _clone="git clone -q file:///mnt/repo $_pkgd"
        $_asvig sh -c "$_clone" >> /home/vig/pkg-install.log 2>&1 || true
        _dep="cd $_pkgd && sh setup.sh install"
        if ! $_asvig sh -c "$_dep" > /home/vig/pkg-install.log 2>&1; then
          echo "  dep install FAILED:"
          tail -8 /home/vig/pkg-install.log | sed 's/^/    /'
        fi
        _lrc=0
        _lk="cd /home/vig/tackup && ./tackup lock"
        $_asvig sh -c "$_lk" > /home/vig/tackup-lock.log 2>&1 || _lrc=$?
        echo "  tackup lock rc=$_lrc"
        # The tail, not the whole log: this reports how far the integrator
        # got, and the last lines are where it stopped.
        tail -6 /home/vig/tackup-lock.log | sed 's/^/    /'
        [ "$_lrc" = 0 ] && _tackup=tackup
      else
        echo "  no TACKUP disk; integrator scenarios will SKIP"
      fi

      echo "=== uinput (synthetic lid + key events) ==="
      # A LID IS A STATE, NOT A SIGNAL, and every test of the lid path so far
      # has approximated it with `loginctl lock-session`, which is the signal
      # rather than the cause, while the whole bug was about what a lid does.
      # Whether logind picks up a SYNTHETIC switch is the open question: it
      # finds lid devices through udev tags, and a uinput device has to be
      # tagged like any other before logind will care.
      modprobe uinput >/dev/null 2>&1 || true
      _uinput=
      if [ -e /dev/uinput ]; then
        python3 /root/vigilance/test/uinject lid close 6 >/dev/null 2>&1 &
        sleep 4
        _lidsw=$(grep -c "uinject-lid" /proc/bus/input/devices 2>/dev/null \
          || echo 0)
        echo "  device seen by the kernel: $_lidsw"
        # THE DECISIVE EVIDENCE is logind's OWN journal line, the same
        # "Lid closed." that appeared on manifold when the real bug fired.
        # Anything less is inference: the kernel seeing a switch says nothing
        # about whether logind found it through udev and acted on it.
        _lidlog=$(journalctl -u systemd-logind --no-pager --since "-30s" \
          2>/dev/null | grep -c "Lid closed" || echo 0)
        echo "  logind said 'Lid closed': $_lidlog"
        wait 2>/dev/null || true
        python3 /root/vigilance/test/uinject key 5 2>&1 | sed 's/^/  /'
        _uinput=uinput
      else
        echo "  NO /dev/uinput; lid and input faults will SKIP"
      fi

      # --- X11: a second platform, for the assumptions it reads back ------
      # THE HOOKS TALK TO THE SERVER, not to a window manager, so a bare X
      # server is the whole substrate they need: xset owns DPMS and the
      # XScreenSaver extension owns idle time.
      #
      # IT REPORTS WHAT IT FINDS RATHER THAN ASSUMING. Whether a headless
      # server implements DPMS for real is exactly the kind of thing this
      # project gets wrong by reasoning, so the probe prints the state
      # transitions and the scenarios assert against what it saw.
      echo "=== X11 (a second platform) ==="
      _x11=
      if command -v Xvfb >/dev/null 2>&1 && command -v xset >/dev/null 2>&1
      then
        Xvfb :99 -screen 0 1024x768x24 +extension DPMS \
          >/tmp/xvfb.log 2>&1 &
        _n=0
        while [ "$_n" -lt 20 ]; do
          if DISPLAY=:99 xset q >/dev/null 2>&1; then break; fi
          sleep 0.5; sleep 0; _n=$((_n + 1))
        done
        if DISPLAY=:99 xset q >/dev/null 2>&1; then
          echo "  X server up on :99"
          echo "  DPMS is $(DISPLAY=:99 xset q | sed -n 's/.*DPMS is //p')"
          DISPLAY=:99 xset +dpms >/dev/null 2>&1 || true
          DISPLAY=:99 xset dpms force off >/dev/null 2>&1 || true
          _xm=$(DISPLAY=:99 xset q | sed -n 's/.*Monitor is *//p' | head -1)
          echo "  after force off: ${_xm:-<no monitor line>}"
          DISPLAY=:99 xset dpms force on >/dev/null 2>&1 || true
          _xm=$(DISPLAY=:99 xset q | sed -n 's/.*Monitor is *//p' | head -1)
          echo "  after force on:  ${_xm:-<no monitor line>}"
          if command -v xprintidle >/dev/null 2>&1; then
            echo "  xprintidle: $(DISPLAY=:99 xprintidle 2>&1 | head -1)ms"
          else
            echo "  xprintidle: ABSENT"
          fi
          if command -v import >/dev/null 2>&1; then
            if DISPLAY=:99 import -silent -window root -resize 5% \
                 png:/tmp/x11-grab.png >/dev/null 2>&1; then
              echo "  import: $(wc -c < /tmp/x11-grab.png) bytes captured"
            else
              echo "  import: FAILED to capture the root window"
            fi
          fi
          _x11=x11
        else
          echo "  no X server came up; X11 scenarios will SKIP"
          tail -3 /tmp/xvfb.log 2>/dev/null | sed 's/^/    /' || true
        fi
      else
        echo "  no Xvfb or xset; X11 scenarios will SKIP"
      fi

      # A REAL X SERVER WITH A REAL DPMS, on :98, beside the Xvfb on :99.
      #
      # WHY BOTH. Xvfb is compiled WITHOUT the DPMS extension (it answers
      # "Server does not have the DPMS Extension" even when asked for
      # +extension DPMS, and Xephyr is the same), so on :99 the only thing
      # x11-dpms can do is decline 78. That is a real and valuable case, and
      # session-x11.t asserts it, so :99 stays exactly as it was. What :99
      # cannot do is exercise the hook's ACT and VERIFY paths at all: until now
      # they had never run against a real DPMS anywhere, on any machine in this
      # fleet or in this guest.
      #
      # THE DRIVER REGISTERS DPMS, NOT THE SERVER, which is what the first
      # attempt here got wrong. With `Driver "dummy"` the log said
      #
      #   (WW) DUMMY(0): Option "DPMS" is not used
      #   (II) Initializing extension DPMS
      #
      # both at once: the EXTENSION initialises and then no screen is
      # DPMS-capable, so `xset q` prints no DPMS block and there is nothing to
      # drive. `Option "DPMS" "true"` does not help; the driver simply has no
      # such hook. So this uses the guest's REAL DRM device (qemu gives it
      # /dev/dri/card0) through `modesetting`, where DPMS goes to DRM. NO
      # HEREDOC, because this block is a YAML literal scalar first and shell
      # second: a delimiter at column 0 would end the runcmd and truncate
      # everything after it, which is how this file lost its tail once already.
      _x11dpms=
      if command -v Xorg >/dev/null 2>&1 && command -v xset >/dev/null 2>&1
      then
        {
          printf 'Section "Device"\n'
          printf '  Identifier "kms"\n  Driver "modesetting"\n'
          printf '  Option "kmsdev" "/dev/dri/card0"\nEndSection\n'
          printf 'Section "Monitor"\n  Identifier "mon"\n'
          printf '  HorizSync 5.0 - 1000.0\n  VertRefresh 5.0 - 200.0\n'
          printf '  Option "DPMS" "true"\n'
          printf 'EndSection\n'
          printf 'Section "Screen"\n  Identifier "scr"\n'
          printf '  Device "kms"\n  Monitor "mon"\n  DefaultDepth 24\n'
          printf '  SubSection "Display"\n    Depth 24\n'
          printf '    Modes "1024x768"\n  EndSubSection\nEndSection\n'
          printf 'Section "ServerLayout"\n  Identifier "layout"\n'
          printf '  Screen "scr"\nEndSection\n'
        } > /etc/X11/xorg-kms.conf
        Xorg :98 -config /etc/X11/xorg-kms.conf -logfile /tmp/xorg98.log \
          -noreset -nolisten tcp >/tmp/xorg98.out 2>&1 &
        _n=0
        while [ "$_n" -lt 30 ]; do
          if DISPLAY=:98 xset q >/dev/null 2>&1; then break; fi
          sleep 0.5; sleep 0; _n=$((_n + 1))
        done
        if DISPLAY=:98 xset q >/dev/null 2>&1; then
          echo "  Xorg (modesetting) up on :98"
          _xd=$(DISPLAY=:98 xset q | sed -n 's/.*DPMS is //p' | head -1)
          echo "  :98 DPMS is ${_xd:-<no DPMS block>}"
          echo "  :98 xorg log on DPMS: $(grep -ci dpms /tmp/xorg98.log \
            2>/dev/null || echo 0) line(s)"
          grep -i dpms /tmp/xorg98.log 2>/dev/null | head -3 \
            | sed 's/^/    /' || true
          echo "  drm devices in the guest: $(ls /dev/dri 2>/dev/null \
            | tr "\n" " ")"
          DISPLAY=:98 xset +dpms >/dev/null 2>&1 || true
          DISPLAY=:98 xset dpms force off >/dev/null 2>&1 || true
          _off=$(DISPLAY=:98 xset q | sed -n 's/.*Monitor is *//p' | head -1)
          DISPLAY=:98 xset dpms force on >/dev/null 2>&1 || true
          _on=$(DISPLAY=:98 xset q | sed -n 's/.*Monitor is *//p' | head -1)
          echo "  :98 force off -> ${_off:-<none>}, on -> ${_on:-<none>}"
          # THE CAPABILITY IS THE ROUND TRIP, not the extension's presence. A
          # server that reports DPMS and then ignores `force off` would let a
          # scenario assert against a fixture again, which is the whole thing
          # this tier exists to stop.
          if [ "${_on:-}" = On ] && [ -n "${_off:-}" ] && [ "${_off:-}" != On ]
          then
            _x11dpms=x11dpms
          else
            echo "  :98 DPMS does not round-trip; x11dpms scenarios will SKIP"
          fi
        else
          echo "  Xorg did NOT come up; x11dpms scenarios will SKIP"
          tail -5 /tmp/xorg98.log 2>/dev/null | sed 's/^/    /' || true
          tail -3 /tmp/xorg98.out 2>/dev/null | sed 's/^/    /' || true
        fi
      else
        echo "  no Xorg; x11dpms scenarios will SKIP"
      fi

      # A REAL DESKTOP ENVIRONMENT, whose POWER MANAGER is the whole subject.
      #
      # THE GATE IS THE TOOL, not the flavour name: `xfce4-session` exists only
      # in the xfce image, so the lean flavour walks past this with no flavour
      # string anywhere in the guest's logic. Same reason `sway-dpms` is safe to
      # wire in machine scope.
      #
      # AFTER THE :98 ROUND TRIP ON PURPOSE. The x11dpms capability is decided
      # by forcing DPMS off and on, and a power manager watching that server
      # could answer for it, so the rival must not exist until the capability is
      # already settled.
      #
      # AND IT NEEDS :98 TO HAVE WORKED. On a server with no DPMS a power
      # manager is a real actuator with NOTHING TO CONTEND FOR, so every
      # assertion about coexistence would pass vacuously, which is worse than an
      # empty cell. That is the measurement that ruled an X11 rival out before
      # :98 existed, and it still decides the answer here.
      _xfce=
      if command -v xfce4-session >/dev/null 2>&1; then
        if [ -z "${_x11dpms:-}" ]; then
          echo "  xfce is installed but :98 has no working DPMS, so its power"
          echo "  manager has no device to contend for; NOT claiming xfce"
        else
          DISPLAY=:98 xfce4-session >/tmp/xfce.log 2>&1 &
          # `pgrep -f`, NOT `-x`: comm is truncated to 15 characters by the
          # kernel, so the 19-character "xfce4-power-manager" can never match an
          # exact comm and `-x` would report the rival absent while it ran.
          _n=0
          while [ "$_n" -lt 40 ]; do
            if pgrep -f xfce4-power-manager >/dev/null 2>&1; then break; fi
            sleep 0.5; sleep 0; _n=$((_n + 1))
          done
          if pgrep -f xfce4-power-manager >/dev/null 2>&1; then
            echo "  xfce4-session up; power manager alive after $_n polls"
            # QUIETED BY DEFAULT. Several scenarios already drive :98, and a
            # rival blanking it on its own timer would make them flaky for a
            # reason that is not theirs. session-xfce.t turns this back ON for
            # its own duration and restores it in its trap, which is the pattern
            # fault-actuator.t already uses for the machine-scope symlinks.
            xfconf-query -c xfce4-power-manager \
              -p /xfce4-power-manager/dpms-enabled -n -t bool -s false \
              >/dev/null 2>&1 || true
            echo "  xfpm dpms-enabled reads: $(xfconf-query \
              -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled \
              2>&1 | head -1)"
            # DUMPED, NEVER ASSUMED. A scenario has to name xfpm's properties to
            # enable the rivalry deliberately, and those names are this
            # package's contract rather than ours. Reading them out of the live
            # daemon is the only way to write that scenario against what is
            # actually there instead of what I remember.
            echo "  xfpm properties (live):"
            xfconf-query -c xfce4-power-manager -lv 2>&1 | head -24 \
              | sed 's/^/    /'
            echo "  xfce processes: $(pgrep -c -f 'xfce4-' 2>/dev/null \
              || echo 0)"
            # LEFT LIT WHATEVER HAPPENED, because everything after this shares
            # the server and a scenario inheriting a dark :98 would fail about
            # the wrong thing.
            DISPLAY=:98 xset dpms force on >/dev/null 2>&1 || true
            _xm=$(DISPLAY=:98 xset q | sed -n 's/.*Monitor is *//p' | head -1)
            echo "  :98 monitor after xfce start: ${_xm:-<none>}"
            _xfce=xfce
          else
            echo "  xfce4-power-manager did NOT come up; xfce scenarios SKIP"
            tail -12 /tmp/xfce.log 2>/dev/null | sed 's/^/    /' || true
          fi
        fi
      fi

      # WHO HAS TAKEN THE LID, and this is printed in EVERY flavour on purpose.
      # `fault-lid` passes in the lean guest and FAILED in the xfce one, run
      # concurrently against identical trees on the same host, so the desktop is
      # doing something to that path. The suspicion is a logind INHIBITOR: a
      # desktop power manager conventionally takes `handle-lid-switch` so it can
      # implement its own policy, and logind then stops emitting Session.Lock on
      # lid close, which is the event vigilance's trigger listens for.
      #
      # DUMPED IN BOTH FLAVOURS so the comparison is mechanical rather than two
      # different readings, and asked of logind ITSELF rather than inferred from
      # which packages are installed: BlockInhibited and DelayInhibited are the
      # authoritative answer to "will the lid still reach me".
      echo "=== logind: lid policy and who has inhibited it ==="
      systemd-inhibit --list 2>&1 | head -14 | sed 's/^/  /'
      for _lp in HandleLidSwitch HandleLidSwitchExternalPower \
                 BlockInhibited DelayInhibited; do
        echo "  $_lp = $(busctl get-property org.freedesktop.login1 \
          /org/freedesktop/login1 org.freedesktop.login1.Manager "$_lp" \
          2>&1 | head -1)"
      done
      # AND WHAT VIGILANCE MAKES OF IT, on the real machine rather than against
      # a fixture. triggers.t drives every branch through override knobs, which
      # is the only way to reach the no-lid and unanswerable cases, but a knob
      # short-circuits the probe it replaces: this is the one place the udev
      # query and logind's real answer are both genuine. In the xfce guest that
      # means a REAL block-inhibited handler, which is what the flavour is for.
      if command -v vigilant >/dev/null 2>&1; then
        vigilant report 2>/dev/null \
          | awk '/^-- triggers --$/ { f = 1; next }
                 /^-- / { f = 0 }
                 f' | sed 's/^/    /' || true
      fi

      # ASSEMBLED AFTER EVERY PROBE, which is the only place it can be. It
      # used to sit beside the compositor probe, so the capabilities discovered
      # LATER (the integrator and uinput) were empty when the list was
      # built, and their scenarios skipped while the guest could in fact provide
      # them. A capability that is available and not claimed is as bad as the
      # reverse: both make a scenario report something that is not true.
      SCENARIO_CAPS_EXTRA="$_compositor $_userbus $_wayfire"
      SCENARIO_CAPS_EXTRA="$SCENARIO_CAPS_EXTRA $_tackup $_uinput $_x11"
      SCENARIO_CAPS_EXTRA="$SCENARIO_CAPS_EXTRA $_x11dpms $_xfce"
      echo "  capabilities: $SCENARIO_CAPS_EXTRA"
      # SAY WHICH ENVIRONMENT THIS IS. Four flavours produce four console logs
      # that are otherwise near-identical, and a verdict filed against the wrong
      # one is worse than no verdict: it reports a desktop as covered that was
      # never installed.
      echo "  flavour: @FLAVOUR@"

      echo "=== scenarios (VM substrate) ==="
      SCENARIO_CAPS="@CAPS@ ${SCENARIO_CAPS_EXTRA:-}"; export SCENARIO_CAPS
      SCENARIO_SUSPEND_CMD="rtcwake -m mem -s 5"; export SCENARIO_SUSPEND_CMD
      # BOUNDED, so a hung scenario still reports what it managed. Everything in
      # this block goes to a FILE that is dumped to the serial at the very end,
      # so a suite that never returns never reaches the `cat` and produces NO
      # output at all, not a partial log, nothing. Two cells were set aside as
      # "cause unknown" on exactly that evidence.
      #
      # GENEROUS ON PURPOSE. A bound that fires on a correct machine is the
      # cry-wolf this suite bans, and it must also stay under the HOST's own
      # VM_TIMEOUT (from qemu launch), or the host gives up first and the log is
      # lost anyway, which is the exact failure being fixed here.
      #
      # RAISED 2026-10-01 FROM 420s, AND THE OLD VALUE HAD 2s OF MARGIN LEFT. It
      # was chosen against a measured 302s run and the suite had since grown to
      # 418s with nothing saying so, because the bound only ever spoke when it
      # FIRED: a passing run printed no duration, so there was no way to see it
      # closing. It then fired on a CORRECT lean run that happened to share the
      # host with a concurrent flavour, and the message named the test that was
      # merely running at the time, which cost an investigation into a hang that
      # did not exist.
      #
      # SO THE ELAPSED LINE IS THE REAL FIX AND THE NUMBER IS THE CONSEQUENCE.
      # 600s leaves ~180s of headroom over the measurement, and the host bound
      # moved with it: provisioning costs about 30s from the preserved image, so
      # 600 + 30 must stay clear of VM_TIMEOUT. A hang now costs 600s of waiting
      # instead of 420, which is the right trade: a false failure on a correct
      # run is more expensive than a slow true one, and this already proved it.
      # AND IT REPORTS THE ELAPSED TIME WHETHER OR NOT IT FIRES, because the
      # bound alone cannot tell "a test hung" from "the suite grew past it", and
      # those want opposite responses. It fired once with the suite merely
      # SLOWER, and "TIMED OUT after 420s" said nothing about whether 430 would
      # have done: the measurement the operator needs is how close a passing run
      # came, which is only visible when the passing run prints it too.
      #
      # THE BREADCRUMB NAMES WHAT WAS RUNNING, NOT WHAT HUNG, and the wording
      # now says so. On a suite-wide bound the last test to START is the one
      # holding the clock at that instant, which is a hang only if the elapsed
      # time is nowhere near the bound.
      VIGILANCE_RUNNING_FILE=/root/running; export VIGILANCE_RUNNING_FILE
      _src=0
      _st=$(date +%s)
      timeout -k 10 "${VIG_SUITE_TIMEOUT:-600}" sh test/run @FILTER@ || _src=$?
      _el=$(( $(date +%s) - _st ))
      echo "suite: ${_el}s of a ${VIG_SUITE_TIMEOUT:-600}s bound"
      if [ "$_src" = 124 ]; then
        echo "SUITE EXCEEDED ITS BOUND of ${VIG_SUITE_TIMEOUT:-600}s."
        echo "RUNNING AT THE TIME: $(cat /root/running 2>/dev/null || echo \
          '<unknown>') (the last test to START, which is a HANG only if the"
        echo "  elapsed time above is far short of the bound; otherwise the"
        echo "  suite has simply grown and the bound wants raising)"
      fi
      echo "VIGILANCE_VM_EXIT=$_src"
    } > /root/log 2>&1
    cat /root/log > /dev/ttyS0
    poweroff -f
EOF
# THE ONE HOST VALUE, substituted AFTER the fact. The heredoc above is now
# QUOTED, so NOTHING in it expands on this box: the only way to make prose
# inside it safe. Twice a BACKTICK in a COMMENT there ran here: once
# `systemctl --user`, splicing its unit list into the guest config, and once
# `env`, splicing the developer's whole environment. Both times the rule
# "keep prose out of the heredoc" was already written at the top of it, and
# both times it was broken a few edits later. A rule that needs remembering
# is weaker than a structure that cannot go wrong.
sed -i "s|@CAPS@|$CAPS|" "$_seed/user-data"
# NARROWING THE RUN IS WHAT MAKES FAULT WORK ITERABLE. The suite is most
# of the wall clock, and a fault loop wants ONE scenario, not 53.
sed -i "s|@FILTER@|${VIGILANCE_VM_ONLY:-}|" "$_seed/user-data"
sed -i "s|@FLAVOUR@|$FLAVOUR|" "$_seed/user-data"

# PARSE THE GUEST SCRIPT BEFORE BOOTING IT. `dash -n` on this file checks the
# HOST script; the runcmd above is a STRING to it, so a syntax error in the
# guest is invisible until a three-minute boot ends in "guest never reported".
# That has now happened twice in one sitting, both times from a quoting layer
# eating a character on the way in: an unquoted heredoc running a backtick on
# the host, and an editor swallowing a closing quote. The guest script is
# shipped code and gets the same cheapest-possible check as everything else.
_gs=$VMF/guest-script
awk '/^  - \|$/ { f = 1; next } f' "$_seed/user-data" | sed 's/^    //' > "$_gs"
[ -s "$_gs" ] || _die "could not extract the guest script from the seed"
dash -n "$_gs" || _die "the guest runcmd does not parse; see $_gs"

xorriso -as mkisofs -R -J -V CIDATA -quiet \
  -o "$VMF/seed.iso" "$_seed" 2>/dev/null || _die "seed.iso failed"

# --- the PRESERVED machine image --------------------------------------------
# Two stages, and the split is what keeps the snapshot honest:
#
#   built.qcow2   THE MACHINE: packages, the vig user, greetd autologin,
#                 wayfire, the user manager. Expensive, built once.
#   per run       THE CODE UNDER TEST: the repo, setup.sh, the integrator,
#                 the scenarios. Cheap, fresh every time.
#
# IF VIGILANCE'S OWN CODE WERE BAKED IN, every commit would invalidate the
# image SILENTLY, the staleness class this project keeps paying for (a
# shadowed binary, a pinned argv, a checkout a commit behind). Keyed on the
# release, the flavour and the package list ONLY, so the key is small and
# stable while the code under test is always current.
#
# THE FLAVOUR IS IN THE KEY even though each one already has its own directory,
# because the package list is not the only thing a flavour may eventually
# change about THE MACHINE. Leaving it out would mean a flavour that differs
# only in guest-side build steps silently inherited another's image, which is
# the staleness this whole split exists to prevent.
BUILT=$VMF/built.qcow2
_bkey=$(printf '%s|%s|%s' "$RELEASE" "$FLAVOUR" "$PKGS" | cksum | tr -d ' ')
_bhave=$(cat "$VMF/built.key" 2>/dev/null || true)
if [ ! -f "$BUILT" ] || [ "$_bhave" != "$_bkey" ]; then
  echo "vm: building the preserved '$FLAVOUR' image (once per package set)"
  _bseed=$VMF/bseed
  _bcon=$VMF/build-console.log
  rm -rf "$_bseed"; mkdir -p "$_bseed"
  printf 'instance-id: vigilance-build-%s\nlocal-hostname: vigilance-vm\n' \
    "$$" > "$_bseed/meta-data"
  # WRITTEN WITH printf, NOT A HEREDOC. The package list is a host value, and
  # an unquoted heredoc is how this harness twice executed prose on the
  # developer's box. Building the YAML line by line has neither hazard.
  {
    echo "#cloud-config"
    echo "packages:"
    for _p in $PKGS; do echo "  - $_p"; done
    echo "runcmd:"
    echo "  - touch /var/lib/vigilance-built"
    echo "  - sync"
    echo "  - poweroff"
  } > "$_bseed/user-data"
  xorriso -as mkisofs -R -J -V CIDATA -quiet \
    -o "$VMF/bseed.iso" "$_bseed" 2>/dev/null || _die "build seed failed"
  rm -f "$BUILT.part"
  qemu-img create -q -f qcow2 -F qcow2 -b "$IMG" "$BUILT.part" 8G \
    || _die "build overlay failed"
  qemu-system-x86_64 -enable-kvm -machine q35 -m 2048 -smp 2 \
    -drive file="$BUILT.part",if=virtio \
    -drive file="$VMF/bseed.iso",if=virtio,media=cdrom \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -display none -serial "file:$_bcon" -monitor none \
    -no-reboot >/dev/null 2>&1 &
  _bpid=$!
  _bw=0
  while [ "$_bw" -lt "${VM_BUILD_TIMEOUT:-600}" ]; do
    if ! kill -0 "$_bpid" 2>/dev/null; then break; fi
    sleep 2; _bw=$((_bw + 2))
  done
  kill "$_bpid" 2>/dev/null || true
  wait "$_bpid" 2>/dev/null || true
  # THE MARKER IS THE PROOF. A guest that died early still leaves a qcow2, and
  # keeping it would preserve a half-built machine as "known good", the
  # false-green shape, baked into an image and reused for weeks.
  if ! grep -q "Reached target.*[Pp]ower" "$_bcon" 2>/dev/null \
     && ! grep -q "reboot: Power down" "$_bcon" 2>/dev/null; then
    rm -f "$BUILT.part"
    _die "the build guest never powered down; see $_bcon"
  fi
  mv "$BUILT.part" "$BUILT"
  printf '%s\n' "$_bkey" > "$VMF/built.key"
  echo "vm: preserved image built"
fi

# --- a fresh overlay per run ------------------------------------------------
# cloud-init runs once per instance-id, so a reused overlay would silently
# skip the whole test and look like a pass.
rm -f "$VMF/boot.qcow2"
qemu-img create -q -f qcow2 -F qcow2 -b "$BUILT" "$VMF/boot.qcow2" 8G \
  || _die "overlay failed"

: > "$CONSOLE"
echo "vm: booting (console: $CONSOLE)"

# The VERDICT COMES FROM THE SERIAL LOG, never from qemu's exit status, and
# qemu is bounded by a timeout. Both are load-bearing: after an S3 cycle qemu
# does NOT reliably exit when the guest powers down (observed: three runs left
# three live VMs and the runner blocked forever). Trusting the child's exit
# both hung the harness and leaked a VM per run.
#
# -global ICH9-LPC.disable_s3=0 is what makes a REAL S3 cycle possible in the
# guest; without it rtcwake cannot suspend and the depth-across-suspend
# scenario would be untestable here too.
qemu-system-x86_64 -enable-kvm -machine q35 -m 2048 -smp 2 \
  -global ICH9-LPC.disable_s3=0 \
  -drive file="$VMF/boot.qcow2",if=virtio \
  -drive file="$VMF/seed.iso",if=virtio,media=cdrom \
  ${_tackup_drive} \
  -drive file="$VMF/repo.iso",if=virtio,media=cdrom \
  -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
  -display none -serial "file:$CONSOLE" -monitor none -no-reboot \
  >/dev/null 2>&1 &
_qpid=$!

# Poll the log for the guest's completion marker, then stop the VM. Bounded, so
# a guest that never reports cannot hang the run either way.
_waited=0
while [ "$_waited" -lt "${VM_TIMEOUT:-900}" ]; do
  if grep -q 'VIGILANCE_VM_EXIT=' "$CONSOLE" 2>/dev/null; then break; fi
  if ! kill -0 "$_qpid" 2>/dev/null; then break; fi
  sleep 2
  _waited=$((_waited + 2))
done
kill "$_qpid" 2>/dev/null || true
wait "$_qpid" 2>/dev/null || true

# --- verdict ----------------------------------------------------------------
echo "vm: ---- guest output ----"
sed -n '/=== from-scratch install ===/,$p' "$CONSOLE" || true
echo "vm: ---- end ----"

if [ "$KEEP" != --keep ]; then rm -f "$VMF/boot.qcow2"; fi

if grep -q 'VIGILANCE_VM_EXIT=0' "$CONSOLE" 2>/dev/null; then
  echo "vm: PASS"
  exit 0
fi
# A missing marker is NOT a pass. A guest that never got far enough to print
# one has failed in a way that matters more than an assertion, not less.
grep -q 'VIGILANCE_VM_EXIT=' "$CONSOLE" 2>/dev/null \
  || _die "guest never reported (boot or cloud-init failure); see $CONSOLE"
echo "vm: FAIL"
exit 1
