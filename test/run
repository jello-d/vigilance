#!/bin/sh
# test/run - run every vigilance shell test (test/*.t) and report. Non-zero if
# any fails. POSIX sh, no dependency beyond a shell and the repo checkout.
#
# This is the STUB substrate. It provides no systemd, no logind, no suspend and
# no hardware, and it does NOT pretend otherwise: a scenario declaring
# `require systemd` skips here and runs for real under test/vm/run. A stubbed
# `systemctl` would lie, and a lying stub is exactly how modules/tests/lock
# stayed green while ~/bin/panel-power did not exist.
#
# SKIPS ARE COUNTED AND PRINTED. A green run that silently omitted half the
# suite is the same false confidence that let lock-watch sit dead for 74,309
# restarts, so the summary always states what was not covered here.
set -eu
_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# The capabilities this substrate can honour. test/vm/run sets a longer list.
#
# `unprivileged` is the one capability this tier has and the VM does NOT: the
# guest runs as root, and root ignores permission bits entirely, so an assertion
# about a file being unwritable cannot hold there. It is declared rather than
# worked around, because the alternative is a silent `[ "$(id -u)" != 0 ]` guard
# inside a scenario, and a skip nobody sees is how coverage gets overstated.
SCENARIO_CAPS=${SCENARIO_CAPS:-}
[ "$(id -u)" = 0 ] || SCENARIO_CAPS="$SCENARIO_CAPS unprivileged"
export SCENARIO_CAPS

_rc=0
_pass=0
_skip=0
_need=""
# AN OPTIONAL FILTER, matched against the test's basename. A fault-injection
# loop wants ONE scenario, not fifty-three, and in the VM the suite is most of
# the wall clock. It is a SUBSTRING match rather than a glob so `sh test/run
# lock` picks up every lock scenario.
#
# A FILTER THAT MATCHES NOTHING IS AN ERROR, not an empty pass. Otherwise a
# typo reports "0 passed" in green, which is the reach-no-verdict failure this
# runner already refuses one layer down.
_only=${1:-}
_seen=0
for _t in "$_dir"/*.t; do
  [ -f "$_t" ] || continue
  if [ -n "$_only" ]; then
    case "$(basename "$_t" .t)" in *"$_only"*) ;; *) continue ;; esac
  fi
  _seen=$((_seen + 1))
  # The test's OWN status, kept apart from the run's, because "failed" and
  # "reached no verdict" are different findings and only one of them is news. A
  # failing test already says so in its own words; reporting it as verdictless
  # too buries the message it printed under a second, wronger one.
  _trc=0
  # A BREADCRUMB, because the capture below is what makes a HANG invisible. A
  # test's output is held until it finishes, so one that never finishes prints
  # nothing at all and the runner never says which it was. On a substrate whose
  # whole log is dumped at the end (the VM) that leaves a hang with literally no
  # evidence, which has cost two investigations: the lid cell was set aside as
  # "cause unknown" and the clock cell after it. Written only when a caller asks
  # for it, so a desk run (where output streams live and the last `ok` already
  # says where you are) is unchanged and two concurrent suites cannot collide.
  [ -z "${VIGILANCE_RUNNING_FILE:-}" ] \
    || printf '%s\n' "$(basename "$_t")" > "$VIGILANCE_RUNNING_FILE" \
    || true
  _out=$(sh "$_t" 2>&1) || _trc=1
  [ "$_trc" -eq 0 ] || _rc=1
  printf '%s\n' "$_out"
  # Match the LAST line, not the first: a test may emit tool noise ahead of its
  # verdict (rtcwake chatters on stderr during the real suspend scenario), and
  # matching the head silently undercounted it. An undercount is precisely the
  # false confidence this summary exists to prevent.
  case "$(printf '%s\n' "$_out" | tail -n 1)" in
    skip\ *)
      _skip=$((_skip + 1))
      _n=${_out#*(needs }; _n=${_n%)*}
      case " $_need " in *" $_n "*) ;; *) _need="$_need $_n" ;; esac ;;
    ok\ *) _pass=$((_pass + 1)) ;;
    # NEITHER IS A FAILURE, and this was a real hole. A test that exits 0
    # without reaching `pass` is counted as neither passed nor skipped, so the
    # suite goes on to report success and the ONLY trace is the total silently
    # dropping by one, which nobody reads as a regression.
    #
    # Found by causing it: a mangled heredoc delimiter swallowed the rest of a
    # test file, so everything after it (including `pass`) was heredoc content.
    # The file exited 0, printed nothing, and the run stayed green. A test that
    # has stopped testing must be as loud as a test that fails, because it is
    # the same thing wearing a quieter hat.
    *)
      if [ "$_trc" -eq 0 ]; then
        _rc=1
        printf '%s: NO VERDICT: exited 0 without reaching pass or skip\n' \
          "$(basename "$_t")"
        printf '  A truncated or silently-aborted test is not a passing one.\n'
      elif [ -z "$_out" ]; then
        # A FAILING TEST THAT PRINTED NOTHING MUST STILL BE NAMED. `fail` writes
        # a message, so this is the OTHER silent abort: a bare `set -e` exit,
        # classically an unguarded `_x=$(vigilant report)` on a substrate where
        # report legitimately exits non-zero for an unrelated section. The run
        # then said "vigilance tests FAILED" with no test named and no output at
        # all: one blank line in a 68-line log, and finding which file it
        # was cost an investigation. The runner knows the name; it just never
        # said it.
        printf '%s: FAILED with NO OUTPUT (rc=%s)\n' "$(basename "$_t")" "$_trc"
        printf '  A `set -e` abort before anything printed. The usual\n'
        printf '  cause is an unguarded capture of a command that fails here.\n'
      fi ;;
  esac
done

if [ -n "$_only" ] && [ "$_seen" = 0 ]; then
  echo "no test matches '$_only': a filter that selects nothing is a typo,"
  echo "not a clean run."
  exit 1
fi

if [ "$_rc" -ne 0 ]; then
  echo "vigilance tests FAILED"
  exit 1
fi
if [ "$_skip" -gt 0 ]; then
  printf '%d passed, %d skipped here (need:%s); run test/vm/run for those\n' \
    "$_pass" "$_skip" "$_need"
else
  printf 'all vigilance tests passed (%d)\n' "$_pass"
fi
exit 0
