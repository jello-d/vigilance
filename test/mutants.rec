+ HOOK_SKIP=76

# THE HISTORICAL REGRESSION, in its exact shape: a helper called once per HOOK
# per EDGE that runs a program where the shell would do. Behaviour-preserving on
# purpose: no other test can tell, which is what makes perf.t the only guard.
= intent-lookup-spawns-a-process-per-call
f bin/vigilant
t perf
-   if [ -z "${1:-}" ]; then printf 'none\n'; return 0; fi
+   if [ -z "$(echo "${1:-}" | tr -d q)" ]; then printf 'none\n'; return 0; fi

# A FILE KEPT PER CROSSING. Nothing else in the suite counts what the runtime
# dir holds, and a leak there is invisible for weeks at ~28 crossings a day.
= runtime-state-accumulates-per-crossing
f bin/vigilant
t soak
-       _crossing_held=1
+       _crossing_held=1; touch "$RUN_DIR/leak.$$" 2>/dev/null || true

# DEDUP OFF ENTIRELY, which is the storm that got a live box's supervision timer
# stopped BY HAND. Distinct from the cooldown-comparison record above: that one
# is about a clock, this one is about the tier existing at all.
= alert-dedup-never-suppresses
f bin/vigilant
t soak
-   if [ "$ALERT_COOLDOWN" = 0 ]; then return 1; fi
+   return 1

# THE HOURLY INTERVAL ITSELF, which was discipline only until cadence.t case 6.
# With any past stamp counting as recent, a tier that defers once defers FOR
# EVER and report keeps saying "not due", which a reader takes for covered.
# hook_lib.t catches this too, at the helper; naming cadence is the point,
# because the RUNNER is in the loop there and a green helper never proved the
# chain.
= throttle-never-elapses
f lib/hook_lib
t cadence
-      && [ "$(( _ht_now - _ht_at ))" -lt "$_ht_every" ]; then
+      && [ "$(( _ht_now - _ht_at ))" -ge 0 ]; then

# comm IS TRUNCATED TO 15 BYTES by the kernel, so dropping the
# truncation makes an exact match on any longer name impossible. The
# plausible values are ordinary (xfce4-screensaver is 17), and the
# consequence is a correctly locked box reporting no locker.
= proc-truncation-hooklib
f lib/hook_lib
t proc-identity lock-blank locker-up
-   _hpn=$(printf '%.15s' "$1")
+   _hpn=$(printf '%s' "$1")

# The runner's twin of the above. Two implementations exist because a
# hook cannot source the runner; this is the record that stops them
# drifting in the direction that matters.
= proc-truncation-runner
f bin/vigilant
t proc-identity
-   _ppn=$(printf '%.15s' "$1")
+   _ppn=$(printf '%s' "$1")

# THE FALSE-GREEN DIRECTION. A comparison that accepts anything is
# what `pgrep -x` did with an ERE: `.*` matched every process, so
# locker-up would certify a secured session with nothing locking.
= proc-match-is-exact-hooklib
f lib/hook_lib
t proc-identity locker-up
-     if [ "$_hpc" = "$_hpn" ]; then
+     if [ -n "$_hpc" ]; then

= proc-match-is-exact-runner
f bin/vigilant
t proc-identity
-     if [ "$_ppc" = "$_ppn" ]; then
+     if [ -n "$_ppc" ]; then

# A PERFECT HELPER PROVES NOTHING IF A CALL SITE STILL REACHES FOR
# pgrep. This is the site that made report announce "depth 'lock'
# matches a live locker" from a pattern that matched anything.
= proc-callsite-report-locker
f bin/vigilant
t proc-identity
-   _proc_running "$LOCKER_NAME"
+   pgrep -x "$LOCKER_NAME" >/dev/null 2>&1

# The security verifier's own probe. Every other case in locker-up.t
# sets VIGILANCE_LOCKER_UP, which short-circuits it, so this site was
# covered by nothing at all until that file grew a real-process case.
= proc-callsite-locker-up
f libexec/hooks/locker-up
t locker-up
-   hook_proc_running "$LOCKER"
+   pgrep -x "$LOCKER" >/dev/null 2>&1

# THE SITE THE FIRST AUDIT MISSED, because a flag sits between `pkill`
# and `-x` and the sweep grepped for `pkill -x`. With pkill an
# over-wide pattern SIGNALS THE WHOLE BOX rather than answering wrong.
= proc-callsite-lock-blank-signal
f libexec/hooks/lock-blank
t proc-identity lock-blank
- if ! hook_proc_signal "$_sig" "$LOCKER"; then
+ if ! pkill -"$_sig" -x "$LOCKER" 2>/dev/null; then

# A THRESHOLD THAT ACCEPTS EVERYTHING. A white cursor peaks at 1.0, so a cut
# above that certifies the exact state this statistic was added for: a black
# OLED with a bright spot held still on it.
= luma-peak-threshold
f lib/hook_lib
t screen-dark hook_lib
-   awk -v v="$1" 'BEGIN { exit !(v + 0 <= 0.02) }' 2>/dev/null
+   awk -v v="$1" 'BEGIN { exit !(v + 0 <= 1.01) }' 2>/dev/null

# awk TURNS GARBAGE INTO 0 AND 0 IS DARK, the one wrong answer that switches
# the tier off rather than merely annoying it. Shared by both thresholds, so
# this one record covers the mean's guard and the peak's.
= luma-number-guard
f lib/hook_lib
t screen-dark hook_lib
-     ''|*[!0-9.eE+-]*) return 1 ;;
+     XX-no-such-case) : ;;

# THE WHOLE POINT OF THE SECOND STATISTIC. Dropping it returns the hook to
# measuring the mean alone, which calls a white cursor on black DARK by a
# factor of 22.
= screen-dark-ignores-the-peak
f libexec/hooks/screen-dark
t screen-dark
- if ! hook_luma_peak_is_dark "$_p"; then
+ if false; then

# THE COMPATIBILITY PROMISE. Without the split a caller handing over the whole
# answer gets `0 peak=0`, the number guard rejects it, and a pitch-black
# screen reads as LIT. lock-blank did exactly that and its test caught it.
= luma-is-dark-takes-field-1
f lib/hook_lib
t lock-blank screen-dark
-   set -- "${1%% *}"
+   set -- "$1"

# grim OMITS CURSORS WITHOUT -c, so the peak statistic would have nothing to
# measure and the pointer on a black lock surface stays invisible to it. Two
# independent blindnesses: either one alone still certifies the state.
= luma-capture-omits-the-cursor
f lib/hook_lib
t screen-dark
-     _slg="timeout 25 grim -c -s 0.05 -"
+     _slg="timeout 25 grim -s 0.05 -"

# AN ABSENCE OF EVIDENCE RENDERED AS CONFIRMATION. With no backlight device the
# loop body never runs, and this printed "matches dark hardware" having
# examined nothing. Measured: that is manifestor's state on every pass.
= coherence-claims-dark-with-no-device
f bin/vigilant
t report
-       elif [ "$_seen" = 0 ]; then
+       elif false; then

# THE BOUND IS THE POINT OF THAT LINE, so dropping it must not pass. The
# pass at rung `open` rests on our-locker-shaped evidence, and a reader who
# is not told so reads [OK] as a statement about the session. Measured with
# a real foreign locker holding the screen while this line said [OK].
= coherence-open-claim-is-bounded
f bin/vigilant
t report
- " nothing is still not visible here)" ;;
+ ")" ;;

# A SEVERITY IS PART OF A CLAIM. The sentence is identical under _r_info, only
# the marker moves, so a report would MENTION a declared unit that is missing
# and not fail about it. An earlier version of the test grepped the text alone
# and this mutation survived it.
= machinery-missing-unit-is-a-fail
f bin/vigilant
t report
-     _r_bad "$_url: $_urd declared but NOT $_urc$_urw"
+     _r_info "$_url: $_urd declared but NOT $_urc$_urw"

# AND DECLARING NONE MUST NOT GO QUIET ABOUT A UNIT THAT IS THERE. Downgrading
# the WARN to the genuinely-absent INFO makes "declare it absent" the way to
# switch a real finding off, which is the whole risk a declaration introduces.
= machinery-undeclared-but-installed-warns
f bin/vigilant
t report
-       _r_warn "$_url: $_urf is installed on this box but DECLARED NONE, so"\
+       _r_info "$_url n/a (this box declares none)" #\

# THE FOREIGN-SCREENSAVER FINDING IS A WARN, AND THE SEVERITY IS THE CLAIM.
# `_r_bad` sets RRC=1, so a FAIL here makes every box whose desktop raises its
# own screensaver with this ladder at `open` report non-zero for ever. A
# message-only assertion would pass this mutation, which is exactly how the
# unit-role downgrade survived two days ago.
= coherence-foreign-screensaver-is-a-warn
f bin/vigilant
t report
-           0) _r_warn "depth says 'open' but $SSAVER_NAME reports the screen"\
+           0) _r_bad "depth says 'open' but $SSAVER_NAME reports the screen"\

# THE WIRING QUESTION IS ON THE UNCONDITIONAL LIST. Dropping the call restores
# the live outage exactly: the one check a wiring fault cannot blind goes back
# to living only in a verb nothing runs on a timer, and 46 minutes pass in
# silence. Measured 2026-10-04.
= enforce-asks-the-wiring-question
f bin/vigilant
t watchdog
-   _enforce_wiring || _erc=1
+   : # _enforce_wiring

# AN ACT TIER THAT RAN NOTHING CANNOT CLAIM THE EDGE. With this guard inert the
# lock edge crosses with every wired hook dangling, returns 0, and records the
# rung that means the session is secured. That is the measured live fault, and
# the status is what lock-on-sleep reads on the way into a suspend nothing can
# veto.
= act-tier-ran-nothing-is-not-success
f bin/vigilant
t hooks
-     if [ -n "$_cob" ]; then
+     if false; then   # mutation: the blocked-hook finding is discarded

# A DECLINE RESTS ON A PREMISE. Inert, a security request stands on a record it
# can see is false, which is how a transient wiring fault became an 84-minute
# inability to lock: `already at 'lock'; nothing to do`, twelve times, while no
# locker existed.
= decline-checks-its-premise
f bin/vigilant
t atleast
-     if [ -n "${_secreq:-}" ] && [ "$_to" = lock ] && ! _lock_holds; then
+     if false; then   # mutation: the premise is assumed rather than asked

# A VERIFIER READS WHAT THE HARDWARE REPORTS. Swapping the attribute back to
# `brightness` reinstates the shipped defect: the hook then certifies that the
# panel is dark because 0 was WRITTEN to it, with the device reporting it is
# still lit. The two agree on this fleet, so nothing but a diverging fixture
# can see it, and every case in screen-dark.t passed with it present until one
# existed.
= screen-dark-reads-the-reported-brightness
f libexec/hooks/screen-dark
t screen-dark
-     _sbc=$(cat "$_sb/actual_brightness" 2>/dev/null || echo)
+     _sbc=$(cat "$_sb/brightness" 2>/dev/null || echo)

