# test/harness_lib - harness for vigilance's shell tests (test/*.t).
# Sourced by each of them; named for what it provides (harness_init).
#
# Call `harness_init <name>`: sets HERE (the repo root, so a test reaches
# bin/, install, systemd/), a private scratch dir T (removed on exit), and the
# pass/fail helpers. Everything a test touches is confined to T; nothing outside
# it is written. POSIX sh; run one with `sh test/<name>.t`, all with test/run.
harness_init() {   # <name>
  TEST_NAME=$1
  HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
  # CHECKED, THEN BAKED IN. `rm -rf` never runs with a variable expansion
  # (_common.md, HARD rule), and a destructive `trap` is the sharpest case
  # because it defers the expansion to FIRE TIME, on an error path, when
  # whatever the name holds by then is what goes. So the value is validated
  # while it can still be looked at, and the LITERAL is quoted into the trap at
  # ARM time: `trap` then prints exactly what will run, and no later assignment
  # can move the target.
  #
  # WHY THE RULE EXISTS, and it was not this repo: mux's own harness DELETED
  # ~/src/mux, because `cd -- "$(mktemp -d)" && pwd -P` turns an empty mktemp
  # answer into `cd ""` (which stays put) plus `pwd -P`, so T became the CURRENT
  # DIRECTORY. This harness has always used the plain `$(mktemp -d)`, whose
  # empty answer stays empty, so it never had that bug. It DID have the deferred
  # trap, and an unchecked assignment, which is the half worth closing anyway:
  # the general shape is that A TRANSFORMATION MAKING AN EMPTY VALUE MEANINGFUL
  # is a different kind of change, and the cheapest defence is to refuse a value
  # that is not an absolute path before anything destructive is armed with it.
  T=$(mktemp -d) || { echo "harness: mktemp -d failed" >&2; exit 1; }
  case $T in
    /*) ;;
    *) echo "harness: mktemp -d gave '$T', which is not an absolute path;
refusing to arm a cleanup that would delete something else" >&2; exit 1 ;;
  esac
  # AND NO SINGLE QUOTE, which is a hazard the bake-in itself introduces and the
  # prescribed form shares: the literal is wrapped in single quotes, so a path
  # containing one (from an exotic TMPDIR) would end the quoting early and hand
  # `rm -rf` something other than this directory. Refused rather than escaped,
  # because the whole point of baking a literal in is that the command is
  # inspectable, and an escaping scheme is one more layer to get wrong.
  case $T in
    *"'"*) echo "harness: mktemp -d gave a path containing a single quote;
refusing, because the cleanup quotes that path literally" >&2; exit 1 ;;
  esac
  _T_LITERAL="'$T'"
  trap "rm -rf $_T_LITERAL" EXIT INT TERM
}
pass() { printf 'ok   %s%s\n' "$TEST_NAME" "${1:+ ($1)}"; }
fail() { printf 'FAIL %s: %s\n' "$TEST_NAME" "$1" >&2; exit 1; }

# require <capability>: declare a substrate need. The stub substrate cannot
# provide systemd/logind/suspend/hardware, so it SKIPS and says so. The VM
# substrate sets SCENARIO_CAPS to the list it can honour.
#
# HERE RATHER THAN IN scenario_lib, because the SESSION tier needs it and wants
# none of scenario_lib's recorder setup. Gating which substrate a test may run
# on is a harness question, not a scenario one.
require() {   # <capability>...
  for _c in "$@"; do
    case " ${SCENARIO_CAPS:-} " in
      *" $_c "*) ;;
      *) printf 'skip %s (needs %s)\n' "$TEST_NAME" "$_c"; SKIPPED=1; exit 0 ;;
    esac
  done
}

# skip_now <reason>: the substrate cannot host this scenario, DISCOVERED at run
# time rather than declared as a capability. Same output contract as `require`,
# because test/run counts a leading "skip " and a second spelling of that would
# drift.
#
# WHY IT IS NOT A CAPABILITY. A capability is probed once, before any scenario
# runs, and some substrate facts are not settled by then: a display manager
# takes its logind inhibitors seconds into the boot, so the guest's own probe
# read BlockInhibited as empty and the inhibitor was there by the time the
# scenario asked. A condition that appears late has to be asked about late.
#
# IT MUST STAY NARROW, and that is the whole risk of having it: a skip is a
# green line, so it may only ever be reached when the specific blocking cause
# has been DEMONSTRATED. Anything else must still fail, or "the substrate could
# not host it" becomes the excuse that swallows a real defect.
#
# THE EVIDENCE GOES FIRST AND THE VERDICT LAST, which is the runner's contract
# and not a style choice: test/run matches the LAST line of a test's output, so
# a multi-line skip message left the verdict buried and the run reported
# "NO VERDICT: exited 0 without reaching pass or skip". Measured, on the first
# use of this helper. The token is one word for the same reason: the summary
# collects the `(needs X)` values into a space-separated list of what the
# substrate could not provide, so a sentence there would split into nonsense.
skip_now() {   # <one-word-token> <reason>
  [ -z "${2:-}" ] || printf '  %s\n' "$2"
  printf 'skip %s (needs %s)\n' "$TEST_NAME" "$1"
  SKIPPED=1
  exit 0
}


# report's EXIT CODE folds in the `-- machinery --` section, which reads the
# HOST's real systemd: whether vigilance's three units are enabled. That is
# legitimately different between substrates, and the suite's own rule forbids
# stubbing systemd to flatten it.
#
# So a test that wants "report saw nothing wrong HERE" must scope to the section
# under test rather than take the whole verdict. The VM tier caught this on its
# first run: rescue.t was green in the stub substrate and red in the VM, failing
# on units it was never testing. Exactly the integration gap two tiers exist to
# expose, and the reason the stub tier alone is not trusted.
#
# Assertions of FAILURE still use the exit code: an extra failure elsewhere
# cannot turn a red verdict green.
_section() {   # <report-output> <section-name>
  printf '%s\n' "$1" | awk -v s="-- $2 --" '
    $0 == s { inside = 1; next } /^-- / { inside = 0 } inside'
}
_no_fail_in() {   # <report-output> <section> <why>
  _sec=$(_section "$1" "$2")
  case "$_sec" in
    *"[FAIL]"*) printf '%s\n' "$_sec" >&2; fail "$3" ;;
  esac
}

# _fail_in: the positive twin, and the reason both exist is that REPORT HAS ONE
# EXIT CODE for nine sections, several of which read the real host (machinery
# asks the live systemd whether vigilance's units are enabled).
#
# So `report ... && fail "it should have failed"` is not an assertion about the
# code under test. It passes for free on any host that is red for an unrelated
# reason, and a test that cannot fail is worse than no test: it reports
# confidence it does not have. greeter.t hit exactly this in the VM.
#
# Scope the claim to the section that owns it. A test about actuators asserts
# about the actuators section, and its verdict is then the same on every
# substrate.
_fail_in() {   # <report-output> <section> <why>
  _sec=$(_section "$1" "$2")
  case "$_sec" in
    *"[FAIL]"*) return 0 ;;
  esac
  printf '%s\n' "$_sec" >&2
  fail "$3"
}
