# Lock the Wayland session before ANY system suspend.
#
# Before=sleep.target + WantedBy=sleep.target: this oneshot runs as part of the
# transition into sleep and sleep.target WAITS for it, so the box cannot
# suspend until the screen is locked.
#
# The gate is now the natural semantics of `vigilant go lock` rather than a
# hand-built handshake: the lock provider starts the locker as a transient
# unit, and `systemctl start` returns only once swaylock has COMMITTED the
# lock (its -f parent exits after the compositor confirms). No marker file and
# no polling, which is what smart-trigger existed to do.
#
# VIGILANCE_SOURCE=suspend is safety-critical: it tells block hooks which path
# this is, and the phantom guard must never suppress it. Gating this would
# sleep the box UNLOCKED.
[Unit]
Description=vigilance: lock the session before the system sleeps
Documentation=man:swaylock(1)
Before=sleep.target

[Service]
Type=oneshot
# @HOME@, NOT %h. In a SYSTEM unit %h resolves to ROOT's home regardless of
# User=, so `%h/.local/bin/vigilant` became /root/.local/bin/vigilant and died
# with 203/EXEC on every single sleep. It failed SILENTLY, because a failed
# Before=sleep.target oneshot does not block the transition: systemd logged the
# failure, reached sleep.target, and slept anyway. The suspend-lock guarantee
# was fiction from the moment these units stopped using an absolute path.
User=@USER@
Environment=VIGILANCE_SOURCE=suspend
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
ExecStart=@HOME@/.local/bin/vigilant go lock
# PROVE IT LOCKED, do not assume it. `go lock` succeeding means the hooks
# returned 0; it does not mean a locker is up. systemd waits for this unit
# before reaching sleep.target, so the check costs nothing anyone notices, and
# it turns "the unit succeeded" into a claim about the SESSION rather than
# about the hooks. Requires a lock.verify.d that actually asks -- the shipped
# `locker-up` hook is the one that does; peripheral verifiers only assert the
# screen is lit.
#
# It CANNOT stop the sleep. A failed unit ordered Before=sleep.target does not
# abort the transition, and nothing supported does. What it buys is that
# sleeping unlocked is recorded and alerted instead of reported as success, and
# the audit tier reconciles it afterwards.
ExecStartPost=@HOME@/.local/bin/vigilant verify lock
# Cap the unit so a missing or slow session can never wedge the suspend
# transition. A box that will not sleep is worse than one that sleeps late.
TimeoutStartSec=25

[Install]
WantedBy=sleep.target
