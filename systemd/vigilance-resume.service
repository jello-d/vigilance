# Come back to `lock` after the machine returns from S3: lit, and still secured.
#
# There was NO resume path at all before this. On resume the hardware may have
# come back lit on its own, and a QMK keyboard has been re-enumerated over USB
# and forgotten its state, so the saved values are STALE. `go lock` from
# `suspend` crosses `resume` (whose hooks re-assert from CONFIG rather than
# restoring a stale save file) and then `wake` (which lights things up). The
# brief dark-then-lit is the point: the peripherals are put in a known state
# before being brought back.
#
# IT USED TO SAY `go sleep`, AND THAT WAS WRONG, because the premise ("after S3
# you are at rung `sleep` until input") assumes nobody is there: a human waking
# the machine, or a spurious suspend, got the screen darkened on an ACTIVE user.
# Observed as a 2-second s2idle entry/exit followed by 32 seconds of dark.
#
# NOTHING WAS ARMED TO ASCEND, which is what made it bad rather than odd. The
# only trigger that crosses `wake` is swayidle's `resume` action, which fires
# only after one of ITS OWN timeouts, so reaching `sleep` this way left swayidle
# unaware the machine was dark: input produced nothing and recovery needed a
# keybind. `lock` is safe both ways instead, since waking deliberately gets you
# your screen and a spurious wake is dimmed again by the idle timer.
#
# After=suspend.target, so it runs on the way UP.
[Unit]
Description=vigilance: re-assert peripherals and return to lock after resume
After=suspend.target hibernate.target hybrid-sleep.target

[Service]
Type=oneshot
# NO HOME PATH AT ALL. This once used %h, which in a SYSTEM unit resolves to
# ROOT's home regardless of User=, so `%h/.local/bin/vigilant` became
# /root/.local/bin/vigilant and died 203/EXEC on every single sleep. It failed
# SILENTLY, because a failed Before=sleep.target oneshot does not block the
# transition: systemd logged it, reached sleep.target and slept anyway, so the
# suspend-lock guarantee was fiction.
#
# Templating the home fixed the symptom; pointing at a SHARED command fixes the
# class. `vigilant` lives in one root-owned tree with a single published path,
# so this references no home, needs no per-user rendering, and cannot follow an
# install into an encrypted home root cannot read. Substituted at install.
User=@USER@
Environment=VIGILANCE_SOURCE=resume
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
# `atmost` SO IT CANNOT DESCEND. Everything above is about the DESTINATION and
# still holds; what was missing is the DIRECTION. A plain `go lock` from `open`
# travels DOWN and locks, and this races the user's own unlock on every resume:
# it starts ~0.3s after wake and so generally wins, which is luck rather than a
# guarantee. The other caller on this path, swayidle's resume arm, lost that
# race and re-locked a session 1.5s after a fingerprint unlock. From `suspend`
# or `sleep` the traversal is unchanged.
ExecStart=@VIGILANT@ go lock atmost
TimeoutStartSec=25

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target
