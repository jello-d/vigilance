#!/bin/sh
# swayidle-mgr -- managed swayidle, TIMER-ONLY: its one job is the idle-LOCK
# timer. It used to also carry swayidle's before-sleep and logind-Lock duties
# plus a phantom-relock detector, AND a panel blank/unblank timer -- but
# swayidle WEDGES on this Wayfire build and silently drops events, so ALL
# security-critical locking moved to the swayidle-INDEPENDENT smart-lock /
# smart-trigger stack (modules/lock; CLAUDE.md "SCREEN LOCKING is swayidle-
# INDEPENDENT"), and the post-lock screen BLANK moved into swaylock's own
# blank-after (driven by panel-power's peripherals hook). A blank must never
# fire UNLOCKED, so gating it behind swaylock is correct: idle -> swayidle ->
# lock -> swaylock -> panel-power (or a manual lock -> swaylock -> panel-power).
# What remains is a thin single-instance wrapper around the idle-lock timer:
#
#   swayidle-mgr start [-f]   run swayidle (idle-lock only); -f = foreground
#   swayidle-mgr stop         tear it down
#   swayidle-mgr restart      stop then start
#   swayidle-mgr status       is it up, and when it last idle-locked
#   swayidle-mgr tail         follow the event log
#
# swayidle invokes `swayidle-mgr event idle-lock` when the timer fires (the
# driver below turns it into smart-lock). Do NOT re-add before-sleep, lock, or
# blank wiring here -- locking wedges in the security path, and the blank now
# rides swaylock (idle -> lock -> swaylock blank-after -> panel-power).
set -eu

# --- idle policy: single source of truth ------------------------------------
# An optional integrator config supplies policy (KEY=value, sourced): the
# timeouts below and the idle-SUSPEND seam. vigilance ships NONE -- it is pure
# mechanism; a provisioner drops an idle.conf to add policy like idle-suspend. A
# test sets the same vars via env (no conf present in its sandbox).
_conf=${SWAYIDLE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/vigilance/idle.conf}
[ -r "$_conf" ] && . "$_conf"

LOCK_TIMEOUT=${LOCK_TIMEOUT:-480}   # seconds idle before the lock
BLANK_DELAY=${BLANK_DELAY:-120}     # further seconds before peripherals go dark
# Idle-SUSPEND seam (OFF unless the integrator sets both). SUSPEND_TIMEOUT is
# seconds idle before SUSPEND_CMD runs; that command decides whether to ACTUALLY
# suspend (e.g. only on battery) and asks SYSTEMD -- crossing a real power
# transition is systemd's job, not vigilant's (the trust root must not compete
# to initiate it). Unset = no suspend timer, so vigilance alone never suspends.
SUSPEND_TIMEOUT=${SUSPEND_TIMEOUT:-}
SUSPEND_CMD=${SUSPEND_CMD:-}
BIN=$HOME/.local/bin
# The idle lock goes through VIGILANT, not a locker directly: crossing the
# `lock` edge is what fires lock.d (whose provider brings swaylock up), records
# the depth, and lets the block hooks have a say. Pointing this at a locker
# would lock the screen with the record never knowing.
#
# It said $BIN/smart-lock until now, which smart-lock's retirement deleted. The
# 480s idle lock has therefore been silently failing: the screen still locked,
# but only at 600s when the blank timer's `go sleep` traversed open -> lock ->
# sleep and crossed the lock edge on its way past. Two minutes late, by
# accident, via the wrong timer.
# Overridable, so a test never locks a real screen.
LOCK_CMD=${LOCK_CMD:-$BIN/vigilant go lock}
# The peripherals now ride VIGILANT, not swaylock. The patched swaylock used
# to fork $HOME/bin/panel-power on its own blank-after timer; that path went
# stale when vigilance extracted panel-power to ~/.local/bin, the execl failed,
# and `_exit(127)` swallowed it -- dead on two machines for weeks. The patch is
# retired (docs/framework-refactor.md 10.1) and the blank edge is an ordinary
# swayidle timer again, which the event log shows handled blank AND restore
# while locked for months before the patch existed.
VIGILANT_CMD=${VIGILANT_CMD:-$BIN/vigilant}

# --- paths ------------------------------------------------------------------
RUNDIR=${XDG_RUNTIME_DIR:-/tmp}/swayidle-mgr
LOGDIR=${SWAYIDLE_LOG_DIR:-$HOME/.local/state/swayidle-mgr}
EVENT_LOG=$LOGDIR/events.log
STATE=$RUNDIR/last-idle-lock

# SDDM-started sessions can bypass systemd --user, leaving a thin PATH so a bare
# pkill inside panel-power fails. Pin a known-good PATH regardless of launch.
PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$HOME/bin
export PATH

# Absolute path to this script, so swayidle's sh -c can re-invoke us regardless
# of the session PATH.
SELF=$(command -v "$0" 2>/dev/null || true)
case "$SELF" in
  /*) ;;
  *) SELF=$HOME/.local/bin/swayidle-mgr ;;
esac

ts() { date +%Y-%m-%dT%H:%M:%S.%N; }
log() { printf '%s %s\n' "$(ts)" "$*" >> "$EVENT_LOG"; }

need_session() {
  : "${WAYLAND_DISPLAY:?not in a wayland session (WAYLAND_DISPLAY unset)}"
  : "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR unset}"
}

# --- what swayidle calls when the idle-lock timer fires ---------------------
# Only idle-lock. The screen BLANK is NOT here: it lives inside swaylock (its
# blank-after option, presence-aware and idle-inhibit-proof), which fires
# panel-power via its peripherals hook AFTER the lock. Blanking an unlocked
# screen would be a security hole, so the blank is deliberately gated behind
# the lock, never an independent swayidle timer.
cmd_event() {
  kind=${1:?event kind required}
  now=$(date +%s)
  case "$kind" in
    idle-lock)
      prev=$(cat "$STATE" 2>/dev/null || echo 0)
      case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
      printf '%s\n' "$now" > "$STATE"
      log "idle-lock delta=$((now - prev))s"
      # VIGILANCE_SOURCE is what lets the phantom guard scope itself to the
      # idle path and never suppress a lid close or a suspend. Without it the
      # guard is inert: it allows everything, because it only ever blocks
      # `idle`. LOCK_SOURCE is kept for any old consumer.
      export LOCK_SOURCE=idle VIGILANCE_SOURCE=idle
      # Deliberately NOT quoted: LOCK_CMD carries arguments (`vigilant go
      # lock`), and a test overrides it with its own command plus args.
      # shellcheck disable=SC2086
      exec $LOCK_CMD
      ;;
    *)
      echo "swayidle-mgr: unknown event '$kind'" >&2
      exit 1
      ;;
  esac
}

# --- lifecycle --------------------------------------------------------------
cmd_stop() {
  quiet=${1:-}
  pkill -x swayidle 2>/dev/null || true
  [ "$quiet" = quiet ] || log stop
}

# The foreground worker. Detached by cmd_start, or run inline via  start -f .
_run() {
  set -- -w
  # SWAYIDLE_DEBUG=1 adds -d: swayidle's trace of idle/active/Register/timeout
  # events into the worker's stdio log, to root-cause a phantom-relock storm.
  # Opt-in, OFF by default -- normal behaviour is unchanged.
  [ -n "${SWAYIDLE_DEBUG:-}" ] && set -- "$@" -d
  set -- "$@" timeout "$LOCK_TIMEOUT" "$SELF event idle-lock"
  # The blank edge, BLANK_DELAY after the lock. Two separate timers rather than
  # one chained action: swayidle measures both from last input, so the blank
  # fires at LOCK_TIMEOUT+BLANK_DELAY of continuous idleness and is skipped
  # entirely if the user returns in between.
  #
  # `resume` fires on the next input and restores. It is deliberately `go
  # lock`, not `go open`: coming back from dark must light the screen WITHOUT
  # unlocking the session.
  if [ -x "$VIGILANT_CMD" ]; then
    set -- "$@" timeout "$((LOCK_TIMEOUT + BLANK_DELAY))" \
      "$VIGILANT_CMD go sleep"
    set -- "$@" resume "$VIGILANT_CMD go lock"
  fi
  # Optional idle-suspend, supplied by the integrator (OFF by default). Its CMD
  # gates the actual suspend (e.g. battery-only) and asks systemd. Measured from
  # last input like every timer, so a returning user cancels it too.
  if [ -n "$SUSPEND_TIMEOUT" ] && [ -n "$SUSPEND_CMD" ]; then
    set -- "$@" timeout "$SUSPEND_TIMEOUT" "$SUSPEND_CMD"
  fi
  exec swayidle "$@"
}

cmd_start() {
  fg=0
  case "${1:-}" in -f|--foreground) fg=1 ;; esac
  need_session
  mkdir -p "$RUNDIR" "$LOGDIR"
  cmd_stop quiet
  log "start foreground=$fg"
  if [ "$fg" = 1 ]; then
    _run
  else
    # setsid: own session so the launching shell (the Wayfire autostart) exiting
    # does not SIGHUP it. Detached, so the caller returns at once.
    setsid "$SELF" _run </dev/null >> "$LOGDIR/stdio.log" 2>&1 &
    log "detached (launcher pid=$!)"
  fi
}

cmd_status() {
  if pgrep -x swayidle >/dev/null 2>&1; then
    echo "swayidle: running"
    ps -o pid,ppid,lstart,args -C swayidle 2>/dev/null
  else
    echo "swayidle: not running"
  fi
  [ -f "$STATE" ] && echo "last idle-lock epoch: $(cat "$STATE")" || true
}

# --- dispatch ---------------------------------------------------------------
mkdir -p "$RUNDIR" "$LOGDIR"
sub=${1:-}
[ "$#" -gt 0 ] && shift || true
case "$sub" in
  start) cmd_start "$@" ;;
  _run) _run ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start "$@" ;;
  status) cmd_status ;;
  tail) exec tail -f "$EVENT_LOG" ;;
  event) cmd_event "$@" ;;
  *)
    echo "swayidle-mgr: unknown command '$sub'" >&2
    echo "usage: start [-f]|stop|restart|status|tail|event <kind>" >&2
    exit 1
    ;;
esac
