#!/bin/sh
# vigilant -- cross an edge, and be vigilant that it took effect.
#
# vigilance's two pillars, in one command: make sure ALL the things go dark
# when they should, and make sure the mechanism that does it is WORKING. See
# docs/framework-refactor.md for the model this implements.
#
# FIXED VERBS, and the ARGUMENT IS THE STATE. The verb set is closed, so a new
# rung can never collide with a command name (which edge-as-verb could not
# promise):
#
#   vigilant go <state>       traverse to state, respecting the ladder
#   vigilant force <state>    assert state, ignoring the recorded depth
#   vigilant only <state>     cross ONE edge into state, no traversal
#   vigilant status           where we are, and where hooks live
#   vigilant verify [edge]    run reverse hooks; assert reality
#   vigilant hooks [edge]     what would run, in order, resolved
#   vigilant report           does reality match what we believe?
#   vigilant rescue           record everything, then recover
#   vigilant due [edge]       when SHOULD this edge have fired?
#   vigilant enforce          the supervision loop, for a timer
#   vigilant audit            did past events produce the edges they should?
#
# THERE IS NO `vigilant check`, deliberately. The wiring audit is `setup.sh
# check`, which is the only thing that knows PREFIX, the dependency list and
# the plugin tree it installed; a second implementation here would be the same
# fact in two places, which is the failure mode this project keeps finding.
#
# It used to exist as a stub aliased to `status` with a "stage 4 replaces this"
# comment, while three documents described it as a wiring audit. A command that
# silently answers a DIFFERENT question than its documentation is worse than a
# missing one: the missing one fails loudly. It now fails loudly, and says where
# the real audit lives.
#
# THE LADDER, one dimension: how far the machine has WITHDRAWN. Present tense
# throughout, so a state names a condition the machine is IN, never something
# that already happened to it:
#
#   open     fully here; unlocked and lit
#   lock     session secured; the screen is still lit
#   sleep    peripherals down (DDC standby, backlights 0, LEDs off)
#   suspend  machine in S3/hibernate
#
# `go` is DECLARATIVE: say where you want to be and every edge in between is
# crossed. So `go suspend` from `lock` fires sleep.d AND suspend.d, which is
# why suspending now actually powers the monitor down instead of leaving it
# lit. There is no minimum-rung special case; you simply cannot skip a rung.
#
# SEVEN HOOK KINDS, and vigilant hardcodes NO mechanism in any of them. It
# knows nothing of logind, swayidle, swaylock or systemd; each is a hook that
# binds vigilance to one environment. That is the whole point of the split:
#
#   <edge>.d          DO it        actuators (drive the hardware)
#   <edge>.verify.d   CHECK it     did the edge actually take effect
#   <edge>.report.d   TELL         announce the change outward (logind's
#                                  SetLockedHint, a bar, an indicator)
#   <edge>.due.d      WHEN         when SHOULD this edge have fired? The
#                                  timeout lives outside vigilant, so a hook
#                                  reads it (swaylock.conf, a swayidle timer)
#   <edge>.block.d    WHY NOT      is something legitimately preventing it
#                                  (an idle inhibitor, a spurious re-fire)?
#                                  Runs BEFORE the depth is committed, so a
#                                  blocked edge changes NOTHING (exit 3).
#                                  Exit 10 = BLOCK, anything else = allow.
#                                  FAIL OPEN by design: a broken block hook
#                                  must never be able to suppress a LOCK, so
#                                  only an explicit 10 blocks. Suppressing a
#                                  lock is a security failure; allowing a
#                                  redundant one is merely noise.
#   audit.d           DID IT       read an external event source and report
#                                  events that SHOULD have produced an edge.
#                                  Forensic, not live: the only kind that can
#                                  see an event which produced no edge at all.
#                                  NOT per-edge, like alert: the hook NAMES the
#                                  edge in its output, because one source (a
#                                  journal) reports events for several edges.
#   alert.d           SHOUT        tell the HUMAN something needed attention.
#                                  NOT per-edge: it is cross-cutting, raised
#                                  by vigilant itself
#
# THE THREE QUESTIONS, which is why verify/due/audit are separate kinds and not
# one cleverer kind. They differ in TENSE, and none can answer another:
#
#   verify  NOW   does the hardware match the rung we believe we are at?
#   due     SOON  is an edge pending and past its deadline?
#   audit   PAST  did an event that already happened produce its edge?
#
# LOG vs ALERT, deliberately different: the LOG is vigilant's own record and is
# built in, because a supervisor that only records when an integrator wires
# something up is not a supervisor. Alerting a human is POLICY (a toast, a bar,
# an intervention flag), so it is a hook and vigilant assumes no mechanism.
#
# `due` and `block` are read INWARD from the environment; `report` is written
# OUTWARD to it. Both directions are hooks, so playing nice with a stock
# mechanism never means hardcoding an assumption about which mechanism it is.
#
# EDGES are the transitions between rungs, and hooks are keyed by them. A
# DESCENT edge shares its name with the state it enters; only the ascent needs
# words of its own:
#
#   open -> lock     lock        lock -> open     unlock
#   lock -> sleep    sleep       sleep -> lock    wake
#   sleep -> suspend suspend     suspend -> sleep resume
#
# Ascent is NOT the descent reversed. Leaving `sleep` the saved state is valid,
# so a hook restores it; leaving `suspend` USB re-enumerated and a QMK board
# forgot everything, so the saved state is STALE and the hook must re-assert
# from config. Same hook, same direction, different correct behaviour, which is
# why the runner passes the rung being LEFT as $2/FROM.
#
# HARD CONSTRAINT: `go suspend` does NOT suspend. It fires the hooks for that
# edge, invoked BY the unit ordered Before=sleep.target. systemd stays the
# actuator; vigilant only crosses edges. The moment this initiates a power
# transition it competes with the trust root instead of riding it.
#
# EXIT CODES are a contract, because units and the patch branch on them:
#   0  ok, including a no-op
#   1  crossed, but one or more hooks FAILED (degraded, but we did move)
#   2  usage error
#   3  refused: a precondition was not met and NOTHING happened
set -eu

PKG=vigilant

# HOME is NOT guaranteed. A login shell has it; a systemd unit with no User=,
# a sleep hook under /lib/systemd/system-sleep, and cloud-init's runcmd do not,
# and under `set -u` an unset HOME is a hard exit 2 before anything runs. Since
# every edge crossing is invoked from exactly those contexts, derive it from
# the passwd database rather than assume it, and fail LOUDLY if even that
# cannot answer. (Caught by test/vm/run on its first boot.)
if [ -z "${HOME:-}" ]; then
  HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)
  if [ -z "$HOME" ]; then
    echo "$PKG: HOME unset and not derivable from passwd" >&2
    exit 1
  fi
  export HOME
fi

_cfg=${XDG_CONFIG_HOME:-$HOME/.config}

# TWO SCOPES, because peripherals belong to the MACHINE and locking, audio and
# notifications belong to a USER.
#
#   machine  /etc/vigilance/hooks      root-owned, EVERY session
#   user     ~/.config/vigilance/hooks user-owned, no sudo ever
#
# This is what lets a greeter session work with no configuration of its own: it
# simply has no user root, so it gets the machine hooks and nothing else. The
# alternative (one shared tree) would need per-session filtering, which pushes
# session-awareness into the mechanism, and a greeter cannot read an encrypted
# user home anyway.
#
# ORDERING: machine is the LOWER LAYER, so it comes up first and goes down
# last, exactly as systemd orders units. Dependencies point user -> machine and
# never the reverse: a USB DAC powered down by a machine hook must be back
# before a user hook tries to unmute it by name.
#
#   descent  user 10->90, then machine 10->90
#   ascent   machine 90->10, then user 90->10
MACHINE_HOOK_ROOT=${VIGILANCE_MACHINE_HOOKS:-/etc/vigilance/hooks}
HOOK_ROOT=${VIGILANCE_HOOK_ROOT:-$_cfg/vigilance/hooks}
# Runtime state. XDG_RUNTIME_DIR survives suspend and hibernate but NOT a
# reboot, which is exactly right: a boot means we are at the top of the ladder.
RUN_DIR=${VIGILANCE_RUN_DIR:-${XDG_RUNTIME_DIR:-/tmp}/vigilance}
DEPTH_FILE=$RUN_DIR/depth
STATE_ROOT=$RUN_DIR/state

LADDER='open lock sleep suspend'           # shallowest first

# GRACE: how far past a declared deadline an edge must be before supervision
# calls it overdue. It exists so the PRIMARY mechanism wins the race in the
# normal case -- vigilant is the backstop, not the timer, and acting on a tie
# would make it compete with the thing it is supervising.
GRACE=${VIGILANCE_GRACE:-30}

# vigilant's OWN record. Built in and mechanism-free (it is a file), because
# the whole charter is noticing when something silently did not happen, and a
# record that depends on an integrator wiring it up would be the first thing
# missing. stderr goes to the journal under a unit but NOWHERE under a
# keybind, which is exactly when we most want the trail.
LOG_FILE=${VIGILANCE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/vigilance.log}

_log() {   # message
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$LOG_FILE" \
    2>/dev/null || true
}

log() { printf '%s: %s\n' "$PKG" "$*" >&2; _log "$*"; }

# PROVENANCE travels in the ENVIRONMENT, never in argv: `vigilant go lock`
# takes no arguments by contract, and depth stays the only authoritative
# state. VIGILANCE_SOURCE says WHO asked (idle, logind, lid, manual, suspend),
# which block hooks need and vigilant itself deliberately ignores.
#
# It is safety-critical that this stays hook policy. smart-lock debounced ONLY
# the idle path and never suspend/manual/Session.Lock, because gating the
# suspend path would sleep the box UNLOCKED. That distinction lives in the
# hook, which is the only thing that knows what a source means.
_blocked() {   # edge from -> 0 if an explicit block was raised
  _bl=$(_hooks_for "$1" .block)
  if [ -z "$_bl" ]; then return 1; fi
  _hit=1
  while IFS= read -r _bh; do
    if [ -z "$_bh" ]; then continue; fi
    _brc=0
    _why=$(VIGILANCE_EDGE="$1" VIGILANCE_FROM="$2" \
      "$_bh" "$1" "$2" 2>/dev/null) || _brc=$?
    case "$_brc" in
      10) log "BLOCKED $1 by $(basename "$_bh"): ${_why:-no reason given}"
          _hit=0 ;;
      0)  ;;
      *)  log "block hook $(basename "$_bh") errored (rc=$_brc); ALLOWING" ;;
    esac
  done <<EOF
$_bl
EOF
  return "$_hit"
}

# _alert <kind> <message>: something a HUMAN should know about. Logged always,
# then handed to alert.d so the integrator decides how to surface it (a
# desktop toast, an intervention flag, a bar indicator). A failing alerter can
# never affect the outcome it is reporting on, so failures here are swallowed
# after being logged: the machine's state must not depend on whether we
# managed to complain about it.
_alert() {   # kind message
  _log "ALERT [$1] $2"
  _al=$(_hooks_for alert)
  if [ -z "$_al" ]; then return 0; fi
  while IFS= read -r _ah; do
    if [ -z "$_ah" ]; then continue; fi
    VIGILANCE_ALERT_KIND="$1" VIGILANCE_ALERT_MSG="$2" \
      "$_ah" "$1" "$2" >/dev/null 2>&1 \
      || _log "  alert hook failed: $(basename "$_ah")"
  done <<EOF
$_al
EOF
}

# The edge crossed by moving between ADJACENT rungs.
#
# Descending is named for the rung ENTERED, so a descent edge and its target
# state share a name: `go sleep` crosses the `sleep` edge into the `sleep`
# state, running sleep.d. One word, not two, and _edge_down is therefore just
# the rung name.
#
# Ascending is named for the rung LEFT, because that is the distinction that
# matters: leaving `sleep` the saved state is valid (wake, restore it), leaving
# `suspend` it is stale (resume, re-assert instead). Those names cannot collide
# with state names, which is why the ascent keeps its own three words.
_edge_down() { _rung_at "$1"; }        # index of the rung being ENTERED
_edge_up() {                           # index of the rung being LEFT
  case "$1" in 3) echo resume ;; 2) echo wake ;; 1) echo unlock ;; esac
}

_is_descent() {   # edge
  case "$1" in lock|sleep|suspend) return 0 ;; *) return 1 ;; esac
}

# Only an ASCENT edge unwinds in reverse. Anything else (a descent, and the
# non-edge `alert` set) runs in plain ascending order.
_is_ascent() {   # edge
  case "$1" in unlock|wake|resume) return 0 ;; *) return 1 ;; esac
}

_depth_of() {   # rung -> integer, or non-zero if it is not a rung
  _i=0
  for _r in $LADDER; do
    if [ "$_r" = "$1" ]; then echo "$_i"; return 0; fi
    _i=$((_i + 1))
  done
  return 1
}

_rung_at() {   # integer -> rung
  _i=0
  for _r in $LADDER; do
    if [ "$_i" -eq "$1" ]; then echo "$_r"; return 0; fi
    _i=$((_i + 1))
  done
  return 1
}

# The depth file is "<rung> <epoch>": the rung, and WHEN it was entered.
# The timestamp is what makes supervision possible at all -- without it there
# is no deadline to compute for a `due` hook to be measured against. A legacy
# file holding only a rung reads back with epoch 0, which simply means "no
# deadline can be computed yet" rather than an error.
# A session may BEGIN at a rung rather than at the top. A greeter IS the locked
# state: there is no user session to protect, so it starts at `lock` and idles
# down to `sleep` from there.
#
# This is an INITIALISATION, not a crossing: no hooks fire, because nothing was
# traversed. Without it a greeter's `go sleep` would traverse open -> lock ->
# sleep and fire lock.d, whose provider would try to start a lock screen on top
# of a session that is already one.
_depth() {   # the current rung
  if [ -r "$DEPTH_FILE" ]; then
    cut -d' ' -f1 < "$DEPTH_FILE"
  else
    _init=${VIGILANCE_INITIAL_DEPTH:-open}
    if _depth_of "$_init" >/dev/null 2>&1; then
      echo "$_init"
    else
      log "ignoring bad VIGILANCE_INITIAL_DEPTH '$_init'; using 'open'"
      echo open
    fi
  fi
}

_depth_at() {   # epoch the current rung was entered, or 0
  # Guard on readability rather than redirecting stderr: a failed input
  # redirect is reported by the SHELL before a later 2>/dev/null can take
  # effect, so the error would leak to the terminal on a fresh run.
  if [ ! -r "$DEPTH_FILE" ]; then echo 0; return 0; fi
  _t=$(cut -d' ' -f2 < "$DEPTH_FILE" || true)
  case "${_t:-}" in ''|*[!0-9]*) echo 0 ;; *) echo "$_t" ;; esac
}

# ATOMIC REPLACE, because this file has several writers and a minutely reader.
#
# `> "$DEPTH_FILE"` TRUNCATES and only then writes, so a reader landing in that
# window gets an EMPTY file. Measured under contention, not theorised: 2 empty
# reads in 4000, reproducibly.
#
# An empty read is not a harmless blip. `_depth` returns nothing, `_depth_of ""`
# fails, and every caller does `_dfrom=$(_depth_of "$(_depth)") || _dfrom=0` --
# and 0 is `open`. So a reader concludes the machine is UNLOCKED while it is at
# `sleep`, and a traversal from that false start records `lock` while the
# peripherals stay dark with nothing armed to re-light them.
#
# Who races: the enforce timer reads this every minute forever, the audit timer
# daily, while Super+L, three swayidle timers, the suspend unit and the resume
# unit all write it. 1,440 attempts a day is not a rare event budget.
#
# A rename is atomic within one filesystem, so a reader sees the whole old value
# or the whole new one. The temp name carries the PID so two writers cannot
# clobber each other's partial file; the last rename wins, which is correct (a
# later crossing is a later truth) and is never TORN.
_set_depth() {   # rung
  _sd_tmp=$DEPTH_FILE.$$
  if printf '%s %s\n' "$1" "$(date +%s)" > "$_sd_tmp" \
     && mv -f "$_sd_tmp" "$DEPTH_FILE"; then
    return 0
  fi
  rm -f "$_sd_tmp" 2>/dev/null || true
  log "could not record depth '$1' at $DEPTH_FILE"
  return 1
}

# --- hook enumeration -------------------------------------------------------
# Descent runs ascending (10 -> 90); ascent runs descending (90 -> 10), so a
# restore unwinds in the reverse order it wound down. Only executables count,
# which is the same contract smart-lock's lock-hooks already use.
# _hooks_in <root> <edge> <suffix> <asc|desc>: one root, ordered.
_hooks_in() {
  _hd=$1/$2$3.d
  if [ ! -d "$_hd" ]; then return 0; fi
  _hl=""
  for _hh in "$_hd"/*; do
    if [ -x "$_hh" ]; then _hl="$_hl$_hh
"; fi
  done
  if [ -z "$_hl" ]; then return 0; fi
  # Sort on the BASENAME so the numeric prefix orders within the scope,
  # independently of how long the root's path happens to be.
  if [ "$4" = desc ]; then
    printf '%s' "$_hl" | awk -F/ '{print $NF"\t"$0}' | sort -r | cut -f2-
  else
    printf '%s' "$_hl" | awk -F/ '{print $NF"\t"$0}' | sort | cut -f2-
  fi
}

_hooks_for() {   # edge [suffix]
  if _is_ascent "$1"; then
    # Coming UP: the lower layer first, each scope unwinding its own order.
    _hooks_in "$MACHINE_HOOK_ROOT" "$1" "${2:-}" desc
    _hooks_in "$HOOK_ROOT" "$1" "${2:-}" desc
  elif [ "$1" = alert ] || [ "$1" = audit ]; then
    # NEITHER IS A LADDER EDGE, so say so explicitly rather than letting them
    # fall through to the descent branch and be ordered as if they were one.
    # `audit` landed in that branch by accident; the order it produced happened
    # to be the same, which is exactly why it went unnoticed.
    #
    # Machine first so the always-available journal sink records BEFORE any user
    # sink that might be slow or absent: the record must not be the part lost.
    _hooks_in "$MACHINE_HOOK_ROOT" "$1" "${2:-}" asc
    _hooks_in "$HOOK_ROOT" "$1" "${2:-}" asc
  else
    # Going DOWN: tear down the high layer first, leave the machine for last.
    _hooks_in "$HOOK_ROOT" "$1" "${2:-}" asc
    _hooks_in "$MACHINE_HOOK_ROOT" "$1" "${2:-}" asc
  fi
}

# --- crossing an edge -------------------------------------------------------
# Every hook gets the edge, the rung being left, and a state dir the runner
# creates for it. That state dir is what deletes the copy-pasted save-file
# logic panel-power reimplemented three times over.
#
# A failing hook is LOUD and does NOT abort the rest: one dark monitor must not
# leave the keyboard lit. This is the direct fix for swaylock's `_exit(127)`,
# which was silent BY DESIGN and hid a dead hook on two machines for days.
#
# The read loop is fed by a here-doc, NOT a pipe: a pipeline would run it in a
# subshell and silently swallow the failure count, which is the same class of
# bug this whole command exists to stop.
# THE DARKNESS A RUNG IMPLIES, exported to every hook so nobody restates it.
#
# The mapping lives in hooklib.sh for the shipped plugins, but an INTEGRATOR
# hook needs the identical table and getting it wrong is invisible. tackup's
# kbd-rgb hand-rolled it, read `resume` as "coming back up, so light it", and
# put a lit keyboard over a dark screen -- in the same pass as ddc-monitor,
# which reads the real mapping and was powering the monitor down. Both hooks
# "succeeded".
#
# So the runner states it once. A hook that honours VIGILANCE_INTENT cannot fall
# through a stale `*)` case when the ladder grows a rung, and an integrator no
# longer has to locate a libexec path it does not own just to ask "dark or lit?"
_intent_of() {   # edge -> dark | lit | none
  case "$1" in
    sleep|suspend|resume) echo dark ;;
    wake)                 echo lit ;;
    lock|unlock)          echo lit ;;   # the rung is lit; only ACTING differs
    *)                    echo none ;;
  esac
}

# PATH FOR HOOKS, normalised because inheriting the caller's is a silent trap.
#
# vigilant runs from a keybind, a --user unit, a SYSTEM sleep unit and a greeter
# launcher, and those have four different PATHs. The system manager's is
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin -- no ~/.local/bin -- so a
# hook calling a user-installed command BY NAME finds nothing and, if it does
# not check, reports success. That is exactly how tackup's kbd-rgb no-opped on
# the suspend path while logging a clean crossing.
#
# The user bindir goes FIRST because that is where an integrator's own tools
# live, and the pkg installs vigilance's there too. A hook may still override
# PATH for itself; this only guarantees a sane floor rather than a lottery.
HOOK_PATH=${VIGILANCE_HOOK_PATH:-${XDG_BIN_HOME:-$HOME/.local/bin}:$HOME/bin:\
/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}

_run_hooks() {   # edge from [suffix]
  _edge=$1; _from=$2; _sfx=${3:-}
  _list=$(_hooks_for "$_edge" "$_sfx")
  if [ -z "$_list" ]; then return 0; fi
  _fails=0
  while IFS= read -r _h; do
    if [ -z "$_h" ]; then continue; fi
    _sd=$STATE_ROOT/$(basename "$_h")
    mkdir -p "$_sd"
    _hrc=0
    # VIGILANCE_KIND lets ONE plugin serve several kinds: ddc-monitor drives
    # the monitor when act, and reads back VCP D6 when verify, sharing its bus
    # discovery instead of duplicating it in a second file. Without this a hook
    # cannot tell "do it" from "check it": the edge is `sleep` either way.
    VIGILANCE_EDGE="$_edge" VIGILANCE_FROM="$_from" \
      VIGILANCE_SOURCE="${VIGILANCE_SOURCE:-}" \
      VIGILANCE_KIND="$(printf '%s' "${_sfx:-.act}" | tr -d .)" \
      VIGILANCE_INTENT="$(_intent_of "$_edge")" \
      PATH="$HOOK_PATH" \
      VIGILANCE_STATE_DIR="$_sd" "$_h" "$_edge" "$_from" || _hrc=$?
    if [ "$_hrc" -ne 0 ]; then
      log "HOOK FAILED (rc=$_hrc): $_edge$_sfx $(basename "$_h")"
      _fails=$((_fails + 1))
      # An ACTUATOR or VERIFY failure means the machine may not be in the
      # state we believe: a monitor that did not sleep, a check that did not
      # confirm. That is worth a human's attention. A REPORT failure is not:
      # nobody was told, but the machine is fine, and alerting on it would
      # train the human to ignore alerts.
      case "$_sfx" in
        .report) ;;
        *) _alert hook-failed \
             "$_edge$_sfx hook $(basename "$_h") failed (rc=$_hrc)" ;;
      esac
    fi
  done <<EOF
$_list
EOF
  if [ "$_fails" -gt 0 ]; then return 1; fi
  return 0
}

# go/force: traverse to a target rung, crossing EVERY edge in between.
#
# Declarative by design. The caller says where the machine should BE, not which
# transition to perform, so no caller has to know the ladder's shape or
# sequence its own steps. `force` differs only in that it does not trust the
# recorded depth: it starts from the far end, so every hook needed to reach the
# target runs. That is the drift-recovery path, for when reality and the depth
# file have diverged.
#
# Depth is committed BEFORE the hooks run, and per step. A hook that fails must
# not leave the recorded rung lying about where the machine is, because the
# ascent reads it to decide restore-versus-re-assert.
# `only` is the single-edge form: cross exactly the one edge that ENTERS the
# target, skipping every rung in between. Direction comes from the current
# depth (deeper target -> the descent edge, shallower -> the ascent edge), so
# it stays symmetric and `only` can reach wake/resume as well as the descent
# edges. Like `force` it ignores the ladder's no-skipping rule.
#
# It still COMMITS the depth. A hook that changed hardware without the record
# following is precisely the desync that left a monitor dark for two days, so
# there is no "run the hooks but pretend nothing happened" mode.
# ONE EDGE, crossed properly: ask, commit, act, announce -- in that order and in
# ONE place. `only` and the traversal loop both need this exact sequence and
# each carried its own copy: two places to get a safety-critical ORDER right.
#
# The order IS the contract:
#   1. BLOCK is asked first, before anything is committed, so a refusal changes
#      nothing at all (exit 3 means the machine did not move).
#   2. DEPTH is committed before the actuators run, so a hook that fails cannot
#      leave the record lying about where the machine is -- the ascent reads
#      that record to decide restore-versus-re-assert.
#   3. REPORT runs after the actuators, so a reporter announces what is now TRUE
#      rather than what was intended.
#
# Returns the command contract's own codes (3 blocked, 1 a hook failed, 0 ok) so
# a caller just propagates rather than re-deriving them.
_cross_one() {   # edge leaving to [note]
  if _blocked "$1" "$2"; then
    _log "refused $1: $2 (blocked)"
    return 3
  fi
  # DELIBERATELY TOLERANT. A function returning non-zero aborts its caller
  # under set -e, and aborting here would mean a failure to WRITE A FILE
  # suppressed the LOCK. Suppressing a lock is a security failure; a wrong
  # record is only a reporting one, and _set_depth already logs it.
  _set_depth "$3" || true
  _log "cross $1: $2 -> $3${4:+ ($4)}"
  _crc=0
  _run_hooks "$1" "$2" || _crc=1
  # A reporting failure is loud in the log but does NOT change the exit status:
  # the non-zero codes mean "the machine is not where you asked", and failing to
  # tell logind is not that. A unit must not restart or alarm because a bar was
  # busy.
  _run_hooks "$1" "$2" .report || true
  return "$_crc"
}

cmd_go() {   # <state> [force|only]
  _to=$1
  _mode=${2:-}
  _forced=
  case "$_mode" in force) _forced=1 ;; esac
  if ! _dto=$(_depth_of "$_to"); then
    log "unknown state '$_to' (want: $LADDER)"
    return 2
  fi
  mkdir -p "$RUN_DIR" "$STATE_ROOT"

  if [ "$_mode" = only ]; then
    _dfrom=$(_depth_of "$(_depth)") || _dfrom=0
    if [ "$_dfrom" -eq "$_dto" ]; then
      log "already at '$_to'; nothing to do"
      return 0
    fi
    # One step, in the direction of the target, regardless of distance.
    if [ "$_dfrom" -lt "$_dto" ]; then _edge=$(_edge_down "$_dto")
    else _edge=$(_edge_up "$((_dto + 1))"); fi
    _cross_one "$_edge" "$(_depth)" "$_to" only
    return $?
  fi

  if [ -n "$_forced" ]; then
    # Assume the far end, so every edge toward the target is crossed. For a
    # MIDDLE rung this ascends into it (force sleep fires `resume`), which is
    # the right edge for recovery: resume's whole job is to re-assert dark
    # WITHOUT trusting saved state. The cost is that forcing into a middle rung
    # can flicker (re-assert dark, then light up). Acceptable, because force is
    # the rare drift-recovery path; the display keybind uses `go lock`, an
    # ordinary ascent, and never flickers.
    _dfrom=3
    if [ "$_dto" -ge 3 ]; then _dfrom=0; fi
  else
    _dfrom=$(_depth_of "$(_depth)") || _dfrom=0
  fi

  if [ "$_dfrom" -eq "$_dto" ]; then
    log "already at '$_to'; nothing to do"
    return 0
  fi

  _rc=0
  _i=$_dfrom
  while [ "$_i" -ne "$_dto" ]; do
    _leaving=$(_rung_at "$_i")
    if [ "$_i" -lt "$_dto" ]; then
      _i=$((_i + 1)); _edge=$(_edge_down "$_i")
    else
      _edge=$(_edge_up "$_i"); _i=$((_i - 1))
    fi
    # A BLOCK ABORTS THE WHOLE TRAVERSAL, not just this step. Carrying on to the
    # next rung would skip the refused edge's hooks while still committing its
    # depth, leaving the record claiming a rung whose actuators never ran.
    _src=0
    _cross_one "$_edge" "$_leaving" "$(_rung_at "$_i")" \
      "${_forced:+forced}" || _src=$?
    if [ "$_src" = 3 ]; then return 3; fi
    if [ "$_src" != 0 ]; then _rc=1; fi
  done
  return "$_rc"
}

cmd_status() {
  _at=$(_depth_at)
  if [ "$_at" -gt 0 ]; then _since="$(( $(date +%s) - _at ))s ago"
  else _since="unknown"; fi
  echo "depth: $(_depth)"
  echo "since: $_since"
  echo "hooks: $HOOK_ROOT (user)"
  echo "       $MACHINE_HOOK_ROOT (machine)"
  echo "state: $RUN_DIR"
}

# An INSPECTABLE config is the antidote to silent misconfiguration, which is
# the class every failure in this cycle belonged to. Every KIND is listed, so
# a missing reporter or a mis-parked due hook is visible without guessing.
# THE PER-EDGE KINDS. `.audit` is deliberately NOT here, and neither is alert:
# both are CROSS-CUTTING and live at the top of a scope, not under an edge. See
# _hooks_cross below for why, and for the bug that listing `.audit` here caused.
KINDS=". .verify .report .due .block"

# CROSS-CUTTING TIERS, which were invisible to this command entirely.
#
# `audit.d` and `alert.d` are not keyed by edge. An audit hook NAMES the edge in
# its output (one journal source reports events for several different edges),
# and an alert is not about a single edge at all.
#
# THE BUG THIS FIXES WAS IN BOTH DIRECTIONS AT ONCE. `.audit` was in KINDS, so
# `hooks` looked in `<edge>.audit.d` and cheerfully reported a hook there as
# wired -- while cmd_audit reads plain `audit.d` and would never run it. And the
# real, working `audit.d` hook on the live box was reported by `hooks` as not
# existing. So the inspector and the runner disagreed about where this tier
# lives, in the one command whose entire purpose is showing what is wired, which
# is the worst possible place for an asserted-versus-actual split.
#
# Listing them under every edge would be a lie; listing them nowhere hid two
# whole tiers. So they get their own section.
_hooks_cross() {
  for _ck in audit alert; do
    echo "$_ck.d:"
    _cl=$(_hooks_for "$_ck")
    if [ -z "$_cl" ]; then echo "  (none)"; continue; fi
    printf '%s\n' "$_cl" | while IFS= read -r _ch; do
      if [ -z "$_ch" ]; then continue; fi
      case "$_ch" in
        "$MACHINE_HOOK_ROOT"/*) _cs=machine ;;
        *) _cs=user ;;
      esac
      echo "  $(basename "$_ch") [$_cs] -> $_ch"
    done
  done
}
# WIRED BUT WILL NOT RUN, which _hooks_in cannot express. That function lists a
# hook only `if [ -x "$_hh" ]`, the right filter for RUNNING and a terrible one
# for REPORTING: an entry present and not executable becomes indistinguishable
# from one that was never wired at all.
#
# Three faults land in that blind spot, and every one of them is silent:
#
#   unreachable target  a MACHINE-scope hook symlinked into a user's home. The
#                       home is 0750 with other:---, so for the GREETER's uid
#                       `[ -x ]` is simply false and six wired kbd-rgb hooks do
#                       not EXIST from its side. No log, no alert, no warning.
#                       Measured on this box 2026-09-14.
#   dangling symlink    the target moved, or a sweep removed it.
#   forgotten chmod     an integrator's own hook, wired and never made +x.
#
# All three mean "declared, and it will not fire", which is precisely the class
# this suite exists to surface. So they are NAMED rather than filtered away.
_hooks_blocked() {   # <root> <edge> <suffix> -> entries present but unrunnable
  _bd=$1/$2$3.d
  if [ ! -d "$_bd" ]; then return 0; fi
  for _bh in "$_bd"/*; do
    # An unmatched glob yields the pattern itself, which fails -e. A DANGLING
    # symlink fails -e too, so -L is asked as well: otherwise the commonest
    # fault here would be the one this missed.
    if [ ! -e "$_bh" ] && [ ! -L "$_bh" ]; then continue; fi
    # `if`, not `[ -x ] && continue`: under set -e an AND-list whose test FAILS
    # returns non-zero and would abort the caller mid-listing.
    if [ -x "$_bh" ]; then continue; fi
    printf '%s\n' "$_bh"
  done
  return 0
}

# Every blocked entry, across both scopes, all edges and kinds, including the
# cross-cutting tiers. cmd_hooks marks them inline; report counts them.
_blocked_all() {
  for _ba_e in lock sleep suspend unlock wake resume; do
    for _ba_k in $KINDS; do
      case "$_ba_k" in .) _ba_s= ;; *) _ba_s=$_ba_k ;; esac
      _hooks_blocked "$HOOK_ROOT" "$_ba_e" "$_ba_s"
      _hooks_blocked "$MACHINE_HOOK_ROOT" "$_ba_e" "$_ba_s"
    done
  done
  for _ba_c in audit alert; do
    _hooks_blocked "$HOOK_ROOT" "$_ba_c" ""
    _hooks_blocked "$MACHINE_HOOK_ROOT" "$_ba_c" ""
  done
  return 0
}

cmd_hooks() {   # [edge]
  for _e in ${1:-lock sleep suspend unlock wake resume}; do
    echo "$_e:"
    _any=0
    for _k in $KINDS; do
      case "$_k" in .) _sfx= ; _lbl= ;; *) _sfx=$_k; _lbl="[${_k#.}] " ;; esac
      _l=$(_hooks_for "$_e" "$_sfx")
      _bl=$(_hooks_blocked "$HOOK_ROOT" "$_e" "$_sfx"
            _hooks_blocked "$MACHINE_HOOK_ROOT" "$_e" "$_sfx")
      if [ -z "$_l" ] && [ -z "$_bl" ]; then continue; fi
      _any=1
      printf '%s\n' "$_l" | while IFS= read -r _h; do
        if [ -z "$_h" ]; then continue; fi
        case "$_h" in
          "$MACHINE_HOOK_ROOT"/*) _scope=machine ;;
          *) _scope=user ;;
        esac
        echo "  $_lbl$(basename "$_h") [$_scope] -> $_h"
      done
      # BLOCKED entries are listed too, and marked. Omitting them is what made
      # "wired but unrunnable" read identically to "not wired at all".
      printf '%s\n' "$_bl" | while IFS= read -r _h; do
        if [ -z "$_h" ]; then continue; fi
        case "$_h" in
          "$MACHINE_HOOK_ROOT"/*) _scope=machine ;;
          *) _scope=user ;;
        esac
        echo "  $_lbl$(basename "$_h") [$_scope] BLOCKED -> $_h (present but"\
" not executable from this session; it will NOT run)"
      done
    done
    if [ "$_any" = 0 ]; then echo "  (none)"; fi
  done
  # Only when listing EVERYTHING. `hooks lock` asks about one edge, and the
  # cross-cutting tiers are not that edge's wiring.
  if [ -z "${1:-}" ]; then _hooks_cross; fi
}

# verify: the REVERSE hooks. For every hook that acts, an optional paired hook
# asserting it took effect. This is the SHARED ORACLE: the test suite and the
# production watchdog call the same predicate, so they cannot drift apart about
# what "correct" means. A verify hook written for one improves both.
# THE SHARED ORACLE. Also the place a false green is most dangerous: an empty
# verify tier used to return 0, so "verify clean" meant "nothing was asked" and
# read exactly like "everything checked out". That is the failure this project
# exists to catch, reproduced inside the thing built to catch it.
#
# So an empty tier reports n/a EXPLICITLY. Exit stays 0 (a box with no verify
# hooks is not broken, and a timer must not alarm), but no caller can mistake
# it for a pass.
# The edge whose intent describes a rung. Verifying is asking "does the
# hardware match the rung we believe we are at", so the relevant assertion is
# the one belonging to the state we are IN.
#
#   open -> unlock (lit)   lock -> lock (lit)
#   sleep -> sleep (dark)  suspend -> suspend (dark)
_verify_edge_for() {   # rung
  case "$1" in
    open) echo unlock ;;
    *)    echo "$1" ;;
  esac
}

cmd_verify() {   # [edge]
  mkdir -p "$RUN_DIR" "$STATE_ROOT"
  _from=$(_depth)
  _vrc=0
  _ran=0
  # Default to the CURRENT rung, not every edge. Checking them all asserts
  # mutually exclusive things at once: at `open` it demanded the monitor be
  # BOTH lit (unlock) and dark (sleep), so a healthy awake machine reported
  # drift and raised an alert. A verifier that cries wolf on a correct machine
  # is worse than none, because it trains you to ignore the real one.
  for _e in ${1:-$(_verify_edge_for "$_from")}; do
    if [ -n "$(_hooks_for "$_e" .verify)" ]; then
      _ran=1
      if _run_hooks "$_e" "$_from" .verify; then
        echo "verify $_e: ok"
      else
        echo "verify $_e: FAIL"
        _vrc=1
      fi
    fi
  done
  if [ "$_ran" = 0 ]; then
    # NAME the edge. "no verify hooks installed" sent vigilance-report to a
    # flat [FAIL] on a machine that had three of them wired -- they were just
    # on other edges than the one this rung asks about. An honest n/a has to
    # say WHICH question went unanswered, or the next layer up mis-reports it.
    echo "verify: n/a (no verify hooks for edge" \
"'${1:-$(_verify_edge_for "$_from")}'; nothing was checked)"
  fi
  return "$_vrc"
}

# --- report: does reality match what we believe? ----------------------------
# A DIFFERENT QUESTION from an integrator's `check`, and both are needed. check
# asks "is the wiring canonical" (declared config vs installed config); this
# asks "is the machine doing what the record says" (recorded state vs the
# hardware). Every bug in this project has lived in the second gap, and it is
# the one nobody can see on a headless box.
#
# Absorbed from tackup's vigilance-report, because none of it was tackup's: the
# depth file, the hooks, the units and the ladder are all vigilance's own, and
# a host had been reimplementing knowledge of them from outside.
#
# The marker vocabulary is setup.sh's contract, unchanged: plain [OK]/[FAIL]/
# [WARN]/[--] that an integrator styles.
#
# The sysfs roots are OVERRIDABLE for one reason: otherwise report is untestable
# without the developer's own hardware answering. A scenario that reads
# /sys/class/backlight asserts on whatever the laptop happens to be doing, and
# this suite already learned where that leads -- a test that reached the real
# brightnessctl blacked out a live screen twice. Production never sets these.
SYS_BACKLIGHT=${VIGILANCE_SYS_BACKLIGHT:-/sys/class/backlight}
SYS_DRM=${VIGILANCE_SYS_DRM:-/sys/class/drm}
SYS_LEDS=${VIGILANCE_SYS_LEDS:-/sys/class/leds}

RRC=0
_r_ok()   { printf '  [OK]   %s\n' "$*"; }
_r_bad()  { printf '  [FAIL] %s\n' "$*"; RRC=1; }
_r_warn() { printf '  [WARN] %s\n' "$*"; }
_r_info() { printf '  [--]   %s\n' "$*"; }

# The graphical session, by logind's criteria rather than a pgrep. An ssh
# session is Class=user too, and a box with five of them has no display at all;
# reporting "swayidle NOT running" there is crying wolf, which trains you to
# ignore the line that matters. Session-scoped checks say n/a when absent.
# IS A LOCKER UP? Overridable for the same reason as the sysfs roots: without
# it a scenario's verdict depends on whether the DEVELOPER's screen happens to
# be locked while the suite runs. That is not a hypothetical -- it failed here
# exactly that way, reading a real swaylock from inside a sandbox.
_r_locker_up() {
  if [ -n "${VIGILANCE_LOCKER_UP+x}" ]; then
    [ "$VIGILANCE_LOCKER_UP" = 1 ]
    return $?
  fi
  pgrep -x "${VIGILANCE_LOCKER:-swaylock}" >/dev/null 2>&1
}

_r_session() {
  # Overridable so a scenario can exercise BOTH the session and no-session
  # paths. They behave differently (a fresh session makes the `open` default a
  # real claim; no session makes it a fiction), and without this the test would
  # assert whatever the developer's box happens to be doing -- the same reach
  # into the running system the sysfs roots are overridable to avoid.
  if [ -n "${VIGILANCE_SESSION+x}" ]; then printf '%s' "$VIGILANCE_SESSION"
    return 0
  fi
  loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}' \
    | while read -r _s; do
        [ -n "$_s" ] || continue
        eval "$(loginctl show-session "$_s" \
          -p Type -p Class -p State -p Seat 2>/dev/null)"
        case "${Type:-}:${Class:-}:${State:-}" in
          wayland:user:active|x11:user:active)
            [ -n "${Seat:-}" ] && { echo "$_s"; break; } ;;
        esac
      done
}

# THE SECTIONS, split out of what had grown to a 177-line cmd_report. Each
# answers ONE question, and they share the facts the first two establish
# ($_sess, $_rung, $_at, $_have_record) through globals rather than re-deriving
# them. That sharing is deliberate: probing the session or the depth in three
# places is how two halves of one report come to disagree with each other, and a
# self-contradicting report is worse than a terse one.
_rep_session() {
  echo "-- session --"
  _sess=$(_r_session)
  if [ -n "$_sess" ]; then _r_ok "graphical session $_sess active"
  else _r_warn "NO graphical session; session-scoped checks report n/a"; fi
}

_rep_state() {
  echo "-- recorded state --"
  # A DEFAULT IS NOT ALWAYS A CLAIM, and treating it as one cries wolf.
  #
  # _depth() answers `open` when no depth file exists. With a live session that
  # is a fair claim -- a fresh login genuinely IS open, and the runtime dir is
  # cleared on logout, so a just-logged-in box legitimately has no record yet.
  # With NO session it is a fiction.
  #
  # Caught on a real machine: nobody logged in, the greeter (a different user,
  # with its own runtime dir and its own depth file) had correctly put the
  # monitor into DDC standby, and this user had no record at all. Report took
  # the default `open`, asserted the screen must therefore be lit, and declared
  # FAIL over a machine doing exactly the right thing.
  #
  # So the claim is real when there is a record OR a session to which the
  # default applies. Otherwise there is nothing of ours to check.
  _at=$(_depth_at)
  _rung=$(_depth)
  _have_record=
  if [ "$_at" -gt 0 ]; then
    _r_info "depth=$_rung ($(( $(date +%s) - _at ))s ago)"
    _have_record=1
  elif [ -n "$_sess" ]; then
    _r_info "depth=$_rung (no record yet; a fresh session starts here)"
    _have_record=1
  else
    _r_info "depth: NO RECORD and no session of ours; asserting nothing about"\
" hardware another session may own"
  fi
  # OUTSTANDING SAVES are the sharpest signal here. A hook saves the level it
  # is about to dim FROM and deletes the file once restored, so one still
  # present at a LIT rung means a descent dimmed something the ascent never put
  # back: "the screen is dark and nothing will bring it back", on disk.
  _saves=
  for _f in "$STATE_ROOT"/*/*; do
    [ -f "$_f" ] || continue
    _saves="$_saves $(basename "$(dirname "$_f")")/$(basename "$_f")"
  done
  case "$_rung:$_saves" in
    *:  ) ;;
    open:*|lock:*) _r_bad "saved levels outstanding at a lit rung:$_saves" ;;
    *) _r_info "saved levels held (expected while dark):$_saves" ;;
  esac
}

_rep_hardware() {
  echo "-- hardware --"
  for _b in "$SYS_BACKLIGHT"/*; do
    [ -d "$_b" ] || continue
    _r_info "$(basename "$_b"): actual=$(cat "$_b/actual_brightness" \
2>/dev/null)/$(cat "$_b/max_brightness" 2>/dev/null)" \
"bl_power=$(cat "$_b/bl_power" 2>/dev/null)"
  done
  for _c in "$SYS_DRM"/card*-*; do
    [ -d "$_c" ] || continue
    [ "$(cat "$_c/status" 2>/dev/null)" = connected ] || continue
    _r_info "$(basename "$_c"): dpms=$(cat "$_c/dpms" 2>/dev/null)" \
"enabled=$(cat "$_c/enabled" 2>/dev/null)"
  done

}

# COHERENCE. Deliberately NOT a second DDC implementation: the monitor's real
# power state is ddc-monitor's question, and `verify` asks it through the hook.
# Reimplementing ddcutil here is how the same fact ends up in two
# places that can disagree.
_rep_coherence() {
  echo "-- coherence --"
  if [ -z "$_have_record" ]; then
    # Nothing to be coherent WITH. Both halves of the comparison must be real:
    # without a record there is only the hardware, and hardware alone is not
    # drift. Checking anyway is how a greeter-dimmed monitor read as a fault.
    _r_info "n/a: no depth record to compare the hardware against"
  else
  case "$_rung" in
    sleep|suspend)
      _lit=
      for _b in "$SYS_BACKLIGHT"/*; do
        [ -d "$_b" ] || continue
        _a=$(cat "$_b/actual_brightness" 2>/dev/null || echo 0)
        _m=$(cat "$_b/max_brightness" 2>/dev/null || echo 0)
        case "$_a$_m" in *[!0-9]*|'') continue ;; esac
        [ "$_m" -gt 1 ] && [ "$_a" -gt $((_m / 10)) ] && _lit=1
      done
      if [ -n "$_lit" ]; then
        _r_bad "depth says '$_rung' but a backlight is still lit"
      else _r_ok "depth '$_rung' matches dark hardware"; fi ;;
    open)
      if _r_locker_up; then
        _r_bad "depth says 'open' but a locker is UP (an edge was missed)"
      else _r_ok "depth 'open' matches an unlocked session"; fi ;;
    lock)
      # A LOCKER IS ONLY EXPECTED WHERE ONE CAN BE RAISED. A GREETER is the
      # locked state: it sits at this rung with no user session, no lock
      # provider and no locker, forever and correctly. Asserting one there made
      # report permanently RED on the one session nobody is present to watch,
      # which is worse than silence -- a check that is always failing is a check
      # nobody reads.
      #
      # The provider is what decides. If no lock.d hook is wired, nothing in
      # this session could produce a locker, so demanding one is asserting
      # something no mechanism here can satisfy. Said out loud rather than
      # skipped, because "no opinion" must not read as "checked and fine".
      if [ -z "$(_hooks_for lock)" ]; then
        _r_info "depth 'lock' with no lock provider wired, so no locker is"\
" expected (a greeter IS the locked state)"
      elif _r_locker_up; then
        _r_ok "depth 'lock' matches a live locker"
      else _r_bad "depth says 'lock' but no locker is running"; fi ;;
    *) _r_warn "unknown rung '$_rung'" ;;
  esac
  fi
}

# VERIFY, for the same reason as coherence: only when there is a claim to
# verify. `verify` asks the hooks to assert the CURRENT rung against the
# hardware, and with no record the "current rung" is a default rather than
# something we believe.
#
# Capture the OUTPUT, not just the status: an empty tier exits 0 and used
# to read here as "clean" when nothing had been asked. A green light
# meaning "nobody checked" is worse than no light.
_rep_verify() {
  if [ -z "$_have_record" ]; then
    _r_info "verify n/a: nothing was asserted, so there is nothing to check"
  else
    _vout=$(cmd_verify 2>&1) && _vrc2=0 || _vrc2=1
    case "$_vout" in
      *"n/a"*) _r_warn "$_vout" ;;
      *) if [ "$_vrc2" = 0 ]; then _r_ok "${_vout:-verify clean}"
         else _r_bad "verify reports drift: $_vout"; fi ;;
    esac
  fi

}

# ENABLED IS NOT WORKING, and conflating the two is the most expensive mistake
# this project has made. lock-on-sleep.service sat `enabled` and `canonical` for
# an entire refactor while its ExecStart named a path that did not exist: `%h`
# in a SYSTEM unit resolves to ROOT's home regardless of User=, so it
# 203/EXEC'd on every single sleep. 175 clean-looking starts, then 5 failures
# nobody saw. The suspend-lock guarantee was fiction, and both properties we
# checked (enabled, canonical) hold for a unit naming a binary that is absent.
#
# So ask the two questions those two miss, both of which are cheap and direct:
# does the named binary EXIST AND RUN, and what happened LAST time it was asked?
_rep_unit_runnable() {   # unit
  _x=$(systemctl show -p ExecStart --value "$1" 2>/dev/null \
    | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -1)
  if [ -n "$_x" ] && [ ! -x "$_x" ]; then
    # Named, because "it failed" without the path sends you reading units.
    _r_bad "$1 ExecStart is NOT executable: $_x -- it will 203/EXEC, and a"\
" failed Before=sleep.target unit does not stop the sleep"
  fi
  # The LAST RESULT is the only direct evidence that it ever worked. A unit that
  # has never run at all reports success here, so this is a floor, not a proof.
  _res=$(systemctl show -p Result --value "$1" 2>/dev/null || true)
  case "${_res:-}" in
    ''|success) ;;
    *) _r_bad "$1 last run FAILED (Result=$_res)" ;;
  esac
}

# ARE THE IDLE TIMER'S COMMANDS ACTUALLY RUNNABLE? The same question the system
# units are now asked, for the same reason: a timer armed with a command that
# cannot exec fails SILENTLY, and forever.
#
# NOT HYPOTHETICAL. A sweep removed a stale /usr/local/bin/swayidle-mgr while a
# RUNNING swayidle held that exact path in its argv. The 480s idle-lock stopped
# working from that instant and the machine stopped auto-locking. It left no
# trace: vigilant's log shows nothing (no edge was even attempted), the journal
# shows nothing (swayidle reports a failed exec only under -d), and `verify` is
# content because a box that never locked sits correctly at `open`. The 600s
# `go sleep` timer still worked, so the screen still darkened on idle and
# everything LOOKED right. Found by reading argv by hand, hours later.
#
# READ WHAT THE RUNNING PROCESS IS ARMED WITH, not what the config says it
# should be. Those are different facts and the gap between them is where this
# failure lives: a daemon pins its argv at start, so a file that moves under it
# is invisible to every config-level check ever written.
#
# The argv SOURCE is overridable for the same reason the sysfs roots and the
# locker probe are: otherwise this assertion depends on whatever swayidle the
# DEVELOPER happens to be running, and the test reaches into the live session to
# find it. Production never sets it.
_rep_idle_armed() {
  if [ -n "${VIGILANCE_IDLE_CMDLINE:-}" ]; then
    _icl=$VIGILANCE_IDLE_CMDLINE
  else
    _ipid=$(pgrep -x swayidle 2>/dev/null | head -1)
    [ -n "${_ipid:-}" ] || return 0
    _icl=/proc/$_ipid/cmdline
  fi
  [ -r "$_icl" ] || return 0
  _iseen=0 _ibad=0 _istate=0
  # swayidle's grammar: `timeout <secs> <cmd>`, and `resume`/`before-sleep`/
  # `after-resume`/`lock`/`unlock` each take a <cmd> directly. A <cmd> is ONE
  # argv element carrying its own arguments, so only its first word is a binary.
  while IFS= read -r _ia; do
    if [ "$_istate" = 1 ]; then _istate=2; continue; fi
    if [ "$_istate" = 2 ]; then
      _istate=0
      _icmd=${_ia%% *}
      [ -n "$_icmd" ] || continue
      _iseen=$((_iseen + 1))
      case "$_icmd" in
        /*) [ -x "$_icmd" ] && continue ;;
        *)  PATH="$HOOK_PATH" command -v "$_icmd" >/dev/null 2>&1 && continue ;;
      esac
      _r_bad "swayidle is armed with a command that cannot run: $_icmd -- that"\
" timer fires into nothing, silently, and no other check can see it"
      _ibad=$((_ibad + 1))
      continue
    fi
    case "$_ia" in
      timeout) _istate=1 ;;
      resume|before-sleep|after-resume|lock|unlock) _istate=2 ;;
    esac
  done <<EOF
$(tr '\0' '\n' < "$_icl")
EOF
  if [ "$_iseen" = 0 ]; then
    _r_warn "swayidle is running with NO timers armed; nothing locks on idle"
  elif [ "$_ibad" = 0 ]; then
    _r_ok "$_iseen idle timer command(s) armed and runnable"
  fi
}

_rep_machinery() {
  echo "-- machinery --"
  if systemctl --user is-active --quiet vigilance-logind.service 2>/dev/null
  then _r_ok "vigilance-logind.service active"
  elif [ -z "$_sess" ]; then _r_info "vigilance-logind n/a (no session)"
  else _r_bad "vigilance-logind.service NOT active (Session.Lock is deaf)"; fi
  for _u in lock-on-sleep.service vigilance-resume.service; do
    if systemctl is-enabled --quiet "$_u" 2>/dev/null; then
      _r_ok "$_u enabled"
    else _r_bad "$_u NOT enabled"; fi
    _rep_unit_runnable "$_u"
  done
  # WHO SUPERVISES THE SUPERVISOR. These two timers ARE the second pillar, and
  # nothing here reported on them at all.
  #
  # Not hypothetical: the enforce timer was stopped BY HAND on a real box to
  # quiet an alert storm, and then simply stayed stopped, with every subsequent
  # report green. "A supervision loop nothing runs" is the dead tier this
  # project keeps rediscovering -- `due.d` was designed, enumerated and read
  # by nothing for a whole refactor. So its absence is a FAILURE, not silence.
  for _t in vigilance-enforce.timer vigilance-audit.timer; do
    if systemctl --user is-active --quiet "$_t" 2>/dev/null; then
      _r_ok "$_t active"
    elif [ -z "$_sess" ]; then _r_info "$_t n/a (no session)"
    else _r_bad "$_t NOT active: supervision is off, so a missed edge will go"\
" unnoticed -- which is the one thing this suite exists to prevent"; fi
  done
  if pgrep -x swayidle >/dev/null 2>&1; then _r_ok "swayidle running (timer)"
  elif [ -z "$_sess" ]; then _r_info "swayidle n/a (no session to idle in)"
  else _r_bad "swayidle NOT running: nothing will lock on idle"; fi
  # RUNNING IS NOT WORKING, the same distinction as enabled-is-not-working.
  #
  # Called UNCONDITIONALLY, and the function decides for itself whether it has
  # argv to read. Nesting it under the pgrep above made it unreachable whenever
  # swayidle was not running -- which is harmless in production (there is no
  # argv, and a dead swayidle already FAILS on the line above) but made the
  # check untestable in the VM substrate, where no session exists. The stub tier
  # passed only because the DEVELOPER's box happened to have swayidle running,
  # i.e. the test was reading the host after all. The VM caught it.
  _rep_idle_armed
  # The unit that keeps swayidle ALIVE, which is a different claim from swayidle
  # running. A bare swayidle works right up until it wedges, and wedging is the
  # original failure this entire suite was built around: one wedge-prone daemon
  # must not BE the guarantee. Running-but-unsupervised is degraded, not broken,
  # so it warns rather than fails -- a dead swayidle already failed above.
  if systemctl --user is-active --quiet vigilance-idle.service 2>/dev/null
  then _r_ok "vigilance-idle.service active (the idle timer is supervised)"
  elif [ -z "$_sess" ]; then _r_info "vigilance-idle n/a (no session)"
  else _r_warn "vigilance-idle.service NOT active: swayidle is unsupervised,"\
" so a wedge will not be restarted"; fi

}

# ACTUATOR WRITABILITY. hooklib DECLARES that the login user must be in the
# `vigilant` group for brightnessctl to drive these nodes, and nothing checked
# it, so the requirement was a comment. On a real box the user was in none of
# input/video/i2c and every write was denied -- and hook_dark/hook_lit swallow
# brightnessctl failure by design (`|| true`), so vigilant logged clean
# crossings while the hardware never moved. Asserted-versus-actual drift, in
# the actuators this time rather than the record.
#
# Tests -w on the node rather than writing one: a report must change nothing,
# and a permission bit answers the question without touching the device. A
# node that does not EXIST is n/a, not drift -- a desktop has no panel
# backlight and no hook should care.
_rep_actuators() {
  echo "-- actuators --"
  _act_seen=0 _act_bad=0
  for _n in "$SYS_BACKLIGHT"/*/brightness \
            "$SYS_LEDS"/*kbd_backlight*/brightness \
            "$SYS_LEDS"/platform::mute/brightness \
            "$SYS_LEDS"/platform::micmute/brightness; do
    [ -e "$_n" ] || continue
    _act_seen=$((_act_seen + 1))
    if [ ! -w "$_n" ]; then
      _r_bad "NOT writable: $_n (hooks will silently no-op)"
      _act_bad=$((_act_bad + 1))
    fi
  done
  if [ "$_act_seen" = 0 ]; then
    _r_info "no brightnessctl-backed devices on this host (nothing to drive)"
  elif [ "$_act_bad" = 0 ]; then
    _r_ok "$_act_seen actuator node(s) writable"
  else
    # The remedy, named, because "denied" without it sends you reading source.
    _r_info "grant via udev/99-vigilance.rules + the 'vigilant' group; do NOT"\
" use 'input', which also grants raw keystroke read"
  fi
}

_rep_wiring() {
  echo "-- wiring --"
  # BLOCKED HOOKS FIRST, because they are the finding and the listing below is
  # only context. A hook wired and unable to run is invisible to every other
  # tier: no edge is attempted, so nothing reaches the log, `verify` has nothing
  # to disagree with, and `audit` sees no event. The wiring is the ONLY place
  # that truth exists.
  _blk=$(_blocked_all)
  if [ -z "$_blk" ]; then
    _r_ok "every wired hook is runnable from this session"
  else
    printf '%s\n' "$_blk" | while IFS= read -r _b; do
      if [ -z "$_b" ]; then continue; fi
      printf '  [FAIL] wired but NOT runnable here: %s\n' "$_b"
    done
    # That loop is a subshell, so it cannot raise RRC from inside.
    RRC=1
    _r_info "a hook present but not executable does not FAIL, it does not"\
" EXIST for this session; check the target is reachable by the uid crossing"\
" the edge (a MACHINE-scope hook under a home is unreadable to a greeter)"
  fi
  cmd_hooks 2>/dev/null | sed 's/^/  /'

  echo "-- recent edges --"
  tail -12 "$LOG_FILE" 2>/dev/null | sed 's/^/  /' || echo "  (no log yet)"
}

# The orchestrator: WHAT is reported and in what order, with no section logic of
# its own. The order is not cosmetic. Session and recorded state come first
# because every later section's meaning depends on them ("is this claim even
# ours to make?"), and the log tail comes last so the evidence sits next to the
# verdict rather than scrolled off above it.
cmd_report() {
  RRC=0
  echo "== vigilance: $(hostname -s 2>/dev/null) $(date '+%Y-%m-%d %H:%M:%S')"
  _rep_session
  _rep_state
  _rep_hardware
  _rep_coherence
  _rep_verify
  _rep_machinery
  _rep_actuators
  _rep_wiring
  return "$RRC"
}

# --- rescue: one key, when the screen is gone and you cannot see to type -----
# Bound to a bare unmodified key by the integrator, so it must be pressable
# BLIND. Two jobs in this order, and the order is the point: RECORD first, then
# recover. The fault is intermittent and never happens while instrumented, so
# the button IS the instrument; recovering first would burn the only evidence
# we get.
#
# It records by calling cmd_report, not by gathering its own facts. Those two
# drifting apart is exactly the failure this project is about, and the rescue
# log is worthless if it does not hold what `report` would have shown.
#
# IT ACTUATES NOTHING ITSELF. Recovery is `force open`, which crosses every
# ascent edge and runs the hooks; anything it should drive belongs in a hook,
# where it is one implementation instead of two. The direct wlopm/DDC/kbd
# fallbacks this replaced had drifted into duplicates of the hooks they shadow,
# and its swaylock signal had become a lock-killer on a stock binary.
cmd_rescue() {
  _rl=${VIGILANCE_RESCUE_LOG:-$(dirname "$LOG_FILE")/vigilance-rescue.log}
  mkdir -p "$(dirname "$_rl")" 2>/dev/null || true
  {
    echo ""
    echo "=========================================================="
    echo "=== vigilant rescue $(date '+%Y-%m-%d %H:%M:%S')"
    echo "uptime: $(uptime -p 2>/dev/null)"
    echo "boot:   $(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
    cmd_report || true
    # Rescue-only, because it is too heavy for a routine report and only
    # matters when something is actually wrong.
    echo "-- compositor --"
    timeout 5 wlopm 2>&1 | sed 's/^/  /'
    timeout 5 wlr-randr 2>&1 | sed -n '1,20p;s/^/  /'
    echo "-- journal, last 3 min --"
    timeout 5 journalctl --since "-3 min" --no-pager 2>/dev/null \
      | grep -iE "drm|i915|xe |wayfire|swaylock|backlight|dpms|connector" \
      | tail -25 | sed 's/^/  /'
  } >> "$_rl" 2>&1

  _log "RESCUE pressed; evidence in $_rl"
  _rrc=0
  cmd_go open force || _rrc=$?
  {
    echo "-- after recovery (rc=$_rrc) --"
    cmd_report || true
    echo "=== end ==="
  } >> "$_rl" 2>&1

  # A human pressing the panic key IS an intervention, whether or not the
  # recovery worked. Raise it through the alert tier rather than calling any
  # one host's notifier: that is what the tier is for, and it is how this stops
  # hardcoding an integrator's tooling.
  _alert rescue "screen rescue pressed; evidence in $_rl"
  echo "vigilant: rescue done (rc=$_rrc); evidence in $_rl" >&2
  return "$_rrc"
}

# --- due: when SHOULD this edge have fired? ---------------------------------
# THE TIMEOUT LIVES OUTSIDE VIGILANT. swaylock.conf has `blank-after`, swayidle
# has its own timers, a greeter has another; vigilant must not hold a second
# copy of any of them, because two copies of a timeout is just a slower way to
# be wrong. So a mechanism-specific hook READS the real config and reports a
# deadline, and vigilant stays mechanism-agnostic.
#
# CONTRACT: a due.d hook prints
#
#     <seconds> [anchor]
#
# and exits 0. No output, junk, or a non-zero exit means "no opinion", which is
# not the same as "zero". MAX across hooks, because the latest claimed deadline
# is the one nobody can call premature.
#
# THE ANCHOR IS LOAD-BEARING and was missing from the first cut, which cost a
# false alarm on a healthy box. `rung` (the default) means the clock starts when
# the previous rung was entered. `idle` means it starts at the last INPUT, which
# is what every swayidle timer actually does.
#
# An idle-anchored deadline is NOT ENFORCEABLE here, because vigilant has no
# idle-time source: logind reports IdleHint=no and IdleSinceHint=0 on this
# stack, and wlroots exposes no CLI for it. Measured from rung entry instead,
# `lock` read as 1616s overdue on a machine being actively typed on -- the
# enforce timer would have alerted every minute, forever, about nothing.
#
# So an idle anchor is reported and deliberately NOT acted on. The forensic tier
# is the right home for those edges: `audit` asks whether the timer that DID
# fire produced its edge, which needs no idle clock at all.
#
# BUT THAT IS A DESIGN, NOT A DELIVERY, and this comment used to claim otherwise
# ("audit covers it"). No shipped audit source reads idle events: the only one
# reads logind SLEEP events, and swayidle logs nothing a hook could reconcile
# unless it is running with -d. So an idle-anchored edge with no audit source is
# watched by NOTHING, and saying "audit covers it" was the same comforting
# untruth as an `enabled` unit that cannot execute.
#
# _audit_covered exists so the runtime can say which of the two situations it is
# actually in, rather than making the reader trust a comment.
_audit_covered() {   # -> 0 if ANY audit source is wired
  [ -n "$(_hooks_for audit)" ]
}
_due_for() {   # edge from -> "seconds [anchor]", or empty for no opinion
  _dl=$(_hooks_for "$1" .due)
  if [ -z "$_dl" ]; then return 0; fi
  _dmax= _danchor=rung
  while IFS= read -r _dh; do
    if [ -z "$_dh" ]; then continue; fi
    _drc=0
    _draw=$(VIGILANCE_EDGE="$1" VIGILANCE_FROM="$2" \
      VIGILANCE_KIND=due "$_dh" "$1" "$2" 2>/dev/null) || _drc=$?
    # "No opinion" and "could not answer" are the same VERDICT here by contract
    # (a missing deadline must not alarm), but they are not the same EVENT, and
    # the record is where that distinction has to survive. A due hook that
    # stopped being able to read its config degrades silently to "nothing to
    # enforce" -- green, because nothing is overdue when no deadline exists.
    # Logging it is what makes that traceable later without changing the
    # verdict and spamming a timer.
    if [ "$_drc" -ne 0 ]; then
      _log "due hook $(basename "$_dh") errored (rc=$_drc); treated as no"\
" opinion, so no deadline is claimed for $1"
      continue
    fi
    _dv=$(printf '%s' "$_draw" | awk '{print $1}')
    _da=$(printf '%s' "$_draw" | awk '{print $2}')
    case "$_dv" in ''|*[!0-9]*) continue ;; esac
    if [ -z "$_dmax" ] || [ "$_dv" -gt "$_dmax" ]; then _dmax=$_dv; fi
    # ANY idle-anchored hook makes the whole deadline unenforceable: we cannot
    # tell an idle machine from a busy one, so acting would be a guess.
    case "$_da" in idle) _danchor=idle ;; esac
  done <<EOF
$_dl
EOF
  [ -n "$_dmax" ] || return 0
  printf '%s %s' "$_dmax" "$_danchor"
}

# The next DESCENT edge from a rung, or empty at the bottom.
#
# `suspend` is deliberately excluded as an enforcement target. Forcing that edge
# would fire suspend.d without the machine actually suspending, leaving the
# peripherals configured for S3 on a box that is awake. And vigilant starting
# a real power transition would mean competing with the trust root instead of
# riding it, which is the one thing this design refuses to do.
_next_down() {   # rung -> edge, or empty
  case "$1" in
    open)  echo lock ;;
    lock)  echo sleep ;;
    *)     echo "" ;;
  esac
}

cmd_due() {   # [edge]
  _from=$(_depth)
  _e=${1:-$(_next_down "$_from")}
  if [ -z "$_e" ]; then
    echo "due: nothing below '$_from' is an enforcement target"
    return 0
  fi
  _draw=$(_due_for "$_e" "$_from")
  if [ -z "$_draw" ]; then
    echo "due $_e: n/a (no due hook has an opinion)"
    return 0
  fi
  _d=$(printf '%s' "$_draw" | awk '{print $1}')
  _anch=$(printf '%s' "$_draw" | awk '{print $2}')
  if [ "$_anch" = idle ]; then
    # NAME WHAT IS ACTUALLY WATCHING IT. "see audit for these edges" read as
    # reassurance while no audit source for them existed.
    if _audit_covered; then
      echo "due $_e: ${_d}s after last INPUT, which vigilant cannot observe;"\
" reported but NOT enforceable (the audit tier reconciles it after the fact)"
    else
      echo "due $_e: ${_d}s after last INPUT, which vigilant cannot observe;"\
" NOT enforceable AND no audit source is wired, so nothing is watching this"\
" edge at all"
    fi
    return 0
  fi
  _at=$(_depth_at)
  if [ "$_at" -gt 0 ]; then
    _el=$(( $(date +%s) - _at ))
    echo "due $_e: ${_d}s after '$_from' (entered ${_el}s ago, grace ${GRACE}s)"
  else
    echo "due $_e: ${_d}s after '$_from' (no depth record; not overdue)"
  fi
}

# --- enforce: the supervision loop, meant for a timer -----------------------
# This is the second pillar. Pillar one is "make the things go dark"; this is
# "notice when the mechanism that does it has silently stopped working". A
# primary mechanism that quietly dies currently costs weeks of dead peripherals
# and nobody finds out; the goal is to turn that into a RECORDED event.
#
# GRACE exists so the primary mechanism wins the race in the normal case.
# vigilant acts only when an edge is demonstrably overdue, never on the tie.
#
# POLICY, and this is a deliberate narrowing of the plan. `report` (the default)
# logs and alerts; `force` also crosses the edge. The plan's end state is
# force, and its own safety constraint is "never force a descent without a
# reliable ascent" -- vigilant cannot see input while locked, so a forced blank
# could land mid-password. The rescue key is that floor and now exists, but it
# has been pressed in anger exactly never, so forcing stays opt-in until an
# ascent has been proven on the box in question. An alert that names the failure
# already buys the charter's goal; forcing buys convenience on top of it.
cmd_enforce() {
  mkdir -p "$RUN_DIR" "$STATE_ROOT"
  _from=$(_depth)
  _at=$(_depth_at)
  if [ "$_at" -le 0 ]; then
    echo "enforce: no depth record; nothing is overdue"
    return 0
  fi
  _e=$(_next_down "$_from")
  if [ -z "$_e" ]; then
    echo "enforce: nothing below '$_from' is an enforcement target"
    return 0
  fi
  _draw=$(_due_for "$_e" "$_from")
  if [ -z "$_draw" ]; then
    echo "enforce: $_e has no declared deadline; nothing to enforce"
    return 0
  fi
  _d=$(printf '%s' "$_draw" | awk '{print $1}')
  _anch=$(printf '%s' "$_draw" | awk '{print $2}')
  # An IDLE-anchored deadline cannot be enforced: the clock starts at the last
  # input and vigilant has no way to read that, so "overdue" would just mean
  # "this rung has been held a while" -- which on an actively used machine is
  # normal. Measured from rung entry it called `lock` 1616s overdue while the
  # machine was being typed on, and the timer would have alerted every minute.
  if [ "$_anch" = idle ]; then
    if _audit_covered; then
      echo "enforce: $_e is idle-anchored; not enforceable here, left to audit"
      return 0
    fi
    # UNWATCHED, and that is worth saying once rather than silently returning 0
    # every minute. Not an alert: it is a wiring gap, not an event, and alerting
    # on it every minute is how a human learns to ignore the channel.
    echo "enforce: $_e is idle-anchored and NOT enforceable, and no audit"\
" source is wired for it; this edge is unsupervised"
    return 0
  fi
  _el=$(( $(date +%s) - _at ))
  if [ "$_el" -le $((_d + GRACE)) ]; then
    echo "enforce: $_e not due yet (${_el}s of $((_d + GRACE))s)"
    return 0
  fi

  # OVERDUE. Ask whether something is legitimately preventing it before
  # concluding the mechanism failed: an idle inhibitor or a fullscreen video is
  # the mechanism behaving correctly, and fighting that would be the bug.
  if _blocked "$_e" "$_from"; then
    _log "OVERDUE $_e by $((_el - _d))s, but blocked; holding off"
    echo "enforce: $_e overdue but blocked; holding off"
    return 0
  fi

  _alert overdue "$_e is ${_el}s into a ${_d}s deadline and has not fired;"\
" the primary mechanism for it is not working"
  _enforce_act "$_e" "$_el" "$_d"
}

# THE ACTING HALF, reached only when an edge is demonstrably overdue, nothing is
# blocking it, and the human has already been alerted. Split from the guard
# chain above because the two halves answer different questions: everything
# before this decides "is anything wrong?", and every one of its exits is a
# HEALTHY state.
# This decides "what, if anything, do we do about it?" -- and is the only part
# that can change the machine.
_enforce_act() {   # edge elapsed deadline
  _e=$1; _el=$2; _d=$3
  case "${VIGILANCE_ENFORCE:-report}" in
    force)
      # NEVER FORCE A DESCENT INTO A DARK RUNG, even under the force policy.
      #
      # The invariant this protects: nothing may put the machine into a dark
      # rung unless it arms its own way back. Every dark descent that runs
      # today comes from a swayidle pairing its `timeout` with a `resume`, so
      # activity brings the screen back. A forced descent has no such pairing --
      # swayidle would not know the machine was dark, so input would produce
      # nothing and recovery would need a keybind.
      #
      # That is not hypothetical. It is exactly how `vigilance-resume` used to
      # blank an active user's screen for 32 seconds, and the disguise the
      # blackout kept reappearing in.
      #
      # `lock` is still forceable, and it is the case worth having: "the screen
      # should have locked and did not" is the security-relevant failure.
      # Forcing the peripherals dark only buys power, and not at this price.
      #
      # Asked of _intent_of rather than a list of rung names, so a new rung
      # inherits the rule instead of quietly escaping it.
      if [ "$(_intent_of "$_e")" = dark ]; then
        _log "OVERDUE $_e by $((_el - _d))s; NOT forced: a forced descent"\
" into a dark rung would have no armed ascent"
        echo "enforce: $_e overdue, but forcing it would go dark with nothing"\
" armed to bring it back; reported only"
        return 1
      fi
      _log "ENFORCING $_e: overdue by $((_el - _d))s, forcing it"
      echo "enforce: forcing $_e (overdue by $((_el - _d))s)"
      cmd_go "$_e" only
      return $? ;;
    *)
      _log "OVERDUE $_e by $((_el - _d))s; reported, not forced"\
" (VIGILANCE_ENFORCE=force to act)"
      echo "enforce: $_e OVERDUE by $((_el - _d))s; reported, not forced"
      return 1 ;;
  esac
}

# --- audit: did every external event actually produce its edge? --------------
# THE THIRD QUESTION, and the one that found the bug this tier was built for.
#
#   verify   does the hardware match what we believe, NOW?
#   due      is an edge pending and overdue?
#   audit    did an event that ALREADY HAPPENED produce the edge it should have?
#
# Neither of the first two can see the failure that prompted this: logind slept
# the machine, lock-on-sleep.service was asked to lock it first, the unit
# 203/EXEC'd on a bad ExecStart, and systemd reached sleep.target and slept
# anyway. Nothing was in a wrong state afterwards, and nothing was pending --
# an EVENT simply produced no EDGE, and only history shows that.
#
# It went unnoticed for a whole refactor because the unit was `enabled` and
# `canonical`, both of which we checked, and neither of which says the binary it
# names exists. Forensics is the only tier that would have caught it.
#
# CONTRACT: an audit.d hook reads ONE event source and prints zero or more
#
#     <epoch> <edge> [note]
#
# meaning "at <epoch> something happened that should have produced <edge>".
# vigilant owns the reconciliation, so a hook never has to parse the edge log --
# the same split as `due`, where the hook reports a deadline and vigilant does
# the arithmetic. Mechanism knowledge (journalctl, logind, a timer) stays in the
# plugin; vigilance's own record stays vigilance's to read.
AUDIT_WINDOW=${VIGILANCE_AUDIT_WINDOW:-120}

# Did the log record <edge> within the window around <epoch>?
#
# ISO-8601 sorts lexicographically, so the window becomes a string comparison
# and this needs neither `date` per log line nor awk's mktime (absent from
# mawk).
#
# THREE WAYS TO SATISFY ONE ASSERTION, because the assertion is really about the
# RUNG: a descent edge shares its name with the rung it enters, and there is
# more than one correct route to being there.
#
#   cross lock:            it crossed that edge
#   already at 'lock'      it was there; the edge's purpose was already achieved
#   cross wake: sleep -> lock
#                          it ARRIVED at the rung by another edge
#
# The third was missing and the live journal found it. On resume, `go lock` is a
# no-op only when the depth file survived at `lock`; when the box had descended
# to `sleep` first -- the ORDINARY idle path -- it crosses `wake` to get back
# up. Both outcomes mean the session is locked, and only one of them was
# being counted, so every resume from the normal idle path was reported as a
# MISS. Same cries-wolf failure as the `due` anchor, one tier over.
_log_has_edge() {   # epoch edge
  [ -r "$LOG_FILE" ] || return 1
  _lo=$(date -d "@$(( $1 - AUDIT_WINDOW ))" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null) \
    || return 1
  _hi=$(date -d "@$(( $1 + AUDIT_WINDOW ))" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null) \
    || return 1
  awk -v lo="$_lo" -v hi="$_hi" -v e="$2" '
    $1 >= lo && $1 <= hi {
      if ($0 ~ ("cross " e ":")) { found = 1 }
      if ($0 ~ ("already at ." e ".")) { found = 1 }
      # ARRIVED at the rung by another edge. The trailing guard stops `lock`
      # matching a longer rung name, and tolerates the " (forced)" suffix.
      if ($0 ~ ("-> " e "( |$)")) { found = 1 }
    }
    END { exit(found ? 0 : 1) }' "$LOG_FILE"
}

cmd_audit() {
  _al=$(_hooks_for audit)
  if [ -z "$_al" ]; then
    echo "audit: n/a (no audit hooks installed; no event source is reconciled)"
    return 0
  fi
  _checked=0 _missed=0 _broken=0
  while IFS= read -r _ah; do
    if [ -z "$_ah" ]; then continue; fi
    _sd=$STATE_ROOT/$(basename "$_ah")
    mkdir -p "$_sd" 2>/dev/null || true
    _arc=0
    _out=$(VIGILANCE_KIND=audit VIGILANCE_STATE_DIR="$_sd" \
      PATH="$HOOK_PATH" "$_ah" 2>/dev/null) || _arc=$?
    # A BROKEN SOURCE IS NOT "NO EVENTS". This was a bare `|| continue`, so a
    # hook that could not read its source (no journal access, a renamed unit, a
    # parse error) left audit printing "nothing to reconcile" and exiting 0: a
    # green forensic tier that had checked nothing. Precisely the false green
    # the EMPTY VERIFY TIER was fixed for, reproduced one tier over -- and worse
    # here, because audit is the tier of last resort. If it is blind, nothing
    # else is looking.
    if [ "$_arc" -ne 0 ]; then
      _broken=$((_broken + 1))
      _log "AUDIT: source $(basename "$_ah") failed (rc=$_arc); not reconciled"
      echo "audit BROKEN: $(basename "$_ah") could not read its event source"\
" (rc=$_arc); nothing from it was reconciled"
      continue
    fi
    while IFS= read -r _ev; do
      if [ -z "$_ev" ]; then continue; fi
      _when=$(printf '%s' "$_ev" | awk '{print $1}')
      _edge=$(printf '%s' "$_ev" | awk '{print $2}')
      _note=$(printf '%s' "$_ev" | cut -d' ' -f3-)
      case "$_when" in ''|*[!0-9]*) continue ;; esac
      [ -n "$_edge" ] || continue
      _checked=$((_checked + 1))
      if _log_has_edge "$_when" "$_edge"; then
        echo "audit ok: $_edge at $(date -d "@$_when" '+%F %T') ${_note:-}"
      else
        _missed=$((_missed + 1))
        echo "audit MISS: $_edge expected at"\
" $(date -d "@$_when" '+%F %T') but no edge was crossed ${_note:-}"
      fi
    done <<EOF2
$_out
EOF2
  done <<EOF
$_al
EOF
  _audit_verdict
}

# The verdict, split out so cmd_audit stays readable. Three outcomes, and they
# are deliberately NOT collapsed: "no events" is healthy, "a source is blind" is
# a fault in the auditor itself, and "an event produced no edge" is a fault in
# the thing being audited. Reporting the second as the first is what made this
# tier lie; reporting it as the third would send a human hunting the wrong bug.
_audit_verdict() {
  if [ "$_broken" -gt 0 ]; then
    # The AUDITOR is broken, which is worth more alarm than a miss: a miss is
    # one known failure, a blind source is an unknown number of them.
    _alert audit-broken "$_broken audit source(s) could not be read; the"\
" forensic tier is partly blind and cannot be trusted green"
    _log "AUDIT: $_broken source(s) unreadable"
  fi
  if [ "$_missed" -gt 0 ]; then
    # An event that produced no edge means a TRIGGER or HANDLER did not fire.
    # That is exactly what the human needs told, and it is historical, so the
    # alert is the only thing that will reach them.
    _alert audit-miss "$_missed of $_checked external event(s) produced no"\
" edge; a trigger or handler is not firing"
    _log "AUDIT: $_missed of $_checked events produced no edge"
  fi
  if [ "$_missed" -gt 0 ] || [ "$_broken" -gt 0 ]; then return 1; fi
  if [ "$_checked" = 0 ]; then
    echo "audit: no events found in range (nothing to reconcile)"
    return 0
  fi
  echo "audit: $_checked event(s) all produced their edge"
  return 0
}

_U="usage: vigilant go <open|lock|sleep|suspend>
                 | force <state> | only <state> | status
                 | verify [edge] | hooks [edge] | report | rescue
                 | due [edge] | enforce | audit
       (the wiring audit is 'setup.sh check', not a verb here)"
_sub=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
case "$_sub" in
  go)
    if [ "$#" -lt 1 ]; then
      echo "vigilant: 'go' needs a state" >&2; echo "$_U" >&2; exit 2
    fi
    cmd_go "$1" ;;
  force)
    if [ "$#" -lt 1 ]; then
      echo "vigilant: 'force' needs a state" >&2; echo "$_U" >&2; exit 2
    fi
    cmd_go "$1" force ;;
  only)
    if [ "$#" -lt 1 ]; then
      echo "vigilant: 'only' needs a state" >&2; echo "$_U" >&2; exit 2
    fi
    cmd_go "$1" only ;;
  status)  cmd_status ;;
  verify)  cmd_verify "${1:-}" ;;
  hooks)   cmd_hooks "${1:-}" ;;
  report)  cmd_report ;;
  rescue)  cmd_rescue ;;
  due)     cmd_due "${1:-}" ;;
  enforce) cmd_enforce ;;
  audit)   cmd_audit ;;
  # NAMED EXPLICITLY rather than falling through to "unknown command", because
  # three documents promised this verb and somebody will type it.
  check)
    echo "vigilant: there is no 'check' here; the wiring audit is" >&2
    echo "  'setup.sh check' (it owns the prefix, deps and plugin tree)." >&2
    echo "  For state-vs-hardware, you want 'vigilant report'." >&2
    exit 2 ;;
  -h|--help|help) echo "$_U" ;;
  *) echo "vigilant: unknown command '${_sub:-}'" >&2; echo "$_U" >&2; exit 2 ;;
esac
