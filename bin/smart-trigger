#!/bin/sh
# smart-trigger -- robustly TRIGGER a screen lock from a systemd context. The
# actual locking is done by smart-lock (the executor: shape config, multi-output
# spanning, lock/unlock hooks); smart-trigger only makes it survive the systemd
# cgroup reap and gates the suspend. Two modes:
#
#   smart-trigger [lock]  one-shot: bring the lock up (smart-lock in a transient
#     USER unit that survives a oneshot/suspend), BLOCK until the surface is up,
#     return. Run by lock-on-sleep.service (Before=sleep.target, so the box
#     cannot sleep unlocked).
#   smart-trigger listen  long-running: run the lock on each logind Session.Lock
#     signal (AC lid-close via HandleLidSwitchExternalPower=lock, and `loginctl
#     lock-session`). Run by smart-trigger.service (--user, Restart=always).
#
# WHY a transient USER unit: a lock launched as a child of the sleep oneshot
# stays in its cgroup, and systemd SIGKILLs that cgroup when the oneshot
# completes -> the lock is reaped on return, leaving an abandoned ext-session-
# lock (a frozen screen; hit 2026-08-08). A sibling --user unit lives in the
# user manager's cgroup and survives. smart-lock stays foreground (its wait-for-
# unlock loop), so it keeps the unit alive and is never reaped.
#
# WHY swayidle-independent: swayidle used to own both the before-sleep hook and
# the Session.Lock response, and it WEDGES on this Wayfire build -- it silently
# dropped a Session.Lock that provably fired (screen stayed unlocked, 08-08) and
# held the sleep inhibitor without locking (unlocked suspends, 08-06/07).
set -eu

MODE=${1:-lock}

uid=$(id -u)
: "${XDG_RUNTIME_DIR:=/run/user/$uid}"
export XDG_RUNTIME_DIR
# Reach the user manager (systemd-run --user) from a system service's minimal
# env; XDG_RUNTIME_DIR + the session bus are the only two required (verified).
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
# ~/bin first so smart-lock resolves its helpers (kanshi-autoscale, wallpaper-
# slicer); a system service inherits none of the session PATH.
PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

SLU=screen-lock.service        # the transient USER unit that OWNS the lock
SMART=$(command -v smart-lock 2>/dev/null || echo "$HOME/.local/bin/smart-lock")
MARKER="$XDG_RUNTIME_DIR/screen-locked"   # smart-lock's committed-lock flag
WD=""

# _run <cmd...>: (re)launch <cmd> as the user-manager unit SLU, a sibling cgroup
# that survives this caller's teardown. Clears any stale instance first.
_run() {
  systemctl --user stop "$SLU" 2>/dev/null || true
  systemctl --user reset-failed "$SLU" 2>/dev/null || true
  systemd-run --user --collect --unit="$SLU" \
    --setenv=WAYLAND_DISPLAY="$WD" --setenv=PATH="$PATH" \
    -- "$@" >/dev/null 2>&1 || true
}

# _wait_marker <deciseconds>: 0 once smart-lock signals a COMMITTED lock (the
# compositor confirmed it), 1 on timeout. This is the suspend gate -- waiting on
# the marker, not on the swaylock process merely existing, is what stops the box
# from suspending mid-commit (the ~1s unlocked frame on resume).
_wait_marker() {
  _n=0
  while [ "$_n" -lt "$1" ]; do
    if [ -e "$MARKER" ]; then return 0; fi
    _n=$((_n + 1))
    sleep 0.1
  done
  return 1
}

# _wait_swaylock <deciseconds>: 0 as soon as the swaylock process is up, 1 on
# timeout. Used only for the bare-swaylock FLOOR, which writes no marker.
_wait_swaylock() {
  _n=0
  while [ "$_n" -lt "$1" ]; do
    if pgrep -x swaylock >/dev/null 2>&1; then return 0; fi
    _n=$((_n + 1))
    sleep 0.1
  done
  return 1
}

# log to stderr -> the journal (smart-trigger.service for listen, lock-on-sleep
# .service for suspend), so a lid/suspend test is diagnosable from logs WITHOUT
# live re-triggering (journalctl --user -u smart-trigger.service).
log() { echo "smart-trigger[$MODE]: $*" >&2; }

# do_lock: bring the lock up idempotently via smart-lock (the executor; it falls
# back to a plain swaylock internally, so no external floor is needed). ONE
# launch -- deliberately NO stop-and-relaunch: that churn could SIGKILL a
# mid-acquire lock and wedge wayfire's fragile ext-session-lock. In `lock`
# (suspend) mode it GATES on the committed marker so the box cannot sleep
# unlocked; in `listen` (AC-lid/manual) mode nothing races an awake machine, so
# it fires and only confirms for the log.
do_lock() {
  WD=${WAYLAND_DISPLAY:-}
  if [ -z "$WD" ]; then
    for _s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
      [ -S "$_s" ] || continue
      WD=${_s##*/}
      break
    done
  fi
  [ -n "$WD" ] || { log "no session; nothing to lock"; return 0; }
  if pgrep -x swaylock >/dev/null 2>&1; then log "already locked"; return 0; fi

  rm -f "$MARKER"          # clear stale readiness -> gate on THIS lock's commit
  if [ -x "$SMART" ]; then
    log "launching smart-lock (WD=$WD)"
    _run "$SMART"
  else
    log "smart-lock absent; launching bare swaylock (WD=$WD)"
    _run swaylock
  fi

  if [ "$MODE" = lock ]; then
    # SUSPEND: block until the lock is COMMITTED, so the box cannot sleep
    # unlocked. 8s cap so a wedged compositor cannot hang the suspend forever.
    if _wait_marker 80; then log "committed; suspend may proceed"; return 0; fi
    if pgrep -x swaylock >/dev/null 2>&1; then
      log "WARN: swaylock up but no commit in 8s (slow/wedged compositor?)"
      return 0
    fi
    log "ERROR: no lock in 8s; suspend will proceed UNLOCKED"
    return 1
  fi
  # LISTEN: machine stays awake, nothing races -- fire and forget. Confirm
  # briefly for the log only; NEVER churn (relaunch) a slow lock.
  if _wait_swaylock 30; then log "locked"
  else log "WARN: swaylock not up after 3s (slow/wedged compositor?)"; fi
  return 0
}

case "$MODE" in
  lock)
    do_lock
    ;;
  listen)
    # gdbus (not dbus-monitor) SUBSCRIBES to login1's broadcast signals
    # unprivileged; system-bus monitoring is root-only. `Session.Lock ()`
    # excludes `Session.Unlock ()` (different string), so an unlock never locks.
    gdbus monitor --system --dest org.freedesktop.login1 2>/dev/null \
      | while read -r _line; do
          case "$_line" in
            *"Session.Lock ()"*) do_lock || true ;;
          esac
        done
    ;;
  *)
    echo "usage: smart-trigger [lock|listen]" >&2
    exit 2
    ;;
esac
