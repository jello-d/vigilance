#!/bin/bash
# smart-lock -- THE screen-lock executor: brings up swaylock with the shape's
# config, multi-output spanning, and lock/unlock hooks. Reached four ways, all
# converging here (see modules/lock):
#   - idle:         swayidle timer         (in-session, direct)
#   - manual:       Super+L keybind        (in-session, direct)
#   - suspend:      lock-on-sleep.service  -> smart-trigger -> here
#   - Session.Lock: smart-trigger.service  -> smart-trigger -> here
#
# Idempotent: if swaylock is already up it exits at once. Plus a scoped PHANTOM
# GUARD: swayidle re-fires idle-lock right after an unlock (the compositor's
# idle timer is not reset by the unlock input -- a wlroots idle-notify bug),
# which storms as repeated re-locks. A legit idle-lock cannot occur <
# LOCK_TIMEOUT (480s) after an unlock, so an idle-lock within a short cooldown
# of the last unlock IS that phantom: suppressed here, but LOGGED LOUDLY
# (journal warning) so it stays observable while symptomless. NEVER applied to
# suspend / manual / Session.Lock (gating suspend would sleep the box
# UNLOCKED); the idle path tags itself with LOCK_SOURCE=idle. (This restores
# the old COOLDOWN debounce that was removed on the mistaken belief flock+pgrep
# covered it -- they only stop CONCURRENT invocations, not swayidle's
# sequential re-fire after unlock.)
#
# Spanned lock screen: swaylock draws the same image on every output and has no
# spanned mode, so on a multi-output host we pre-slice one wallpaper into one
# crop per output (via `wallpaper-slicer`, cached) and hand swaylock per-output
# image with `-i OUTPUT:PATH`. On a single-output host (the laptop), on any
# slicing failure, or when wallpaper-slicer is absent, we fall through to a
# plain `swaylock -f -C <shape config>`. So this wrapper stays host-agnostic:
# a wall gets the spanned lock and a single panel the normal one, and the lock
# image itself follows the shape (see SWAYLOCK_CFG) -- no host branching here.
#
# `now` is accepted as a deprecated no-op (locking is always immediate now).

# flock + hook dir live in the user-private, session-scoped runtime dir, not
# world-writable /tmp.
_rt=${XDG_RUNTIME_DIR:-/tmp}
LOCK=$_rt/smart-lock.flock
HOOK_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lock-hooks"
# Readiness marker: present ONLY while the lock is genuinely COMMITTED (swaylock
# -f returns after the compositor confirms the lock). smart-trigger's suspend
# gate waits for this, not for the swaylock process to merely exist, so the box
# cannot suspend mid-commit (which left the last unlocked frame visible for ~1s
# on resume). smart-trigger clears any stale copy before each attempt.
MARKER=$_rt/screen-locked
# Timestamp of the last real unlock, for the idle-path phantom guard below.
UNLOCK_STAMP=$_rt/smart-lock.last-unlock

# The lock image is SHAPE-driven (aspect ratio / resolution differ between a
# single panel and a portrait wall), so the swaylock config is selected by
# kanshi-autoscale's panel count, not by hostname -- from the one shapes/ tree
# that also holds the wayfire runtime and wallpaper for each shape. Default to
# single if detection fails, and fall back to it if the shape has no config.
_shapes="${XDG_CONFIG_HOME:-$HOME/.config}/shapes"
_shape=$(kanshi-autoscale shape 2>/dev/null || true)
[ -n "$_shape" ] || _shape=single
SWAYLOCK_CFG="$_shapes/$_shape/swaylock.conf"
[ -r "$SWAYLOCK_CFG" ] || SWAYLOCK_CFG="$_shapes/single/swaylock.conf"

case "${1:-}" in
  ''|now) ;;   # 'now' kept as a no-op alias for the old forced-lock form
  *)   echo "usage: ${0##*/} [now]" >&2; exit 2 ;;
esac

trace() {
  [ "${LOCK_TRACE:-1}" = 1 ] || return 0
  _tl=${LOCK_TRACE_LOG:-$_rt/lock-trace.log}
  {
    printf '%s %-7s pid=%s\n' "$(date +%H:%M:%S.%N)" "$1" "$$"
    _p=$$
    _n=0
    while [ "${_p:-0}" -gt 1 ] && [ "$_n" -lt 6 ]; do
      _c=$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null)
      printf '    %s %s\n' "$_p" "$_c"
      _p=$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')
      _n=$((_n + 1))
    done
  } >> "$_tl" 2>&1
}

# Resolve the lock wallpaper: explicit env override (SMART_LOCK_IMAGE), else the
# `image=` line from the swaylock config (dropping any OUTPUT: prefix).
resolve_image() {
  local img="${SMART_LOCK_IMAGE:-}"
  if [ -z "$img" ] && [ -r "$SWAYLOCK_CFG" ]; then
    img=$(sed -n 's/^[[:space:]]*image=//p' "$SWAYLOCK_CFG" | tail -1)
    img="${img##*:}"
  fi
  case "$img" in "~"/*) img="$HOME/${img#"~"/}";; esac
  printf '%s' "$img"
}

# Sets the global LOCKER array. Default is a plain lock; upgrade it to a spanned
# lock only if wallpaper-slicer hands us crops for two or more outputs.
build_locker() {
  # Density ring: swaylock's indicator is fixed-px (default radius ~50), too big
  # on a low-res panel. The one resolver (kanshi-autoscale uiprofile) sizes it;
  # EMPTY on hi-res so swaylock's own default stands (a strict no-op). Thickness
  # tracks the radius (swaylock's default 50/10 ratio). Kept in `ind` so it
  # lands in BOTH the plain and the spanned locker below.
  local ind=() _lr
  _lr=$(kanshi-autoscale uiprofile 2>/dev/null | sed -n s/^LOCK_RADIUS=//p)
  [ -n "$_lr" ] && ind=(--indicator-radius "$_lr" \
    --indicator-thickness "$(( _lr / 5 ))")

  LOCKER=(swaylock -f -C "$SWAYLOCK_CFG" "${ind[@]}")

  command -v wallpaper-slicer >/dev/null 2>&1 || return 0

  local img; img=$(resolve_image)
  [ -n "$img" ] && [ -r "$img" ] || return 0

  # Capture the NAME<TAB>PATH mapping. A non-zero exit (single output, no image
  # tool, unreadable geometry, ...) leaves the plain locker in place.
  local map; map=$(wallpaper-slicer "$img") || return 0
  [ -n "$map" ] || return 0

  local img_args=() name path count=0
  while IFS=$'\t' read -r name path; do
    [ -n "$name" ] && [ -n "$path" ] || continue
    img_args+=( -i "$name:$path" )
    count=$((count + 1))
  done <<< "$map"

  if [ "$count" -ge 2 ]; then
    LOCKER=(swaylock -f -C "$SWAYLOCK_CFG" "${ind[@]}" "${img_args[@]}")
  fi
}

run_hooks() {
  local event="$1"   # $1 = "lock" or "unlock"
  local dir="$HOOK_DIR/${event}.d"
  [[ -d "$dir" ]] || return 0
  for hook in "$dir"/*; do
    [[ -x "$hook" ]] || continue
    "$hook" "$event"
  done
}

(
  trace attempt
  flock -n 9 || exit 0
  trace run

  # Idempotent: swaylock is a singleton, so if it is already up there is nothing
  # to do. This replaces the old COOLDOWN debounce (a swayidle-phantom guard);
  # the flock above already serializes concurrent invocations.
  if pgrep -x swaylock >/dev/null 2>&1; then
    trace already-locked
    exit 0
  fi

  # PHANTOM GUARD (idle path only): a legit idle-lock cannot fire <
  # LOCK_TIMEOUT (480s) after an unlock, so an idle-lock within COOLDOWN of the
  # last unlock is swayidle's post-unlock re-fire. Suppress it, but LOG LOUDLY
  # so the phantom is still countable in the journal even though the user no
  # longer sees it. Scoped to LOCK_SOURCE=idle so suspend / manual /
  # Session.Lock are never gated.
  if [ "${LOCK_SOURCE:-}" = idle ] && [ -f "$UNLOCK_STAMP" ]; then
    _now=$(date +%s)
    _last=$(cat "$UNLOCK_STAMP" 2>/dev/null || echo 0)
    case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    _cd=${SMART_LOCK_COOLDOWN:-10}
    if [ "$((_now - _last))" -lt "$_cd" ]; then
      trace phantom-suppressed
      logger -t smart-lock -p user.warning \
        "PHANTOM RELOCK SUPPRESSED: idle-lock $((_now - _last))s after unlock" \
        "(swayidle re-fire; compositor idle-notify not reset on unlock)." \
        "cooldown=${_cd}s"
      exit 0
    fi
  fi

  # Slice (if applicable) only now that we've decided to actually lock.
  build_locker

  run_hooks lock
  "${LOCKER[@]}"

  # swaylock -f returns only AFTER the compositor confirms the lock, so the lock
  # is now COMMITTED -- drop the readiness marker for smart-trigger's gate.
  : > "$MARKER"

  # swaylock -f detaches once the lock surface is up, so the call above returns
  # while the screen is still locked. Block until swaylock actually exits, so
  # unlock hooks (unmute, etc.) fire on the real unlock instead of at lock time.
  # A spanned lock is still a SINGLE swaylock process (one process draws every
  # output via repeated -i), so one pgrep guards the whole lock.
  while pgrep -x swaylock >/dev/null 2>&1; do
    sleep 0.25
  done

  date +%s > "$UNLOCK_STAMP" 2>/dev/null || true  # for the idle phantom guard
  rm -f "$MARKER"      # unlocked: clear readiness

  run_hooks unlock

) 9>"$LOCK"
